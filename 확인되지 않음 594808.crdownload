8:MC,260110:MC,260114:DN,260115:SC,260117:FC,260119:MC,260122:MC,260126:DN,260127:SC,260128:RV,260201:MCS,260202:FC,260204:MC,260205:RV,260206:RV,260210:MC,260213:DN,260214:SC,260217:FCH,260219:MC,260223:MC,260225:DN,260226:SC,260228:DN,260304:FC,260309:MC,260312:RV,260313:MC,260314:DN,260315:MCS,260318:MC,260319:FC,260320:MC,260321:ND,260323:MC,260326:DN,260327:N,260328:SC,260402:RV,260403:FC,260407:DN,260408:SC,260410:VP,260411:AV,260413:ND,260414:SC,260416:ND,260417:SC,260418:FC,260420:FC,260421:MC,260429:ND,260430:SC,260502:FC,260504:FC,260505:DN,260506:N,260507:SC,260508:MC,260511:MC,260515:LS,260519:FC,260520:DN,260521:SC,260523:DN,260527:ND,260528:SC,260529:LS,260530:MC,260603:FCH,260604:MC,260609:MC,260611:AV,260612:MC,260616:LS,260617:LS,260618:FC,260620:MC,260625:ND,260626:SC,260627:MC,260630:DN,260701:SC,260703:FC,260705:MCS,260706:MC,260707:ND,260708:SC,260709:ND,260710:SC,260713:MC,260715:AV,260718:FC,260722:ND,260723:SC,260725:MC,260726:N,260727:SC,260728:MC,260731:MC,260801:FC,260805:ND,260806:SC,260810:MC,260811:MC,260815:DN,260817:FCH,260819:MC,260821:ND,260822:SC,260823:D,260826:MC,260829:MC,260901:FC,260902:AV,260904:AV,260905:MC,260907:MC,260908:AV,260912:MC,260914:AV,260915:AV,260916:FC,260918:ND,260919:SC,260920:DN,260921:N,260922:SC,260923:DN,260924:SC,260926:DN,260930:AV,261001:FC,261016:FC,261031:FC,261102:FC,261114:FC,261116:FC,261201:FC,261216:FC,261231:FC"};
const ORIGINAL_LAST = '2026-12-31';
let _excelCodeMap = null, _excelNames = null;
function excelAnyCode(ds, name){
  if(!_excelCodeMap){
    _excelCodeMap = new Map(); _excelNames = new Set(Object.keys(EXCEL_CODES));
    Object.entries(EXCEL_CODES).forEach(([n, list])=> list.split(',').forEach(x=>{
      const [d, c] = x.split(':');
      _excelCodeMap.set('20'+d.slice(0,2)+'-'+d.slice(2,4)+'-'+d.slice(4,6)+'|'+n, c);
    }));
  }
  return _excelCodeMap.get(ds+'|'+name) || '';
}
function isOriginalPerson(name){ excelAnyCode('', ''); return _excelNames.has(name); }
// 그 날의 근태코드: 편집자가 직접 입력 → (원본 기간·원본 인원이면) 원본 엑셀 → 저장된 값
function effCode(rec, ds, name){
  if(rec && rec.attManual) return rec.statusCode || rec.attCode || '';
  if(ds && ds <= ORIGINAL_LAST && name && isOriginalPerson(name)) return excelAnyCode(ds, name);
  return rec ? (rec.statusCode || rec.attCode || '') : '';
}
