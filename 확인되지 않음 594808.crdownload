","N"],["260615","8:00","18:30","","","","",0,"D","D"],["260616","8:00","18:30","","","","",4,"D","D"],["260617","8:00","18:30","","","","",0,"D","D"],["260618","8:00","16:00","","","","",0,"D","D"],["260622","","","8:00","9:00","","",0,"","N","D"],["260624","19:00","7:30","","","","",0,"N","N"],["260625","19:00","7:30","","","","",0,"N","N"],["260627","19:00","7:00","","","","",0,"N","N"],["260630","8:00","16:00","","","","",4,"D","D"],["260701","8:00","12:30","","","","",0,"D","D"],["260702","8:00","16:30","","","","",0,"D","D"],["260703","8:00","10:00","","","","",0,"D","D"],["260704","8:00","18:30","","","","",0,"D","D"],["260705","8:00","5:30","","","","",0,"DN","D"],["260707","19:00","7:30","","","","",0,"N","N"],["260708","19:00","6:30","","","","",0,"N","N","ND"],["260709","","","8:00","16:00","","",0,"","N","SC"],["260710","","","8:00","17:30","","",0,"","N","D"],["260715","8:00","17:30","","","","",0,"D","D"],["260716","8:00","18:30","","","","",0,"D","D"],["260717","8:00","18:00","19:00","3:30","","",0,"D","D","DN"],["260719","8:00","6:30","","","","",0,"DN","D"],["260720","19:00","7:30","","","","",0,"N","N"],["260722","19:00","7:30","","","","",0,"N","N"],["260723","19:00","7:30","","","","",0,"N","N","ND"],["260724","","","8:00","18:00","","",0,"","N","SC"],["260729","8:00","19:00","","","","",0,"D","D"],["260730","8:00","16:00","","","","",0,"D","D"],["260731","8:00","18:30","","","","",0,"D","D"],["260801","8:00","18:30","","","","",0,"D","D"],["260802","8:00","12:00","","","","",0,"DN","D"],["260803","19:00","4:30","","","","",0,"N","N"],["260804","19:00","7:30","","","","",0,"N","N"],["260806","19:00","6:30","","",2,"",0,"N","N","ND"],["260807","","","8:00","16:00","","",0,"","N","SC"],["260808","19:00","6:30","","","","",0,"N","N"],["260810","8:00","15:00","","","","",0,"D","D"],["260811","8:00","16:30","","","","",0,"D","D"],["260812","8:00","18:30","","","","",0,"D","D"],["260813","8:00","18:30","","",2,"",4,"D","D"],["260814","8:00","18:00","","",2,"",0,"D","D"],["260815","8:00","18:00","19:00","4:00",2,2,0,"D","D","DN"],["260817","19:00","23:30","","","","",0,"N","N"],["260818","19:00","22:00","","","","",0,"N","N"],["260821","19:00","7:00","","","","",0,"N","N"],["260822","19:00","6:30","","","","",0,"N","N","ND"],["260823","","","8:00","16:00","","",0,"","R"],["260824","8:00","18:30","","","","",0,"D","D"],["260825","8:00","16:00","","","","",0,"D","D"],["260827","8:00","16:00","","","","",0,"D","D"],["260828","8:00","15:30","","","","",0,"D","D"],["260829","8:00","16:00","","","","",0,"D","D"],["260830","8:00","7:30","","","","",0,"DN","D"],["260831","19:00","7:30","","","","",0,"N","N"],["260901","19:00","8:00","","","","",0,"N","N"],["260911","8:00","18:30","19:00","19:30","","",0,"D","D","DN"],["260913","8:00","18:30","","",2,"",0,"DN","D"],["260914","19:00","7:30","","","","",0,"N","N"],["260915","19:00","7:00","","","","",2,"N","N"],["260917","19:00","7:30","","",1,"",0,"N","N"],["260922","8:00","18:30","19:00","6:30",1,"",4,"D","D","DN"],["260923","","","19:00","22:00","","",0,"","D","N"],["260926","8:00","18:30","19:00","5:30","","",0,"D","D","DN"],["260927","19:00","7:30","","","","",0,"N","D","ND"],["260928","","","8:00","11:30","","",0,"","N","SC"]]};
let _excelAttByYm = null;
function excelAttIndex(){
  if(_excelAttByYm) return _excelAttByYm;
  _excelAttByYm = new Map();
  Object.entries(EXCEL_ATT).forEach(([name, list])=> list.forEach(r=>{
    const ym = '20'+r[0].slice(0,2)+'-'+r[0].slice(2,4);
    if(!_excelAttByYm.has(ym)) _excelAttByYm.set(ym, []);
    _excelAttByYm.get(ym).push([name, r]);
  }));
  return _excelAttByYm;
}
function excelAttRec(r, empId){
  const ds = '20'+r[0].slice(0,2)+'-'+r[0].slice(2,4)+'-'+r[0].slice(4,6);
  const fl = r[7]||0, workCheck = r[8]||'', code = r[10]||'';
  const ALL_WORK = new Set(WORK_CODES.map(w=>w.code));
  const rec = {date:ds, employeeId:empId, checkIn:r[1]||'', checkOut:r[2]||'', supportIn:r[3]||'', supportOut:r[4]||'',
    honjoComp:r[5]||'', tajoComp:r[6]||'', jochul:!!(fl&1), seokchul:!!(fl&2), jungsik:!!(fl&4), yasik:!!(fl&8),
    extCode:!!(fl&16), manguen:!!(fl&32), attCode: code, _emb:true};
  if(r[9]) rec.baseShift = r[9];
  if(code && ALL_WORK.has(code)){ rec.workCode = code; rec.statusCode = ''; }
  else if(code){ rec.statusCode = code; rec.workCode = (workCheck && ALL_WORK.has(workCheck)) ? workCheck : 'OFF'; }
  else if(workCheck && ALL_WORK.has(workCheck)) rec.workCode = workCheck;
  return rec;
}
// 해당 달에 클라우드 기록이 없는 날만 원본 기록으로 채움
function mergeExcelAtt(ym){
  if(typeof employees==='undefined' || !employees.length) return;
  const list = excelAttIndex().get(ym); if(!list) return;
  const byName = {}; employees.forEach(e=>{ byName[String(e.name||'').trim()] = e.id; });
  list.forEach(([name, r])=>{
    const id = byName[name]; if(!id) return;
    const ds = '20'+r[0].slice(0,2)+'-'+r[0].slice(2,4)+'-'+r[0].slice(4,6), key = ds+'_'+id;
    if(!attStore[key] || attStore[key]._emb) attStore[key] = normAtt(excelAttRec(r, id));
  });
}
function hasExcelAtt(ds, name){ const list = excelAttIndex().get(ds.slice(0,7)); return !!(list && list.some(([n, r])=> n===name && '20'+r[0].slice(0,2)+'-'+r[0].slice(2,4)+'-'+r[0].slice(4,6)===ds)); }
function isSupportCode(a){ return !!a && (a==='SP' || a==='D' || a==='N' || a==='DN' || a==='DS' || a==='NS' || a.startsWith('ND')); }
// 근태 집계 '지원근무' 개수: 선지원은 DS(주간지원)·NS(야간지원)로 입력.
//  예전(2026-10-11까지)에는 근무 주와 반대인 D·N 을 지원으로 셌으므로 그 날짜까지만 D·N 도 지원으로 셈(지난 집계가 바뀌지 않게)
const SUP_DSNS_FROM = '2026-10-12';
function isSupportCount(a, ds){
  if(!a) return false;
  if(a==='D' || a==='N') return !!ds && ds < SUP_DSNS_FROM;
  return isSupportCode(a);
}
function isSupportDay(rec){
  if(!rec) return false;
  const a = rec.attCode;
  if(a===undefined){
    if(!rec.date || rec.date > IMPORT_LAST_DATE) return false;
    const e = employees.find(x=>x.id===rec.employeeId);
    return !!e && excelSupportHas(rec.date, String(e.name||'').trim());
  }
  return isSupportCode(a);
}
function isRefCode(c){ return !!c && (refWorkCodes().has(c) || refStatusCodes().has(c)); }
// 셀에 보여줄 코드: 근태코드(참조표에 있을 때) → 근무코드(OFF 제외, 참조표에 있을 때)
function gridCode(rec, ds, name){
  const a = effCode(rec, ds, name);
  if(!a || a==='OFF') return '';
  if(isSupportCode(a)) return a;           // 근태코드 칸의 DN·ND·D·N·SP
  return isRefCode(a) ? a : '';
}
// ===== 교대 근무 순환 (주 단위, 월요일 시작) =====
// 기준 주에 1조가 D면 2조는 N, 다음 주마다 서로 바뀜. 원본 엑셀(2025-12-22 주 1조 D)과 같은 규칙
let rotation = {start:'2025-12-22', team1:'D'};
function scheduledShift(ds, team){
  if(!rotation || !rotation.start || !ds || (team!=='1' && team!=='2')) return '';
  const a = mondayOf(rotation.start), b = mondayOf(ds);
  const [y1,m1,d1] = a.split('-').map(Number), [y2,m2,d2] = b.split('-').map(Number);
  const weeks = Math.round((Date.UTC(y2,m2-1,d2) - Date.UTC(y1,m1-1,d1)) / (7*86400000));
  const t1 = rotation.team1==='N' ? 'N' : 'D';
  const flip = c => c==='D' ? 'N' : 'D';
  const c1 = (((weeks % 2) + 2) % 2) ? flip(t1) : t1;
  return team==='1' ? c1 : flip(c1);
}
function empScheduled(empId, ds){ const e = employees.find(x=>x.id===empId); return e ? scheduledShift(ds, e.team||'') : ''; }
function displayCode(rec){
  if(!rec) return '';
  if(rec.statusCode && isRefCode(rec.statusCode)) return rec.statusCode;
  if(rec.workCode && rec.workCode!=='OFF' && isRefCode(rec.workCode)) return rec.workCode;
  return '';
}

const OT_NOTE = '원본 엑셀(DB입력) 6,048행의 계산 결과와 한 줄씩 대조해 총OT가 모두 일치함을 확인했습니다. 표준 시업시각(본출근 6~14시→08:00 / 14~24시→19:00), 휴일·일요일 퇴근보전(편성 근무코드 기준: 주간 8~12시 퇴근→12:00 보장, 야간 19~24시 퇴근→24:00 보장), 야식 중복공제 방지, 연근(휴일 2배) 반영. 토요일 특근은 그 주 월~금이 출근·공휴일·VA·VP·E·FCH·MCH·UJ로 모두 채워지면 자동으로 적용되며(원본 규칙), 필요하면 월별표 토요일 칸에서 수동으로 인정할 수 있습니다.';

function dateAt(dateStr, h, m, addDay){
  const [y,mo,d] = dateStr.split('-').map(Number);
  return new Date(y, mo-1, d + (addDay||0), h, m||0);
}
// 분 반올림 규칙: 1~29분→30분, 31~59분→다음 시(0분). 0/30분은 그대로.
function normalizeHM(h,m){
  h = Math.round(h); m = Math.round(m);
  if(m>=1 && m<=29) m = 30;
  else if(m>=31 && m<=59){ h += 1; m = 0; }
  let dayOffset = 0;
  while(h > 24){ h -= 24; dayOffset += 1; }
  return {h, m, dayOffset};
}
// 입력값은 "H:MM" (H=1~24, M=00 또는 30) 체계 — 원본 엑셀의 HH.MM(24시=자정) 표기와 동일한 규칙
function parseHM(dateStr, hm){
  if(!hm) return null;
  let [h,m] = hm.split(':').map(Number);
  if(isNaN(h) || isNaN(m)) return null;
  const norm = normalizeHM(h,m);
  const dayOffset = (norm.h===24 ? 1 : 0) + norm.dayOffset;
  const realHour = norm.h===24 ? 0 : norm.h;
  return dateAt(dateStr, realHour, norm.m, dayOffset);
}
function toDec(hm){
  let [h,m] = hm.split(':').map(Number);
  const norm = normalizeHM(h,m);
  return norm.h + norm.m/60;
}
const HOUR_OPTIONS = Array.from({length:24}, (_,i)=>i+1); // 1~24시
const MIN_OPTIONS = ['00','30'];
function timeSelectHtml(name, value){
  let h='', m='';
  if(value){ const p = value.split(':'); h = p[0]; m = p[1]; }
  const hOpts = HOUR_OPTIONS.map(x=>`<option value="${x}"${String(x)===String(h)?' selected':''}>${x}시</option>`).join('');
  const mOpts = MIN_OPTIONS.map(x=>`<option value="${x}"${x===m?' selected':''}>${x}분</option>`).join('');
  return `<select name="${name}H" style="border:1px solid var(--border);border-radius:8px;padding:8px 6px;background:var(--bg);color:var(--text);font-size:13px;"><option value="">시</option>${hOpts}</select>` +
         `<select name="${name}M" style="border:1px solid var(--border);border-radius:8px;padding:8px 6px;background:var(--bg);color:var(--text);font-size:13px;"><option value="">분</option>${mOpts}</select>`;
}
// 시간 범위를 제한한 드롭다운(예: 본출근 8~12시, 지원출근 19~24시) - 분은 00/30 그대로
function timeSelectRangeHtml(name, value, hours){
  let h='', m='';
  if(value){ const p = value.split(':'); h = p[0]; m = p[1]; }
  if(h && !hours.map(String).includes(String(Number(h)))) hours = hours.concat([Number(h)]).sort((a,b)=>a-b);
  const hOpts = hours.map(x=>`<option value="${x}"${String(x)===String(h)?' selected':''}>${x}시</option>`).join('');
  const mOpts = MIN_OPTIONS.map(x=>`<option value="${x}"${x===m?' selected':''}>${x}분</option>`).join('');
  return `<select name="${name}H" style="border:1px solid var(--border);border-radius:8px;padding:8px 6px;background:var(--bg);color:var(--text);font-size:13px;"><option value="">시</option>${hOpts}</select>` +
         `<select name="${name}M" style="border:1px solid var(--border);border-radius:8px;padding:8px 6px;background:var(--bg);color:var(--text);font-size:13px;"><option value="">분</option>${mOpts}</select>`;
}
function readTimeSelect(f, name){
  const h = f.get(name+'H'), m = f.get(name+'M');
  return (h && m) ? `${h}:${m}` : '';
}
// 본출근/지원출근처럼 값이 정해진 몇 가지 시각 중 하나만 고르면 되는 필드용 - 버튼 2개 + 숨은 input
function quickTimeButtons(name, options, curVal){
  const idxOn = options.findIndex(([val])=>val===curVal); // curVal 없으면 -1(둘 다 미선택 표시)
  const label = options.map(([val,lbl],i)=>
    `<span style="opacity:${i===idxOn?'1':'.45'};font-weight:${i===idxOn?'800':'600'};">${esc(lbl)}</span>`
  ).join('');
  return `<button type="button" class="quickTimeBtn" data-quick-name="${esc(name)}" data-quick-opts="${esc(options.map(o=>o[0]).join(','))}"
      style="border:2px solid var(--border);border-radius:8px;padding:8px 16px;font-size:13px;background:var(--bg);color:var(--text);cursor:pointer;">${label}</button>
    <input type="hidden" name="${esc(name)}" id="${esc(name)}Field" value="${esc(curVal||'')}">`;
}
// 토요일 만근 자동 판정 (원본 엑셀 규칙 — 864개 토요일 전부 대조 일치):
// 그 주 월~금 5일이 모두 '출근(본출근 입력) · 공휴일 · 인정 근태코드' 중 하나면 만근 → 토요일 근무는 특근(SA)
const MANGUEN_CODES = new Set(['VA','VP','E','FCH','MCH','UJ','LS','SV','CK','AV','RV']);
function autoManguen(dateStr, empId){
  if(!empId || typeof attStore==='undefined') return false;
  const [y,m,d] = dateStr.split('-').map(Number);
  if(new Date(y,m-1,d).getDay()!==6) return false;
  for(let i=5;i>=1;i--){
    const ds = addDays(dateStr, -i);
    const r = attStore[ds+'_'+empId];
    const ok = (r && r.checkIn && !preSupportRec(r, ds)) || isHolidayFor(ds, empId) || (r && MANGUEN_CODES.has(r.statusCode));
    if(!ok) return false;
  }
  return true;
}
function recManguen(rec, dateStr){ return !!(rec && (rec.manguen || autoManguen(dateStr, rec.employeeId))); }
// ===== 노조별 설립일(사람마다 다른 공휴일) =====
// SNCT노조(1조 + 고훈희·유재현): 6/15 / 통합노조(그 외 2조): 1/2 — 해마다 같은 날짜
const UNION_DAYS = [{md:'06-15', union:'1', name:'SNCT노조설립일'}, {md:'01-02', union:'2', name:'통합노조설립일'}];
const DEFAULT_UNION2 = new Set(['선종화','우창기','유재선','임성현','강대정','김재천','윤성하','황대영','홍윤택','강위상','김세중','박종국','김성일']);
function unionOf(e){
  if(!e) return '1';
  if(e.unionGroup==='1' || e.unionGroup==='2') return e.unionGroup;
  return DEFAULT_UNION2.has(String(e.name||'').trim()) ? '2' : '1';
}
function isHolidayFor(ds, empId){
  const rule = UNION_DAYS.find(u=> ds.slice(5)===u.md);
  if(rule && empId && typeof employees!=='undefined'){
    const e = employees.find(x=>x.id===empId);
    if(e) return unionOf(e)===rule.union;
  }
  return !!holidays[ds];
}
function dayCategory(dateStr, manguen, empId){
  const [wy,wm,wd] = dateStr.split('-').map(Number);
  const w = new Date(wy, wm-1, wd).getDay(); // 0=일 6=토, 타임존 안전 파싱
  const isHoliday = isHolidayFor(dateStr, empId);
  if(w===0) return 'SU';
  if(isHoliday) return 'H';
  if(w===6) return manguen ? 'SA' : 'W'; // 만근(이번주 평일 개근) 체크된 토요일만 특근(SA)으로 인정
  return 'W';
}
// 선지원: 편성이 야간(N)인 사람이 주간(D)에 출근(본출근 14시 이전)하면 본근무가 아니라 지원근무로 계산
// (원본 엑셀은 이런 날을 지원출근/지원퇴근 칸에 입력함 — 본출근 칸에 넣어도 같은 결과가 나오게 자동으로 옮겨 계산)
function preSupportRec(rec, dateStr){
  if(!rec || !rec.checkIn || !rec.checkOut || rec.supportIn || rec.supportOut) return null;
  if(toDec(rec.checkIn) > 14) return null;
  // 교육·노조업무처럼 주간 본근무로 인정되는 날(원본 엑셀은 근무 칸에 D 체크)은 선지원이 아님
  if(['E','UJ','EC'].includes(rec.statusCode)) return null;
  if(rec.statusCode && (rec.workCode==='D' || rec.workCode==='DN')) return null;
  const sched = rec.baseShift || ((typeof empScheduled==='function' && rec.employeeId) ? empScheduled(rec.employeeId, dateStr) : '');
  if(sched !== 'N') return null;
  return Object.assign({}, rec, {supportIn: rec.checkIn, supportOut: rec.checkOut, checkIn: '', checkOut: ''});
}
// 하루치 근태 기록으로부터 근무시간/초과/심야/가산시간을 계산 (원본 DB입력 수식 100% 대조 검증됨)
function computeDaily(rec, dateStr){
  const zero = {totalWork:0, meal:0, overtime:0, night:0, category:'-', premium:0, valid:false};
  if(!rec || !rec.checkIn || !rec.checkOut) return zero;
  if(preSupportRec(rec, dateStr)) return zero; // 선지원 → 지원근무로 계산(computeSupportDaily)
  // 근무코드: 월별표에서 지정한 값(D·N 등). 없으면(출퇴근 입력만 한 날) 본출근 시각으로 주간/야간을 판단.
  // 편집자가 월별표에서 직접 OFF로 지정한 날만 계산하지 않음
  let wc = (rec.workCode && rec.workCode!=='OFF') ? rec.workCode : '';
  const sched = (typeof empScheduled==='function' && rec.employeeId) ? empScheduled(rec.employeeId, dateStr) : '';
  if(!wc){
    // 월별 근태에서 코드를 지우면 OFF로 남는데, 출퇴근 시간을 실제로 입력한 날은 근무한 것으로 계산.
    // (휴가 등 근태코드가 있는 OFF 날만 계산하지 않음)
    // SP(지원패스)·DS 등 근무 코드가 근태코드로 들어간 날은 본근무를 했으니 계산함
    if(rec.attManual && rec.workCode==='OFF' && rec.statusCode && !DP_WORK_CODES.has(rec.statusCode)) return zero;
    wc = sched || (toDec(rec.checkIn) <= 14 ? 'D' : 'N');
  }

  const checkinDec = toDec(rec.checkIn);
  let start;
  if(checkinDec<=14) start = dateAt(dateStr,8,0);
  else if(checkinDec<=24) start = dateAt(dateStr,19,0);
  else return zero;

  let actualEnd = parseHM(dateStr, rec.checkOut);
  if(!actualEnd) return zero;
  if(actualEnd<=start) actualEnd = new Date(actualEnd.getTime()+24*3600000);
  const checkoutDec = toDec(rec.checkOut);

  const kcat = dayCategory(dateStr, recManguen(rec, dateStr), rec.employeeId);

  let guaranteedEnd = actualEnd;
  // 퇴근보전은 원본 엑셀처럼 '근무코드(편성된 주간/야간)' 기준으로 판단. 엑셀에서 가져온 기록은 baseShift(D/N)에 들어 있음
  const gCode = rec.baseShift || sched || wc; // 편성 근무코드(교대 순환) 기준
  if(kcat==='SU' || kcat==='H'){
    if((gCode==='D'||gCode==='DN') && checkoutDec>8 && checkoutDec<12){
      guaranteedEnd = dateAt(dateStr,12,0);
    }
    if((gCode==='N'||gCode==='ND') && checkoutDec>=19 && checkoutDec<=24){
      guaranteedEnd = dateAt(dateStr,0,0,1); // 24:00 = 익일 00:00
    }
  }

  let meal = 0;
  const noon12=dateAt(dateStr,12,0), noon13=dateAt(dateStr,13,0);
  if(start<noon12 && guaranteedEnd>noon13) meal+=1;
  const eve18=dateAt(dateStr,18,0), eve19=dateAt(dateStr,19,0);
  if(start<eve18 && guaranteedEnd>eve19) meal+=1;
  const next1=dateAt(dateStr,1,0,1);
  if(guaranteedEnd>=next1) meal+=1;

  const raw = (guaranteedEnd-start)/3600000;
  const totalWork = Math.max(raw - meal, 0);
  const overtime = Math.max(totalWork - 8, 0);

  const night22=dateAt(dateStr,22,0), next6=dateAt(dateStr,6,0,1);
  let night = 0;
  const wsExists = guaranteedEnd>night22, weExists = actualEnd>night22;
  if(wsExists && weExists){
    const ws = start>night22 ? start : night22;
    const we = actualEnd<next6 ? actualEnd : next6;
    const wm = rec.yasik ? 0 : (guaranteedEnd>=next1 ? 1 : 0);
    night = Math.max((we-ws)/3600000 - wm, 0);
  }

  let category, premium;
  if(kcat==='SU' || kcat==='H'){
    const mult = rec.extCode ? 2 : 1.5;
    premium = totalWork*mult + overtime*0.5 + night*0.5;
    category = kcat==='SU' ? '일요일' : '공휴일';
  } else if(kcat==='SA'){
    premium = totalWork*1.5 + night*0.5;
    category = '토요일';
  } else {
    premium = rec.extCode ? (totalWork*1.5+night*0.5) : (overtime*1.5+night*0.5);
    category = '평일';
  }
  return {totalWork, meal, overtime, night, category, premium, valid:true};
}
function fmtH(n){ return (Math.round(n*10)/10).toFixed(1); }

// 조출/석출/중식/야식 - 각 1건당 1.5시간 가산 (원본 식사계 = SUM(조출,석출,중식,야식)*1.5)
// 담당: 출퇴근 입력에서 체크하면 식사연장과 같은 1.5시간 OT — 월별 OT현황·급여명세서에만 반영(근태관리 집계에는 넣지 않음)
function computeDamdang(rec){ return rec && rec.damdang ? 1.5 : 0; }
function computeMealAllowance(rec){
  if(!rec) return 0;
  const cnt = [rec.jochul, rec.seokchul, rec.jungsik, rec.yasik].filter(Boolean).length;
  return cnt * 1.5;
}

// 지원출근/지원퇴근 기준 지원근무 가산시간 계산 (본조보상/타조보상 수동입력 포함, 100% 대조 검증됨)
function computeSupportDaily(rec, dateStr){
  const zero = {supTotal:0, supOT:0, supNight:0, premium:0, valid:false};
  if(!rec) return zero;
  rec = preSupportRec(rec, dateStr) || rec; // 선지원(N편성 → 주간 출근)은 본출근·본퇴근을 지원 시간으로
  const honjo = Number(rec.honjoComp)||0, tajo = Number(rec.tajoComp)||0;
  const hasSupportShift = !!(rec.supportIn && rec.supportOut);
  if(!hasSupportShift && honjo===0 && tajo===0) return zero;

  let supTotal=0, supOT=0, supNight=0;
  let shiftParsed = false;
  if(hasSupportShift){
    let start = parseHM(dateStr, rec.supportIn);
    let end = parseHM(dateStr, rec.supportOut);
    if(start && end){
      shiftParsed = true;
      if(end <= start) end = new Date(end.getTime() + 24*3600000);

      const totalRaw = (end-start)/3600000;
      let meal = 0;
      const noon12=dateAt(dateStr,12,0), noon13=dateAt(dateStr,13,0);
      if(start<noon12 && end>noon13) meal+=1;
      const eve18=dateAt(dateStr,18,0), eve19=dateAt(dateStr,19,0);
      if(start<eve18 && end>eve19) meal+=1;
      const next1=dateAt(dateStr,1,0,1);
      if(end>=next1) meal+=1;
      supTotal = Math.max(totalRaw - meal, 0);
      supOT = Math.max(supTotal - 8, 0);

      const night22=dateAt(dateStr,22,0), next6=dateAt(dateStr,6,0,1);
      if(end>night22){
        const ws = start>night22 ? start : night22;
        const we = end<next6 ? end : next6;
        const wm = rec.yasik ? 0 : (end>=next1 ? 1 : 0);
        supNight = Math.max((we-ws)/3600000 - wm, 0);
      }
    }
  }

  const kcat = dayCategory(dateStr, recManguen(rec, dateStr), rec.employeeId);
  let premium;
  if(shiftParsed){
    if(kcat==='SU' || kcat==='H' || kcat==='SA'){
      premium = (8 + supOT + tajo)*2 + honjo*1.5 + supNight*0.5;
    } else {
      premium = (8 + supOT + tajo + honjo)*1.5 + supNight*0.5;
    }
  } else {
    // 실제 지원근무 없이 본조보상/타조보상만 입력된 경우 (원본 수식 기준):
    // 본조보상은 요일과 관계없이 1.5배, 타조보상은 휴일·토요일 2배 / 평일 1.5배
    const tajoMult = (kcat==='SU' || kcat==='H' || kcat==='SA') ? 2 : 1.5;
    premium = honjo * 1.5 + tajo * tajoMult;
  }
  return {supTotal, supOT, supNight, premium, valid:true};
}

