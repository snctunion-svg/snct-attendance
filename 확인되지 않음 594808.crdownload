// 개인별 연가 누계(성명 클릭 팝업): 원본 '정기·연차·근속·병가' 표와 같은 방식(시작일부터 1년)
const LEAVE_TYPES = [['RV','정기'],['AV','연차'],['LS','근속'],['SL','병가'],['TL','휴직']];
const LEAVE_SET = new Set(LEAVE_TYPES.map(x=>x[0]));
let _excelLeaveMap = null;
function excelLeave(ds, name){
  if(!_excelLeaveMap){
    _excelLeaveMap = new Map();
    Object.entries(EXCEL_LEAVE).forEach(([n, list])=> list.split(',').forEach(x=>{
      const [d, c] = x.split(':');
      _excelLeaveMap.set('20'+d.slice(0,2)+'-'+d.slice(2,4)+'-'+d.slice(4,6)+'|'+n, c);
    }));
  }
  return _excelLeaveMap.get(ds+'|'+name) || '';
}
// 그 날의 연가 코드: 편집자가 직접 입력한 코드 → 원본 엑셀 코드 → 저장된 코드 순
function leaveCodeFor(rec, ds, name){
  const c = effCode(rec, ds, name);
  return LEAVE_SET.has(c) ? c : '';
}
function yearEnd(start){ const [y,m,d] = start.split('-').map(Number); return addDays(dstr(y+1, m, Math.min(d, daysInMonth(y+1, m))), -1); }
function leaveCounts(emp, start){
  const end = yearEnd(start), name = String(emp.name||'').trim(), cnt = {};
  LEAVE_TYPES.forEach(([c])=> cnt[c] = 0);
  for(let ds=start; ds<=end; ds=addDays(ds,1)){
    const c = leaveCodeFor(attStore[ds+'_'+emp.id], ds, name);
    if(c) cnt[c]++;
  }
  return {cnt, end, total: Object.values(cnt).reduce((a,b)=>a+b,0)};
}
let adjPop = null; // {empId, key, label, raw}
function renderAdjPop(){
  const e = employees.find(x=>x.id===adjPop.empId); if(!e) return '';
  const cur = userAdjOf(e, adjPop.key), raw = Number(adjPop.raw)||0;
  const f = x => (Math.round(x*100)/100).toLocaleString();
  return `<div id="adjScrim" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;display:flex;align-items:center;justify-content:center;">
    <div class="panel" style="max-width:420px;width:94%;margin:0;">
      <h3 style="margin:0 0 4px;">${esc(e.name)} · ${esc(adjPop.label)}</h3>
      <p class="hint" style="margin:0 0 12px;">근태 집계에는 <b>현재값 + 보정값</b>이 표시됩니다(순번에도 반영). <b>입력값</b>에 더하거나 뺄 숫자만 넣으면 보정값에 더해져요.</p>
      <div class="apGrid">
        <label>현재값</label><span></span><label>보정값</label><span></span><label>입력값</label><span></span><label>합계</label>
        <div class="apNum">${f(raw)}</div>
        <div class="apOp">+</div>
        <div class="apNum" id="adjCur">${f(cur)}</div>
        <div class="apOp"><button type="button" id="adjSign" class="apSign" data-sign="${adjPop.sign===-1?'-1':'1'}" aria-label="더하기/빼기 바꾸기">${adjPop.sign===-1?'−':'+'}</button></div>
        <input type="number" step="0.01" min="0" inputmode="decimal" id="adjInput" value="${esc(adjPop.val||'')}" placeholder="0">
        <div class="apOp">=</div>
        <div id="adjSum" class="apNum" style="color:var(--accent);">${f(raw + cur + (Number(adjPop.val)||0) * (Number(adjPop.val)<0 ? 1 : (adjPop.sign||1)))}</div>
      </div>
      <div id="adjNew" class="hint" style="margin:8px 0 0;">저장하면 보정값: <b>${f(cur + (Number(adjPop.val)||0) * (Number(adjPop.val)<0 ? 1 : (adjPop.sign||1)))}</b></div>
      <div class="row" style="justify-content:flex-end;margin-top:10px;">
        <button class="btn ghost sm" id="adjCancel">취소</button><button class="btn sm" id="adjSave">저장</button>
      </div>
    </div></div>`;
}
let dayMemos = {}; // 날짜별 메모(월별 근태코드 날짜 머리글) — 팝업에서만 보임
// 날짜 메모에 이름을 적으면(예: 인규,동화,인기,치수) 그날 VP·AV·RV·LS 칸에 적은 순서(1,2,3,4)를 아주 작은 숫자로 표시
//   이름은 성 빼고 써도 됨(인규 = 노인규). 쉼표·띄어쓰기·가운뎃점·슬래시로 구분, '메모:' 같은 앞말은 무시
const MEMO_NO_CODES = new Set(['VP','AV','RV','LS']);
// 메모는 조별로 따로 저장: 키 = '날짜_조'(예: 2026-10-05_1). 예전(날짜만) 메모는 조별 메모가 없을 때만 보여 줌
function memoKey(ds, team){ return (team==='1' || team==='2') ? ds + '_' + team : ds; }
function memoOf(ds, team){ const k = memoKey(ds, team); return (k in dayMemos) ? (dayMemos[k] || '') : (dayMemos[ds] || ''); }
function memoOrderNo(ds, name, team){
  let txt = String(memoOf(ds, team) || ''); const ci = Math.max(txt.lastIndexOf(':'), txt.lastIndexOf('：')); if(ci >= 0) txt = txt.slice(ci + 1);   // '10월5일 메모 :' 같은 앞말은 버림
  if(!txt) return 0;
  const full = String(name||'').trim(); if(!full) return 0;
  const toks = txt.split(/[,，、·\/\s]+/).map(t=> t.trim()).filter(Boolean);
  const i = toks.findIndex(t=> t===full || (t.length >= 2 && full.length > t.length && full.endsWith(t)));
  return i >= 0 ? i + 1 : 0;
}
let dayMemoOpen = null;
function dayMemoTeams(){ return combinedTeamFilter ? [combinedTeamFilter] : ['1','2']; }   // 1조/2조 화면은 그 조만, 전체는 둘 다
function renderDayMemo(){
  const ds = dayMemoOpen, [y,m,d] = ds.split('-').map(Number);
  const teams = dayMemoTeams(), two = teams.length > 1;
  const box = t => { const v = memoOf(ds, t);
    return `${`<div style="font-weight:700;font-size:13px;margin:${t===teams[0]?'0':'10px'} 0 4px;color:var(--primary);">${t}조</div>`}` +
      (canEdit ? `<textarea class="dmText" data-team="${t}" ${t===teams[0]?'id="dmText"':''} rows="${two?3:4}" style="width:100%;border:1px solid var(--border);border-radius:8px;padding:8px;background:var(--bg);color:var(--text);font:inherit;">${esc(v)}</textarea>`
               : `<div style="white-space:pre-wrap;min-height:${two?24:40}px;">${v ? esc(v) : '<span class="hint">메모가 없습니다.</span>'}</div>`); };
  return `<div id="dmScrim" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;display:flex;align-items:center;justify-content:center;">
    <div class="panel" style="max-width:380px;width:92%;margin:0;">
      <h3 style="margin:0 0 10px;">${m}/${d}(${weekdayKr(y,m,d)}) 메모</h3>
      ${teams.map(box).join('')}
      <div class="row" style="justify-content:flex-end;margin-top:10px;">
        <button class="btn ghost sm" id="dmClose">닫기</button>${canEdit ? '<button class="btn sm" id="dmSave">저장</button>' : ''}
      </div>
    </div></div>`;
}
// ===== 메일 송부: 매주 화요일 09시 지난주(월~일) 출퇴근 입력 전체를 이메일로(Apps Script가 발송) =====
let mailConfig = {}, mailSending = false, mailRange = null; // mailRange = {start, end} (처음엔 오늘)
const MAIL_MAX_DAYS = 31;
function mailRangeNow(){
  if(!mailRange){ const t = todayStr(); mailRange = {start: t, end: t}; } // 처음 열면 오늘 날짜
  return mailRange;
}
function mailDayCount(a, b){ return Math.round((new Date(b+'T00:00:00') - new Date(a+'T00:00:00'))/86400000) + 1; }
function mailHm(v){ if(!v) return ''; const [h,m] = String(v).split(':'); return Number(m) ? `${Number(h)}.${String(m).replace(/0$/,'')}` : String(Number(h)); }
function pageMail(){
  const {start, end} = mailRangeNow();
  const to = (mailConfig.to||[]).join('\n');
  // 근태관리와 같은 순서(1조 → 2조, 조편성 순번)로 전원 표시
  const emps = employees.filter(e=>e.name && e.active!==false).slice().sort((a,b)=>{ const ta=a.team||'9', tb=b.team||'9'; if(ta!==tb) return ta<tb?-1:1; return (a.teamOrder||999)-(b.teamOrder||999) || String(a.name).localeCompare(String(b.name)); });
  const sum = {}; let days = '';
  for(let ds=start; ds<=end; ds=addDays(ds,1)){
    const [y,m,d] = ds.split('-').map(Number);
    const rows = emps.map(e=>{
      const rec = attStore[ds+'_'+e.id] || {};
      // 근태관리 표와 같은 규칙: 직접 입력 → 원본 엑셀(1조·2조) → 저장된 값 (2조처럼 클라우드에 코드만 있는 날이 없어도 표시)
      const code = effCode(rec, ds, String(e.name||'').trim());
      let tot = 0;
      if(rec.date){ const c = computeDaily(rec, ds), sp = computeSupportDaily(rec, ds), ml = computeMealAllowance(rec); tot = (c.valid?c.premium:0) + (sp.valid?sp.premium:0) + ml; }
      sum[e.id] = (sum[e.id]||0) + tot;
      const ck = b => b ? '✔' : '';
      return `<tr><td>${esc(e.team? e.team+'조':'')}</td><td class="namecell">${esc(e.name)}</td><td>${code ? codeBadge(code) : esc(scheduledShift(ds, e.team||''))}</td>
        <td>${mailHm(rec.checkIn)}</td><td>${mailHm(rec.checkOut)}</td><td>${mailHm(rec.supportIn)}</td><td>${mailHm(rec.supportOut)}</td>
        <td>${esc(rec.honjoComp||'')}</td><td>${esc(rec.tajoComp||'')}</td><td>${ck(rec.jochul)}</td><td>${ck(rec.seokchul)}</td><td>${ck(rec.jungsik)}</td><td>${ck(rec.yasik)}</td>
        <td style="font-weight:800;color:#be185d;">${tot ? fmtH(tot) : ''}</td></tr>`;
    }).join('');
    days += `<h4 class="mailDay">${m}/${d}(${weekdayKr(y,m,d)})${holidays[ds] ? ' · '+esc(holidays[ds]) : ''}</h4>
      ${rows ? `<div class="scrollx"><table class="tbl mailTbl"><thead><tr><th>조</th><th>성명</th><th>근태</th><th>본출근</th><th>본퇴근</th><th>지원출근</th><th>지원퇴근</th><th>본조보상</th><th>타조보상</th><th>조출</th><th>석출</th><th>중식</th><th>야식</th><th>총OT</th></tr></thead><tbody>${rows}</tbody></table></div>` : '<div class="hint" style="margin:0 0 6px;">입력된 기록이 없습니다.</div>'}`;
  }
  const sumRows = emps.filter(e=>sum[e.id]).map(e=>`<tr><td>${esc(e.team? e.team+'조':'')}</td><td class="namecell">${esc(e.name)}</td><td style="font-weight:800;color:#be185d;">${fmtH(sum[e.id])}</td></tr>`).join('');
  return `
  <h2 class="pgttl">메일 송부</h2>
  <div class="panel">
    <h3>받는 사람</h3>
    <p class="hint" style="margin:0 0 10px;">아래에서 <b>날짜를 골라 [보내기]</b>를 누르면 그 기간의 1조·2조 출퇴근 입력을 이 주소로 보내요.</p>
    <div class="field" style="max-width:560px;"><label>받는 사람 (한 칸에 한 명 · 10명까지)</label>
      <div id="mailTo">${mailToGrid(mailConfig.to||[], '', '예) leader@snct.co.kr')}</div></div>
    <button class="btn" id="mailSave" style="margin-top:8px;">저장</button>
  </div>
  <div class="panel">
    <div class="row" style="align-items:center;margin-bottom:8px;">
      <h3 style="margin:0;">날짜 선택해서 보내기</h3>
      <input type="date" id="mailFrom" value="${start}" style="padding:5px 6px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;">
      <span>~</span>
      <input type="date" id="mailTo2" value="${end}" style="padding:5px 6px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;">
      <span style="flex:1"></span>
      <button class="btn sm" id="mailSendNow" ${mailSending?'disabled':''}>${mailSending ? '보내는 중…' : '📨 보내기'}</button>
    </div>
    ${days}
  </div>`;
}
function bindMailPage(){
  const sv = document.getElementById('mailSave');
  const fIn = document.getElementById('mailFrom'), tIn = document.getElementById('mailTo2');
  const onRange = (which)=>{
    let a = fIn.value, b = tIn.value;
    if(!a || !b) return;
    if(which==='from' && b < a) b = a;          // 시작일을 종료일 뒤로 바꾸면 종료일을 따라오게
    if(which==='to' && b < a) a = b;
    if(mailDayCount(a, b) > MAIL_MAX_DAYS){ showToast(`한 번에 최대 ${MAIL_MAX_DAYS}일까지 선택할 수 있어요.`); if(which==='from') b = addDays(a, MAIL_MAX_DAYS-1); else a = addDays(b, -(MAIL_MAX_DAYS-1)); }
    mailRange = {start: a, end: b}; setView('mail');
  };
  if(fIn) fIn.onchange = ()=>onRange('from');
  if(tIn) tIn.onchange = ()=>onRange('to');
  const sn = document.getElementById('mailSendNow');
  if(sn) sn.onclick = ()=>{
    if(!requireEdit() || mailSending) return;
    const to = mailConfig.to || [];
    if(!to.length){ showToast('받는 사람을 먼저 입력하고 저장해 주세요.'); return; }
    if(!vslApi){ showToast('Apps Script 웹 앱 주소가 설정되어 있지 않아요. (본선작업 화면에서 UNION이 설정)'); return; }
    const {start, end} = mailRangeNow();
    const [, sm, sd] = start.split('-').map(Number), [, em, ed] = end.split('-').map(Number);
    appConfirm(`${sm}/${sd} ~ ${em}/${ed} 출퇴근 입력 보고를 지금 ${to.length}명에게 보낼까요?`, async ()=>{
      mailSending = true; render();
      try{
        const api = vslApi.replace(/\/macros\/u\/\d+\/s\//, '/macros/s/');
        const r = await fetch(api + (api.includes('?') ? '&' : '?') + 'type=mail&start=' + start + '&end=' + end + '&t=' + Date.now());
        const j = await r.json();
        if(j && j.ok) showToast(`보냈습니다. (${(j.to||to).length}명)`);
        else if(j && j.berths !== undefined) showToast('Apps Script에 즉시 발송 기능이 아직 없어요. 새 코드로 바꾸고 새 버전으로 배포해 주세요.');
        else showToast('보내지 못했어요: ' + ((j && j.error) || '알 수 없는 오류'));
      }catch(err){ showToast('보내지 못했어요. 잠시 후 다시 시도해 주세요.'); }
      mailSending = false; render();
    });
  };
  if(sv) sv.onclick = async ()=>{
    if(!requireEdit()) return;
    const list = mailToRead(document.getElementById('mailTo'));
    const bad = list.filter(x=>!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(x));
    if(bad.length){ showToast('이메일 형식을 확인해 주세요: ' + bad.join(', ')); return; }
    if(list.length > MAIL_TO_MAX){ showToast('받는 사람은 10명까지예요.'); return; }
    mailConfig = {to:list, enabled:false}; // 자동 발송은 없앰(날짜를 골라 직접 보내기만)
    render();
    if(!db || demoMode) return;
    try{ await db.doc('meta/mailConfig').set(mailConfig); showToast('저장되었습니다.'); }
    catch(err){ showToast(saveErrMsg('저장에 실패했습니다.', err)); }
  };
}
let leaveEmpId = null;
let leaveYear = null; // 연간 누계 연도(1/1~12/31). 처음엔 근태관리 종료일의 연도
function renderLeaveModal(){
  const emp = employees.find(e=>e.id===leaveEmpId);
  if(!emp) return '';
  if(!leaveYear) leaveYear = Number((codeStatsEnd || todayStr()).slice(0,4));
  const {cnt} = leaveCounts(emp, `${leaveYear}-01-01`); // 원본처럼 연 단위(1/1~12/31)
  // 연차(AV): 사용 개수 옆에 급여관리의 연차 개수(총)와 잔여를 함께 표시
  const pm = payMgr[emp.id] || {}, manL = Number(pm.leave);
  const totL = (pm.leave!=='' && pm.leave!=null && Number.isFinite(manL) && manL>0 && leaveYear===annualLeaveYear()) ? manL : leaveCountAuto(pm.hire, leaveYear);
  const cells = LEAVE_TYPES.map(([c,l])=>{
    if(c==='AV' && totL!=null){
      const left = totL - cnt[c];
      return `<div class="card" style="padding:12px 6px;text-align:center;">
        <div class="n" style="font-size:22px;white-space:nowrap;">${cnt[c]}<span style="font-size:14px;color:var(--text-muted);font-weight:700;"> / ${totL}</span></div>
        <div class="l">${esc(l)}<br><b style="color:var(--text);">${c}</b></div>
        <div style="font-size:11px;font-weight:800;margin-top:3px;color:${left<0?'#dc2626':'#1d4ed8'};">잔여 ${left}</div></div>`;
    }
    return `<div class="card" style="padding:12px 10px;text-align:center;">
      <div class="n" style="font-size:22px;">${cnt[c]}</div><div class="l">${esc(l)}<br><b style="color:var(--text);">${c}</b></div></div>`;
  }).join('');
  return `<div id="leaveScrim" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;display:flex;align-items:center;justify-content:center;">
    <div class="panel" style="max-width:460px;width:92%;margin:0;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
        <h3 style="margin:0;">${esc(emp.name)} · 연간 누계</h3><span style="flex:1"></span>
        <button class="btn ghost sm" id="leaveClose">닫기</button>
      </div>
      <div style="display:flex;align-items:center;gap:8px;margin:0 0 12px;">
        <button class="btn ghost sm" id="leavePrevYear">◀</button>
        <b style="font-size:15px;">${leaveYear}년</b>
        <button class="btn ghost sm" id="leaveNextYear">▶</button>
        <span class="hint" style="margin:0;">${leaveYear}-01-01 ~ ${leaveYear}-12-31</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;">${cells}</div>
    </div>
  </div>`;
}
