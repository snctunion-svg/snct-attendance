<!DOCTYPE html>
<html lang="ko" data-site="union">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=5, user-scalable=yes, viewport-fit=cover">
<title>SNCT 노동조합</title>
<link rel="manifest" href="manifest.webmanifest?v=4">
<meta name="theme-color" content="#db2777">
<link rel="icon" type="image/png" sizes="192x192" href="union-icon-192.png">
<link rel="icon" type="image/png" sizes="32x32" href="union-favicon-32.png">
<link rel="apple-touch-icon" href="union-apple-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="노동조합">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<style>
/* 아이폰 Safari·안드로이드 크롬의 '글자 자동 확대' 끄기 — 서류를 화면에 맞춰 줄였을 때 일부 글씨만 커지는 문제 방지 */
html{-webkit-text-size-adjust:100% !important;text-size-adjust:100% !important;}
.docGrid,.docGrid *,.svPages,.svPages *{-webkit-text-size-adjust:none !important;text-size-adjust:none !important;}

:root{
  --accent:#1d4ed8; --accent-soft:#eff6ff; --accent-line:#bfdbfe;
  --warn:#b91c1c; --warn-soft:#fef2f2; --warn-line:#fecaca;
  --ok:#047857; --ok-soft:#ecfdf5; --ok-line:#a7f3d0;
  --amber:#b45309; --amber-soft:#fffbeb; --amber-line:#fde68a;
  --night:#4338ca; --night-soft:#eef2ff; --night-line:#c7d2fe;
  --text:#0f172a; --text-muted:#64748b; --border:#e2e8f0; --surface:#fff; --bg:#f1f5f9;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --accent:#60a5fa; --accent-soft:#101d33; --accent-line:#1e3a5f;
    --warn:#f87171; --warn-soft:#341316; --warn-line:#7f1d1d;
    --ok:#34d399; --ok-soft:#052a20; --ok-line:#065f46;
    --amber:#fbbf24; --amber-soft:#302205; --amber-line:#78350f;
    --night:#a5b4fc; --night-soft:#1c1a3d; --night-line:#3730a3;
    --text:#e5e9f0; --text-muted:#8b96a8; --border:#2c3646; --surface:#161d2b; --bg:#0c1119;
  }
}
:root{ --sky:#0369a1; --fill-sky:#e0f2fe; --ot:#854d0e; --ot-soft:#fef9c3; --mc:#15803d; --fill-fc:#cfe0ff; --fill-mc:#c9f2d6; --fill-red:#fdd5d5; --fc:#1e3a8a; --wk:#047857; --wk-soft:#d1fae5; --sup:#1d4ed8; --sup-soft:#dbeafe; --hol:#c2410c; --hol-soft:#ffedd5; }
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){ --sky:#7dd3fc; --fill-sky:#0c2d44; --ot:#fde047; --ot-soft:#332a05; --fill-fc:#1c2c52; --fill-mc:#12351f; --fill-red:#44181a; --mc:#4ade80; --fc:#93c5fd; --wk:#34d399; --wk-soft:#06291d; --sup:#60a5fa; --sup-soft:#0f1f3d; --hol:#fb923c; --hol-soft:#3a1706; } }
:root[data-theme="dark"]{ --sky:#7dd3fc; --fill-sky:#0c2d44; --ot:#fde047; --ot-soft:#332a05; --fill-fc:#1c2c52; --fill-mc:#12351f; --fill-red:#44181a; --mc:#4ade80; --fc:#93c5fd; --wk:#34d399; --wk-soft:#06291d; --sup:#60a5fa; --sup-soft:#0f1f3d; --hol:#fb923c; --hol-soft:#3a1706; }
:root[data-theme="dark"]{
  --accent:#60a5fa; --accent-soft:#101d33; --accent-line:#1e3a5f;
  --warn:#f87171; --warn-soft:#341316; --warn-line:#7f1d1d;
  --ok:#34d399; --ok-soft:#052a20; --ok-line:#065f46;
  --amber:#fbbf24; --amber-soft:#302205; --amber-line:#78350f;
  --night:#a5b4fc; --night-soft:#1c1a3d; --night-line:#3730a3;
  --text:#e5e9f0; --text-muted:#8b96a8; --border:#2c3646; --surface:#161d2b; --bg:#0c1119;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
body,.tbl th,.tbl td,button,input,select,textarea{word-break:keep-all;overflow-wrap:break-word;}
:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);}
html{scroll-padding-top:env(safe-area-inset-top,0px);}
html,body{height:100%;margin:0;}
body{background:var(--bg);color:var(--text);display:flex;flex-direction:column;overflow:hidden;
  font-family:'맑은 고딕','Malgun Gothic',Pretendard,-apple-system,sans-serif;font-size:14px;line-height:1.55;}

header.app{flex:0 0 auto;background:#fde2ec;border-bottom:3px solid #ec4899;
  display:flex;align-items:center;gap:12px;padding:9px 16px;z-index:300;}
header.app .badge{background:#db2777;color:#fff;font-size:10px;font-weight:700;
  letter-spacing:.06em;padding:2px 7px;border-radius:3px;margin-right:6px;vertical-align:2px;}
header.app h1{margin:0;font-size:17px;letter-spacing:-.02em;display:flex;align-items:center;gap:6px;}
header.app h1 .appLogo{width:38px;height:27px;flex:none;}
@media (max-width:700px){ header.app h1 .appLogo{width:32px;height:23px;} }
header.app .sub{color:var(--text-muted);font-size:11.5px;margin-top:1px;}
header.app .spacer{flex:1 1 auto;}
header.app .status{font-size:11px;color:var(--text-muted);display:flex;align-items:center;gap:6px;flex-wrap:wrap;justify-content:flex-end;}
header.app .status .btn{padding:4px 9px;font-size:11px;white-space:nowrap;}
header.app .status span{white-space:nowrap;}
@media (max-width:700px){
  header.app .sub{display:none;}
  header.app h1{font-size:15px;white-space:nowrap;}
  header.app .status .conn-txt{display:none;}
  header.app .status{gap:5px;}
}
header.app .dot{width:7px;height:7px;border-radius:50%;background:var(--ok);flex:none;}
header.app .dot.off{background:var(--text-muted);}
.menu-btn{display:none;border:1px solid var(--border);background:var(--surface);color:var(--text-muted);
  border-radius:7px;width:38px;height:38px;font-size:16px;cursor:pointer;flex:none;}

.layout{flex:1 1 auto;display:flex;min-height:0;}
nav#nav{flex:0 0 218px;width:218px;background:var(--surface);border-right:1px solid var(--border);
  overflow-y:auto;padding:14px 10px 30px;}
nav#nav .navttl{font-size:10.5px;font-weight:700;color:var(--text-muted);letter-spacing:.4px;padding:6px 10px;}
nav#nav a{display:flex;align-items:center;gap:9px;padding:9px 12px;border-radius:8px;text-decoration:none;
  color:var(--text);font-size:13.5px;margin-bottom:2px;cursor:pointer;min-height:40px;}
nav#nav a:hover{background:var(--accent-soft);color:var(--accent);}
nav#nav a.on{background:#ec4899;color:#fff;font-weight:700;}
nav#nav a:hover:not(.on){background:#fce7f3;color:#be185d;}
nav#nav a .ic{flex:none;width:20px;text-align:center;}
nav#nav a.navUnion{display:flex;align-items:center;gap:4px;padding:10px 10px;border-radius:6px;font-size:12px;font-weight:700;color:var(--text-muted);letter-spacing:.4px;cursor:pointer;}
nav#nav a.navUnion:hover:not(.on){background:#fce7f3;color:#be185d;}
nav#nav a.navUnion.on{background:#ec4899;color:#fff;}
nav#nav a.navUnion .navUnionArr{font-size:13px;line-height:1;}

main#content{flex:1 1 auto;min-width:0;overflow-y:auto;padding:22px 26px 60px;}
.scrim{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:350;}

h2.pgttl{margin:0 0 3px;font-size:19px;letter-spacing:-.01em;}
h2.pgttl{display:none !important;} /* 화면 맨 위 제목 글자(출퇴근 입력·근태관리·월별 OT현황·배차표 등) 숨김 — 메뉴에서 어느 화면인지 보임, 표를 한 화면에 더 넓게 */
p.pgsub{margin:0 0 18px;color:var(--text-muted);font-size:12.5px;}

.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:22px;}
.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:14px 16px;}
.card .n{font-size:24px;font-weight:700;letter-spacing:-.02em;}
.card .l{font-size:11.5px;color:var(--text-muted);margin-top:2px;}

.panel{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:18px;}
.panel h3{margin:0 0 12px;font-size:14px;}

.row{display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;}
.field{display:flex;flex-direction:column;gap:4px;min-width:120px;}
.field label{font-size:11.5px;color:var(--text-muted);}
.field input,.field select,.field textarea{border:1px solid var(--border);border-radius:8px;padding:8px 10px;
  font-size:13.5px;background:var(--bg);color:var(--text);font-family:inherit;}
.field textarea{min-height:56px;resize:vertical;}
.field.grow{flex:1 1 200px;}

/* 버튼: 모두 분홍색 */
:root{ --btn:#ec4899; --btn-dark:#db2777; --btn-soft:#fdf2f8; --btn-line:#f9a8d4; }
.btn{border:1px solid var(--btn);background:var(--btn);color:#fff;border-radius:8px;padding:9px 16px;
  font-size:13px;font-weight:700;cursor:pointer;}
.btn:hover:not(:disabled){background:var(--btn-dark);border-color:var(--btn-dark);}
.btn.ghost{background:var(--surface);color:var(--btn-dark);border-color:var(--btn-line);}
.btn.ghost:hover:not(:disabled){background:var(--btn-soft);color:var(--btn-dark);border-color:var(--btn);}
.btn.warn{background:var(--btn);border-color:var(--btn);}
.btn.warn.ghost{background:var(--surface);color:var(--btn-dark);border-color:var(--btn-line);}
.btn.sm{padding:5px 10px;font-size:11.5px;border-radius:6px;}
.btn:disabled{opacity:.5;cursor:not-allowed;}
.gridCodeOpt:hover{background:var(--bg);}
/* 순번 배지: 그룹별 색 + 순위가 높을수록 진하게 */
.g-sup{--g:var(--sup);--g-soft:var(--sup-soft);} .g-hol{--g:var(--hol);--g-soft:var(--hol-soft);} .g-wk{--g:var(--wk);--g-soft:var(--wk-soft);} .g-ot{--g:var(--ot);--g-soft:var(--ot-soft);} .ctbl th.cntHead{font-weight:800;font-size:12px;color:#111827 !important;background:#ffffff !important;white-space:nowrap;}
/* 급여관리·급여명세서 */
.payName{cursor:pointer;text-decoration:underline dotted;text-underline-offset:3px;}
.payTbl input{width:100%;min-width:90px;padding:6px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);font:inherit;text-align:right;box-sizing:border-box;}
.inCloseBtn.on{background:#111 !important;border-color:#111 !important;color:#fff !important;}
#dpTable td.dpWhoCell{cursor:pointer;}
#dpTable td.dpWhoCell:hover{text-decoration:underline;}
#dpTable td.dpWhoCell input:disabled{pointer-events:none;}
.inLeadBtns{display:inline-flex;gap:8px;flex-wrap:nowrap;align-items:center;}
.inLockMsg{font-size:13px;font-weight:700;color:#b91c1c;margin-left:6px;}
.inTbl.inLocked td{background:#f8fafc;}
.pwCell{display:flex;align-items:center;gap:6px;justify-content:center;white-space:nowrap;}
.pwSt{font-size:12px;font-weight:700;color:var(--text-muted);}
.pwSt.on{color:#047857;}
.pwHdrBtn{background:#fff !important;color:#be185d !important;border:1px solid #f9a8d4 !important;}
@media (max-width:700px){ .acctPwBtn .acctLbl{display:none;} } /* 휴대폰: 조장 로그인 비번 단추는 🔑만 */
.pwDlg{max-width:360px;width:92%;}
.pwDlg .pwLbl{display:block;font-size:12px;font-weight:700;color:#475569;margin:10px 0 4px;text-align:left;}
.pwDlg .pwIn{font-size:16px;}
.pwRst{white-space:nowrap;padding:4px 8px !important;font-size:11px !important;}
.pwIn{width:100%;border:1px solid var(--border);border-radius:8px;padding:9px 10px;background:var(--bg);color:var(--text);font:inherit;font-size:15px;box-sizing:border-box;}
.pwMsg{min-height:20px;margin:0 0 10px;color:#dc2626;font-weight:700;font-size:13px;}
.pwMsg.ok{color:#047857;}
.leaveBox{display:flex;align-items:center;gap:4px;justify-content:center;white-space:nowrap;}
.leaveBox .yrs{font-size:11px;color:var(--text-muted);min-width:26px;text-align:right;}
.payTbl .leaveBox input{width:46px !important;min-width:46px !important;max-width:46px;padding:5px 2px !important;}
.leaveBox input{width:44px;text-align:center;font-weight:800;border:1px solid var(--border);border-radius:6px;padding:5px 2px;background:var(--bg);color:var(--text);font:inherit;font-weight:800;}
.leaveBox input::placeholder{color:var(--text);opacity:.85;font-weight:800;}
.payTbl input.tx{text-align:left;min-width:64px;}
.rateTbl input.rateIn{width:110px;text-align:right;padding:6px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);font:inherit;}
.rateTbl td{padding:3px 4px;}
.payTbl select.tx{width:100%;min-width:80px;padding:6px 8px;border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--text);font:inherit;}
.payTbl input[type=date]{min-width:140px;}
.payTbl input.dt{min-width:90px;text-align:center;letter-spacing:.5px;}
.wonBox{position:relative;}
.wonBox input{padding-right:24px !important;min-width:94px;}
.tenureBox input{background:var(--bg-soft, rgba(0,0,0,.04)) !important;cursor:default;padding-left:30px !important;min-width:104px !important;}
.tenureBox .yrs{left:9px;right:auto !important;font-size:11px;}
.wonBox span{position:absolute;right:9px;top:50%;transform:translateY(-50%);font-size:13px;color:var(--text-muted,#6b7280);pointer-events:none;}
.payScrim{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:600;display:flex;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  padding:calc(14px + env(safe-area-inset-top,0px)) 8px calc(14px + env(safe-area-inset-bottom,0px));}
.pwBox{margin:auto;background:#fff;color:#222;border-radius:8px;padding:22px 22px 18px;width:100%;max-width:400px;box-shadow:0 10px 30px rgba(0,0,0,.25);}
.pwBox h3{margin:0 0 12px;font-size:21px;color:#222;}
.pwBox p{margin:0 0 14px;font-size:14px;line-height:1.5;color:#333;}
.pwBox input{width:100%;box-sizing:border-box;padding:9px 10px;border:2px solid #888;border-radius:3px;font-size:15px;background:#fff;color:#111;}
.pwBox .pwErr{color:#dc2626;font-size:13px;margin-top:6px;min-height:18px;}
.pwBtns{display:flex;gap:10px;margin-top:8px;}
.pwBtns button{flex:1;border:0;border-radius:3px;padding:10px;font-size:15px;font-weight:700;cursor:pointer;}
.pwOk{background:#0f6cbd;color:#fff;} .pwOk:disabled{background:#b3d4f0;cursor:default;}
.pwNo{background:#ececec;color:#222;}
.slipBox{margin:auto;margin-top:44px;background:#fff;color:#111;width:100%;max-width:820px;padding:18px 16px 16px;border-radius:6px;box-shadow:0 10px 30px rgba(0,0,0,.25);font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif;}
.slipTop{display:flex;justify-content:flex-end;gap:8px;margin-bottom:6px;}
/* 닫기 버튼: 화면 오른쪽 위에 고정 — 휴대폰에서 명세서가 커도 잘리지 않음 */
.slipClose{position:fixed;top:calc(10px + env(safe-area-inset-top,0px));right:calc(12px + env(safe-area-inset-right,0px));z-index:610;
  border:1px solid #f9a8d4;background:#fff;color:#be185d;border-radius:999px;padding:7px 14px;font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.18);}
.slipTop button{border:1px solid #ccc;background:#fff;border-radius:6px;padding:5px 12px;font-size:13px;cursor:pointer;color:#111;}
.slipTitle{text-align:center;font-size:24px;font-weight:800;letter-spacing:1px;margin:2px 0 10px;}
.slipInfo{width:90%;margin:0 auto 18px;border-collapse:collapse;font-size:13px;}
.slipInfo td{padding:6px 4px;border-bottom:1px solid #333;}
.slipInfo tr:first-child td{border-top:2px solid #333;}
.slipInfo b{font-weight:800;}
.slipDates{display:flex;justify-content:space-between;font-size:12px;margin:0 2px 4px;}
.slipWrap{overflow-x:auto;}
.slipTbl{width:100%;min-width:640px;border-collapse:collapse;table-layout:fixed;font-size:12.5px;}
.slipTbl td{border:1px solid #444;height:26px;padding:2px 6px;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.slipTbl td.h{background:#fce7f3;text-align:center;font-weight:800;white-space:normal;font-size:11.5px;line-height:1.2;letter-spacing:-0.3px;}
.slipTbl td.sec{background:#fce7f3;text-align:center;font-weight:800;vertical-align:top;}
.slipTbl tr.alt td:not(.sec){background:#fdf2f8;}
.slipTbl .bt td{border-top:2px solid #222;}
@media (max-width:600px){
  /* 휴대폰: 명세서 표가 화면 폭 안에 다 들어오게(옆으로 밀 필요 없음) */
  .slipBox{padding:12px 8px 10px;}
  .slipTitle{font-size:19px;margin:2px 0 8px;}
  .slipInfo{width:100%;font-size:12px;}
  .slipDates{font-size:11px;}
  .slipTbl{min-width:0;font-size:9.5px;}
  .slipTbl td{height:22px;padding:1px 2px;}
  .slipTbl td.h{font-size:8.5px;letter-spacing:-.5px;}
  .slipTbl colgroup col:first-child{width:9% !important;}
}
@media print{ body:not(.printing-acc) *{visibility:hidden;} body:not(.printing-acc) .slipBox, body:not(.printing-acc) .slipBox *{visibility:visible;} .slipBox{position:absolute;left:0;top:0;box-shadow:none;max-width:none;} .slipTop{display:none;} }

.g-meal{--g:#0e7490;--g-soft:#cffafe;--g-strong:#22d3ee;--g-on:#083344;} /* 식사(청록) */
/* 관리감독자 일지 */
.svPages{display:flex;flex-direction:column;gap:18px;align-items:center;}
.svCol{width:100%;max-width:820px;}
@media (min-width:701px){
  .svCol .svPage{height:1159px;overflow:hidden;}
  /* PC: A4 네 장을 2×2로 — 위: 직무수행 일지·계획서 1쪽 / 아래: 계획서 2쪽·참석자 명단 (화면 가로에 맞춤) */
  .svPages{display:grid;grid-template-columns:820px 820px;gap:14px;align-items:start;justify-content:start;width:max-content;}
  .svCol{flex:0 0 auto;width:820px;max-width:none;}
  .svCol .svPage{width:820px;max-width:none;}
  #svLog{height:1159px;box-sizing:border-box;overflow:hidden;}
  .svCol .docLabel{height:30px;font-size:22px;}
}
.svPage{background:#fff;color:#111;width:100%;max-width:820px;box-shadow:0 2px 12px rgba(0,0,0,.12);border-radius:4px;font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif;}
#svLog{padding:22px 24px 18px;}
.svImgPage img{display:block;width:100%;height:auto;}
/* 네 장 공통 틀 */
.svFramed{display:flex;flex-direction:column;padding:22px 24px 16px !important;box-sizing:border-box;}
.svHdr{display:flex;justify-content:space-between;align-items:flex-start;height:86px;flex:0 0 auto;margin-bottom:6px;}
.svHTitle{font-size:24px;font-weight:800;line-height:1.35;padding-top:4px;}
.svHTitle.u{text-decoration:underline;text-underline-offset:5px;}
.svSub{font-size:14px;font-weight:600;color:#555;text-decoration:none;display:inline-block;}
.svSignBox{width:200px;table-layout:fixed;}
.svBody{flex:1;display:flex;flex-direction:column;min-height:0;}
.svGrow{flex:1 1 auto;}
.svFramed .svFoot{flex:0 0 auto;margin-top:8px;}
.svPT{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12.5px;border:2px solid #111;}
.svPT th,.svPT td{border:1px solid #444;height:23px;padding:1px 5px;text-align:center;font-weight:500;}
.svPT th{font-weight:700;}
.svPT td.l{text-align:left;} .svPT td.r{text-align:right;}
.svSec{font-size:14px;font-weight:800;margin:9px 0 3px;}
.svEdu{display:grid;grid-template-columns:1fr 1fr;row-gap:5px;font-size:12.5px;margin:2px 0 0;}
.svBox{border:2px solid #111;padding:5px 8px;font-size:12.5px;line-height:1.7;}
.svCols{display:grid;grid-template-columns:1.25fr 1fr;gap:10px;}
.svNote{margin-top:-2px;border-top:0;line-height:1.6;}
.svTwin{display:flex;gap:4%;} .svTwin .svPT{width:48%;}
.svDiag{display:flex;align-items:center;justify-content:center;padding:6px;}
.svDiag img{max-width:100%;max-height:100%;width:100%;height:auto;object-fit:contain;}
.svIssueWrap{display:flex;flex-direction:column;margin-top:12px;}
.svIssueWrap .svIssueH{margin-top:0;}
.svIssueWrap .svIssue,.svIssueWrap .svIssuePrint{flex:1;min-height:80px;}
.svRWrap{align-items:stretch;}
.svRWrap .svRoster{height:100%;}
/* 네 장 모두 같은 안쪽 여백(위·좌·우 22·24px)으로 맞춤 */
.svImgPage,#svP3{padding:22px 24px 18px;box-sizing:border-box;}
#svP3{position:relative;}
.svRTitle{font-size:24px;font-weight:800;text-decoration:underline;text-underline-offset:5px;margin:6px 0 26px;}
.svRLine{font-size:15px;font-weight:600;margin:0 0 14px;}
.svRWrap{display:flex;gap:7%;margin-top:22px;}
.svRoster{flex:1;border-collapse:collapse;table-layout:fixed;font-size:14px;}
.svRoster th,.svRoster td{border:1px solid #333;height:37px;text-align:center;}
.svRoster th{font-weight:800;}
.svRosterH{font-size:15px;}
.svRName{font-weight:600;}
.svRFoot{position:absolute;right:24px;bottom:18px;margin:0;}
.svHead{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;}
.svTitle{font-size:24px;font-weight:800;line-height:1.35;padding-top:6px;}
.svSignBox{border-collapse:collapse;font-size:13px;}
.svSignBox th,.svSignBox td{border:1px solid #111;text-align:center;font-weight:600;}
.svSignBox tr:first-child th:not([rowspan]){width:78px;height:24px;}
.svSignBox th[rowspan]{width:26px;}
.svSignBox td{height:56px;}
.svLegend{font-size:13px;font-weight:800;margin:4px 0 8px;}
.svTbl{width:100%;border-collapse:collapse;table-layout:fixed;font-size:12px;border:2px solid #111;}
.svTbl th,.svTbl td{border:1px solid #777;padding:2px 4px;vertical-align:middle;}
.svTbl th{font-weight:800;text-align:center;}
.svTbl tr:first-child th{height:34px;}
.svDay{font-size:10.5px;letter-spacing:-.4px;font-weight:700 !important;white-space:nowrap;}
.svChk{padding:0 !important;}
.svGap td{height:8px;border-left:0;border-right:0;}
.svG{font-size:14px;line-height:1.6;}
.svC{text-align:center;}
.svP{line-height:1.35;height:26px;}
.svInj{margin-top:4px;white-space:nowrap;}
.svIn{width:100%;border:0;background:transparent;font:inherit;color:#111;text-align:center;padding:4px 2px;outline:none;}
.svInj .svIn{width:60%;text-align:left;border-bottom:1px solid #333;}
.svIn:focus,.svIssue:focus{background:#fff7d6;}
.svM{text-align:center;font-size:15px;font-weight:800;cursor:pointer;user-select:none;}
.svM:hover{background:#fff7d6;}
.svM.mid{color:#b45309;}
.svActIn{text-align:left !important;font-size:12px;padding:2px 4px !important;}
.svVsl{cursor:pointer;} .svVsl:hover{background:#fff7d6;}
.svDate{padding:6px 8px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font:inherit;}
.svCtl{flex-wrap:wrap;gap:6px;} .svM.bad{color:#dc2626;}
.svGrpTop > *{border-top:1.5px solid #111 !important;}
.svIssueH{border:2px solid #111;border-bottom:0;margin-top:14px;text-align:center;font-weight:800;padding:6px;font-size:14px;}
.svIssue,.svIssuePrint{display:block;width:100%;box-sizing:border-box;border:2px solid #111;min-height:120px;font:inherit;font-size:13px;padding:8px;resize:vertical;outline:none;white-space:pre-wrap;}
.svIssuePrint{display:none;}
.svFoot{text-align:right;font-weight:800;margin-top:10px;font-size:13px;}
@media (max-width:700px){
  /* 휴대폰: PC와 똑같은 A4 모양을 그대로 두고 화면 폭에 맞춰 축소(fitSafety) */
  .svPages{align-items:flex-start;}
  .svCol{width:820px;max-width:none;}
  .svCol .svPage{width:820px;max-width:none;}
}
@media print{
  body.printing-sv *{visibility:hidden !important;}
  html,body.printing-sv,body.printing-sv .layout,body.printing-sv main{background:#fff !important;}
  body.printing-sv .layout > nav, body.printing-sv header.app{display:none !important;}
  body.printing-sv main#content{padding:0 !important;margin:0 !important;}
  body.printing-sv #content > *:not(.svPages){display:none !important;}
  body.printing-sv .svPages{display:block !important;zoom:1 !important;}
  body.printing-sv .svPage{display:none !important;}
  body.printing-sv .svPage.svOn{display:block !important;max-width:none;width:100%;box-shadow:none;border-radius:0;break-after:page;page-break-after:always;}
  body.printing-sv .svPage.svOn:last-of-type{break-after:auto;page-break-after:auto;}
  body.printing-sv .svPage.svOn, body.printing-sv .svPage.svOn *{visibility:visible !important;}
  body.printing-sv #svLog.svOn{padding:0;}
  body.printing-sv .svImgPage.svOn img{width:100%;max-height:277mm;object-fit:contain;}
  body.printing-sv .svIssue{display:none !important;}
  body.printing-sv .svIssuePrint{display:block !important;min-height:150px;}
  body.printing-sv .svM:hover{background:transparent;}
}

/* 사고&학자금: 두 서류를 한 화면에(넓으면 나란히, 좁으면 위아래) */
.docGrid{display:flex;flex-wrap:wrap;gap:18px;align-items:flex-start;}
.docGrid > .accWrap{flex:1 1 560px;min-width:0;}
@media (min-width:701px){ .docGrid{flex-wrap:nowrap;} .docGrid > .accWrap{flex:0 0 auto;width:var(--docW,780px);overflow:visible;} .docGrid .accSheet{width:var(--docW,780px);max-width:none;} }
.docLabel{font-weight:800;margin:0 0 6px 2px;}
label.chk{display:inline-flex;align-items:center;gap:5px;font-weight:700;cursor:pointer;}
.hakSheet{padding-top:28px;}
.hakTitle{text-align:center;font-size:24px;font-weight:800;letter-spacing:6px;margin:6px 0 22px;}
.hakTbl th{background:transparent;}
.hakTbl td{text-align:center;}
.hakTbl .accIn{text-align:center;font-weight:700;}
.hakTbl .hakKindRow th,.hakTbl .hakKindRow td{height:48px;}
.hakKinds{display:grid;grid-template-columns:1fr 1fr;gap:2px 8px;justify-items:start;padding:2px 4px;font-size:13px;}
.hakKind{display:inline-flex;align-items:center;gap:3px;cursor:pointer;white-space:nowrap;}
.hakKind input{position:absolute;opacity:0;width:1px;height:1px;}
.hakKind i{font-style:normal;font-size:14px;}
.hakTbl .hakNoteRow th,.hakTbl .hakNoteRow td{height:40px;}
.hakAmtH,.hakAmt{background:#fefce8;border:2px solid #111 !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.hakTbl .hakGap td{height:28px;}
.hakTbl .hakBig td{height:520px;}
@media print{ body.printing-acc .hakTbl .hakBig td{height:560px !important;} body.printing-acc .hakTbl tr:not(.hakBig):not(.hakGap):not(.hakKindRow):not(.hakNoteRow) > *{height:34px !important;} }
/* 경위서·학자금 공통 틀: A4 비율 한 장, 맨 위(내,외부 겸용)·제목 높이·아래 끝선·꼬리말 위치를 두 장이 똑같이 */
.docFramed{display:flex;flex-direction:column;aspect-ratio:1 / 1.4142;box-sizing:border-box;padding:18px 22px 14px !important;}
.docFramed .accTop{flex:0 0 auto;height:16px;margin:0 0 3px;}
.docGrow{flex:1 1 auto;min-height:0;}
.docFoot{flex:0 0 auto;text-align:right;font-weight:800;font-size:13px;margin-top:8px;}
.accTblTop{border-bottom:0;}
.accStory{display:flex;border-left:2px solid #111;border-right:2px solid #111;}
.accTa.accTaGrow,.accTaPrint.accTaGrow{flex:1;height:auto;min-height:0;resize:none;overflow:auto;}
.accTblBot{border-top:1px solid #9a9a9a;}
.hakSheet .hakTitle{height:96px;margin:0;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}
/* 경위서 제목도 학자금처럼 테두리 없이, 같은 높이(96px) */
.accTitleBox{position:relative;height:96px;flex:0 0 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;}
@media (min-width:701px){ .docFramed{aspect-ratio:auto;height:var(--docH,1103px);} }
.hakBigBox{border:2px solid #111;border-top:1px solid #777;}
/* 사고경위서 */
.accWrap{overflow-x:auto;padding-bottom:8px;}
.accSheet{background:#fff;color:#111;width:100%;max-width:780px;min-width:560px;margin:0 auto;padding:18px 22px 26px;box-shadow:0 2px 12px rgba(0,0,0,.12);border-radius:4px;font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif;}
.accTop{text-align:right;font-size:11px;margin-bottom:3px;}
.accTbl{width:100%;border-collapse:collapse;table-layout:fixed;border:2px solid #111;}
.accTbl th,.accTbl td{border:1px solid #9a9a9a;padding:0 6px;font-size:13px;height:34px;vertical-align:middle;}
.accTbl th{font-weight:800;text-align:center;white-space:nowrap;}
.accTitleRow td{height:96px;position:relative;text-align:center;border-bottom:2px solid #111;}
.accLogo{position:absolute;left:12px;top:50%;transform:translateY(-50%);height:auto;width:21%;max-width:160px;}
.accTitle{font-size:30px;font-weight:800;letter-spacing:8px;}
.accSub{font-size:15px;font-weight:800;margin-top:2px;}
.accInfo td{text-align:center;}
.accHead th{background:#d9d9d9;border-bottom:3px double #111;height:30px;letter-spacing:2px;}
.accGap td{height:12px;border-left:0;border-right:0;}
.accLine th{text-align:left;padding-left:8px;}
.accLine td{border-left:0;}
.accLine th[colspan="2"]{border-right:0;}
.accIn{width:100%;border:0;background:transparent;font:inherit;font-size:14px;color:#111;padding:4px 2px;outline:none;}
.accInfo .accIn{text-align:center;font-weight:700;}
.accIn:focus,.accTa:focus{background:#fff7d6;}
.accBox td{padding:0;}
.accTa,.accTaPrint{display:block;width:100%;box-sizing:border-box;border:0;resize:vertical;font:inherit;font-size:14px;color:#111;padding:0 10px;
  line-height:34px;height:calc(34px * var(--lines));min-height:calc(34px * var(--lines));background:transparent;outline:none;white-space:pre-wrap;word-break:break-all;
  background-image:repeating-linear-gradient(to bottom, transparent 0, transparent 33px, #9a9a9a 33px, #9a9a9a 34px);background-attachment:local;}
.accTaPrint{display:none;overflow:hidden;resize:none;}
.accOath{font-size:13px;font-weight:800;margin:18px 2px 10px;}
.accSign{display:flex;flex-direction:column;align-items:flex-end;gap:6px;margin-top:14px;}
.accSign > div{display:flex;align-items:center;width:62%;font-size:15px;font-weight:800;}
.accSign .k{width:110px;text-align:right;padding-right:8px;white-space:nowrap;}
.accSign .accIn{flex:1;font-weight:700;border-bottom:1px solid #ccc;}
.accSign .s{width:42px;text-align:right;}
@media (max-width:700px){
  /* 휴대폰: 서류 모양 그대로(780px) 두고 화면 폭에 맞춰 축소(fitDocs) */
  .docGrid{flex-direction:column;flex-wrap:nowrap;}
  .docGrid > .accWrap{flex:0 0 auto;width:780px;overflow:visible;padding-bottom:0;}
  .docGrid .accSheet{width:780px;max-width:none;min-width:0;}
}
@media print{
  @page{size:A4 portrait;margin:10mm 10mm 12mm;}
  body.printing-acc *{visibility:hidden !important;}
  body.printing-acc.pr-acc #accSheet, body.printing-acc.pr-acc #accSheet *,
  body.printing-acc.pr-hak #hakSheet, body.printing-acc.pr-hak #hakSheet *{visibility:visible !important;}
  body.printing-acc .docGrid{display:block !important;zoom:1 !important;}
  body.printing-acc .docGrid > .accWrap{width:auto !important;}
  body.printing-acc .docGrid .accSheet{width:100% !important;}
  body.printing-acc .docLabel{display:none !important;}
  body.printing-acc .accWrap{overflow:visible !important;padding:0 !important;}
  body.printing-acc:not(.pr-acc) #accSheet, body.printing-acc:not(.pr-hak) #hakSheet{display:none !important;}
  body.printing-acc .layout > nav, body.printing-acc header.app{display:none !important;}
  body.printing-acc main#content{padding:0 !important;margin:0 !important;}
  body.printing-acc #content > *:not(.docGrid){display:none !important;}
  body.printing-acc #accSheet, body.printing-acc #hakSheet{width:100%;max-width:none;min-width:0;margin:0;padding:0;box-shadow:none;border-radius:0;}
  body.printing-acc.pr-acc.pr-hak #hakSheet{break-before:page;page-break-before:always;}
  body.printing-acc .accTa{display:none !important;}
  body.printing-acc .accTaPrint{display:block !important;}
  body.printing-acc .accIn{border-bottom-color:transparent !important;background:transparent !important;}
  body.printing-acc .accIn::placeholder{color:transparent;}
  body.printing-acc .accHead th{-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  html,body.printing-acc,body.printing-acc .layout,body.printing-acc main{background:#fff !important;}
  body.printing-acc .accTaPrint{resize:none !important;}
  /* A4 한 장에 다 들어가도록 줄 높이를 조금 줄임 */
  body.printing-acc .accTbl th,body.printing-acc .accTbl td{height:30px;}
  body.printing-acc .accTitleRow td{height:82px;}
  body.printing-acc .accTaPrint{line-height:30px;height:calc(30px * var(--lines));min-height:0;
    background-image:repeating-linear-gradient(to bottom, transparent 0, transparent 29px, #9a9a9a 29px, #9a9a9a 30px);
    -webkit-print-color-adjust:exact;print-color-adjust:exact;}
  body.printing-acc .accOath{margin:12px 2px 6px;}
  body.printing-acc .accSign{margin-top:8px;gap:4px;}
}

.g-ext{--g:#0f766e;--g-soft:#ccfbf1;--g-strong:#2dd4bf;--g-on:#042f2e;}
.g-blk{--g:var(--text);--g-soft:var(--bg);}
/* 근태 집계 순번 칸: 칸 전체를 그룹 색으로, 숫자는 검은색 */
.ctbl td.rkCol{background:var(--g-soft) !important;}
.ctbl td.rkCol .rkPlain{color:#111;font-weight:800;font-size:12px;}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .ctbl td.rkCol .rkPlain{color:#f1f5f9;} } .g-blue{--g:#1d4ed8;--g-soft:#dbeafe;} .g-red{--g:#dc2626;--g-soft:#fee2e2;}
.g-pur{--g:#7c3aed;--g-soft:#f1ecff;--g-strong:#c9b8fb;--g-on:#3b0764;}
.g-yel{--g:#a16207;--g-soft:#fef9c3;--g-strong:#facc15;--g-on:#3f2a00;}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .g-blue{--g:#60a5fa;--g-soft:#0f1f3d;} :root:not([data-theme="light"]) .g-red{--g:#f87171;--g-soft:#3b1113;} :root:not([data-theme="light"]) .g-yel{--g:#fde047;--g-soft:#332a05;} :root:not([data-theme="light"]) .g-pur{--g:#c4b5fd;--g-soft:#2a1a4a;} }
.rk{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:21px;padding:0 6px;border-radius:11px;font-weight:800;font-size:11.5px;line-height:1;}
.rk.t1{background:var(--g-strong,var(--g));color:var(--g-on,#fff);box-shadow:0 0 0 2px var(--g-soft);}
.rk.t2{background:var(--g-soft);color:var(--g);border:1px solid var(--g);}
.rk.t3{color:var(--g);opacity:.75;}
/* 그룹 색으로 칠한 칸 */
td.gc,th.gc{background:var(--g-soft) !important;color:var(--g);}
td.gc b,td.gc strong{color:var(--g);}
th.gh{background:var(--g) !important;color:#fff !important;font-weight:800;}
.gtbl .sepL{border-left:3px solid var(--text) !important;}
/* 근태관리(집계·월별 근태)·월별 OT현황: 바탕은 흰색 그대로, 칸 선을 회색 보통선으로(바깥 검은 테두리는 그대로) */
.ctbl th,.ctbl td,.otSum th,.otSum td{border:1px solid #c4cad3 !important;}
/* 구역 구분선(얇은 검은 선): 머리글 아래 · 성명 오른쪽 · 그룹 사이
   (표 칸 선이 겹치는 방식 때문에 선 양쪽 칸에 같이 그려야 검은색이 확실히 보임) */
.otSum tbody td:not(.gc),.ctbl tbody tr > td:first-child{background:var(--surface);} /* No·식사·일자 칸 흰 바탕 */
.ctbl .sepL,.otSum .sepL{border-left:var(--sepW,1px) solid #111 !important;}
.ctbl td:has(+ .sepL),.ctbl th:has(+ .sepL){border-right:var(--sepW,1px) solid #111 !important;}
.ctbl tbody tr:first-child > td,.otSum tbody tr:first-child > td{border-top:var(--sepW,1px) solid #111 !important;}
.ctbl thead tr:last-child > th,.ctbl thead th[rowspan],.otSum thead tr:last-child > th,.otSum thead th[rowspan]{border-bottom:var(--sepW,1px) solid #111 !important;}
.cmbRight .ctbl th.namehead,.cmbRight .ctbl td.namecell{border-right:var(--sepW,1px) solid #111 !important;}
.cmbRight .ctbl th.namehead + th,.cmbRight .ctbl td.namecell + td{border-left:var(--sepW,1px) solid #111 !important;}
/* 월별 OT현황 구역: 성명|식사|평일|지원|휴일|OT|성명|일자별 */
.otSum tbody td:nth-child(3),.otSum tbody td:nth-child(4),.otSum tbody td:nth-child(5),.otSum tbody td:nth-child(7),
.otSum tbody td:nth-child(9),.otSum tbody td:nth-child(11),.otSum tbody td:nth-child(12),
.otSum thead tr:first-child th:nth-child(n+3),
.otSum thead tr:nth-child(2) th:nth-child(1),.otSum thead tr:nth-child(2) th:nth-child(2),.otSum thead tr:nth-child(2) th:nth-child(3),
.otSum thead tr:nth-child(2) th:nth-child(5),.otSum thead tr:nth-child(2) th:nth-child(7),.otSum thead tr:nth-child(2) th:nth-child(9){border-left:var(--sepW,1px) solid #111 !important;}
.otSum tbody td:nth-child(2),.otSum tbody td:nth-child(3),.otSum tbody td:nth-child(4),.otSum tbody td:nth-child(6),
.otSum tbody td:nth-child(8),.otSum tbody td:nth-child(10),.otSum tbody td:nth-child(11),
.otSum thead tr:first-child th:nth-child(n+2):not(:last-child),
.otSum thead tr:nth-child(2) th:nth-child(1),.otSum thead tr:nth-child(2) th:nth-child(2),.otSum thead tr:nth-child(2) th:nth-child(4),
.otSum thead tr:nth-child(2) th:nth-child(6),.otSum thead tr:nth-child(2) th:nth-child(8){border-right:var(--sepW,1px) solid #111 !important;}
.ctbl tbody tr:first-child > td,.otSum tbody tr:first-child > td{border-top:var(--sepW,1px) solid #111 !important;}
.cmbRight .ctbl th.namehead,.cmbRight .ctbl td.namecell{border-right:var(--sepW,1px) solid #111 !important;}
/* 월별 OT현황 구역: 성명|식사|평일|지원|휴일|OT|성명|일자별 */
.otSum tbody td:nth-child(3),.otSum tbody td:nth-child(4),.otSum tbody td:nth-child(5),.otSum tbody td:nth-child(7),
.otSum tbody td:nth-child(9),.otSum tbody td:nth-child(11),.otSum tbody td:nth-child(12),
.otSum thead tr:first-child th:nth-child(n+3),
.otSum thead tr:nth-child(2) th:nth-child(1),.otSum thead tr:nth-child(2) th:nth-child(2),.otSum thead tr:nth-child(2) th:nth-child(3),
.otSum thead tr:nth-child(2) th:nth-child(5),.otSum thead tr:nth-child(2) th:nth-child(7),.otSum thead tr:nth-child(2) th:nth-child(9){border-left:var(--sepW,1px) solid #111 !important;}
/* 급여 지급명세서 */
.psWrap{overflow-x:auto;padding-bottom:10px;}
.psSheet{background:#fff;color:#111;max-width:780px;min-width:680px;margin:0;padding:22px 24px 18px;border-radius:8px;border:1px solid var(--border);font-size:12.5px;position:relative;}
.psTools{position:absolute;right:14px;top:12px;display:flex;gap:6px;}
.psTitle{text-align:center;font-size:20px;letter-spacing:.02em;margin:6px 0 14px;} .psTitle span{margin-left:14px;}
.psHead{width:88%;margin:0 auto 10px;border-collapse:collapse;border-top:1px solid #333;border-bottom:1px solid #333;} .psHead td{padding:7px 8px;}
.psMeta{display:flex;justify-content:space-between;font-size:11.5px;margin:10px 0 4px;color:#333;}
.psT{width:100%;border-collapse:collapse;table-layout:fixed;} .psT td{border:1px solid #9aa0a6;height:24px;padding:2px 6px;}
.psT td.psSec{background:#dcdcdc;text-align:center;font-weight:700;width:13%;vertical-align:top;padding-top:5px;}
.psT td.psL{background:#dcdcdc;text-align:center;font-weight:700;font-size:11px;letter-spacing:-.03em;white-space:nowrap;overflow:hidden;}
.psT td.psV{text-align:right;background:#fff;} .psT td.psA{background:#f3f7ff;} .psT td.psTot{font-weight:700;}
.psNameIn{width:120px;border:0;border-bottom:1px solid #999;background:#fffde8;font:inherit;padding:2px 4px;color:#111;} .psNameIn:focus{outline:2px solid #1d4ed8;}
.psIn{width:100%;border:0;background:#fffde8;text-align:right;font:inherit;padding:2px 0;color:#111;} .psIn:focus{outline:2px solid #1d4ed8;}
@media print{ body.printing-ps > *:not(.layout){display:none !important;} body.printing-ps .layout > *:not(main){display:none !important;}
  body.printing-ps main#content > *:not(.psWrap){display:none !important;} body.printing-ps .psSheet{border:0;}
  body.printing-ps .psTools{display:none;} body.printing-ps .psIn{background:none;} body.printing-ps .psT td.psA{background:none;} }
.gtbl td.stNo{position:sticky;left:0;z-index:2;background:var(--surface);min-width:34px;width:34px;}
/* 옆으로 밀 때 고정된 No·성명 칸 왼쪽 1px 틈으로 뒤 칸이 비치지 않게 1px 당겨 붙임 */
.gtbl td.stNo,.gtbl thead tr:first-child > th.namehead:first-child{left:-1px !important;}
.gtbl thead th.namehead{box-shadow:2px 0 0 var(--bg), -2px 0 0 var(--bg);}
.gtbl td.stNo{box-shadow:2px 0 0 var(--surface);}
.gtbl td.namecell.stName,.gtbl th.namehead[style*="left:34px"]{left:33px !important;}
/* 가운데 반복 성명 칸은 고정하지 않음(왼쪽 No·성명만 고정) */
.gtbl td.namecell.noStick{position:static !important;}
.gtbl th.namehead.noStick{position:sticky;left:auto !important;top:0;}
.gtbl td.namecell.stName{position:sticky;left:33px !important;z-index:3;background:var(--surface);}
/* 휴대폰에서 옆으로 밀 때 고정 칸 경계로 뒤 칸이 비치지 않도록, 고정 칸 둘레를 선 색으로 한 번 더 덮음 */
.gtbl td.stNo,.gtbl td.namecell.stName,.gtbl th.namehead:not(.noStick){outline:0;}
/* 고정 칸(No·성명): 옆으로 밀어도 칸 선이 일정하게 보이도록 선을 칸 안쪽에 그림 */
.gtbl td.stNo{box-shadow:none;}
.gtbl td.namecell.stName{box-shadow:none;}
/* 월별 OT현황 고정 칸(No·성명): 옆으로 밀어도 선이 한 줄로 일정하게 — 칸의 원래 선은 숨기고 같은 선을 안쪽에 한 번만 그림 */
.otSum td.stNo,.otSum td.namecell.stName,.otSum thead th.namehead:not(.noStick){border-right-style:hidden !important;border-bottom-style:hidden !important;}
.otSum td.namecell.stName,.otSum thead th.namehead:not(.noStick)+th.namehead:not(.noStick){border-left-style:hidden !important;}
.otSum td.stNo{box-shadow:inset -1px 0 0 #c4cad3, inset 0 -1px 0 #c4cad3 !important;}
.otSum td.namecell.stName{box-shadow:inset -1px 0 0 #111, inset 0 -1px 0 #c4cad3, 1px 0 0 #111 !important;}
.otSum thead th.namehead:not(.noStick){box-shadow:inset -1px 0 0 #c4cad3, inset 0 -1px 0 #111, 0 0 0 0 transparent !important;}
.otSum thead th.namehead:not(.noStick)+th.namehead:not(.noStick){box-shadow:inset -1px 0 0 #111, inset 0 -1px 0 #111, 1px 0 0 #111, 4px 0 0 var(--bg) !important;}
.otSum tbody tr:first-child td.stNo,.otSum tbody tr:first-child td.namecell.stName{border-top:1px solid #111 !important;}
/* 성명: 가운데 정렬, 글자 수(3·4자)와 상관없이 같은 폭·같은 높이 */
.otSum td.namecell.noStick,.otSum thead th.namehead.noStick{border-left-style:hidden !important;box-shadow:inset calc(var(--sepW,1px)*3) 0 0 #111 !important;} /* OT 보전 | 성명 경계: 굵은 검은 선 — 고정 머리글은 테두리가 안 칠해져 빈틈이 생기므로 칸 안쪽에 칠함 */
.otSum thead th.namehead.noStick{box-shadow:inset calc(var(--sepW,1px)*3) 0 0 #111 !important;} /* 머리글 칸은 위에 붙어 있어(sticky) 테두리가 안 그려짐 → 안쪽 그림자로 같은 굵은 선 */
.otSum td.namecell{text-align:center !important;white-space:nowrap;padding:4px 6px !important;min-width:64px;vertical-align:middle;}
.otSum td.payName{text-decoration:none;}
.otSum td.payName span.pn{text-decoration:underline dotted;text-underline-offset:3px;}
.cmbLeft .scrollx{max-width:100%;}
@media (max-width:860px){ .cmbLeft{flex:1 1 100%;min-width:0;} .cmbLeft .scrollx{display:block !important;overflow-x:auto;} }
.dayHead{cursor:pointer;} @media (hover:hover){ .dayHead:hover{outline:2px solid var(--accent);outline-offset:-2px;} }
.cellMemo{display:block;font-size:8px;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:clip;max-width:28px;margin:0 auto;}
.inTbl td{padding:0 !important;height:34px;} .inTbl td.inName{padding:0 8px !important;white-space:nowrap;}
.inTbl .inCell:focus{outline:2px solid #16a34a;outline-offset:-2px;background:#f0fdf4 !important;}
.inTbl .inChk:focus-visible{outline:2px solid #16a34a;outline-offset:2px;}
.inTbl .inCell{width:58px;height:32px;border:0;background:transparent;text-align:center;font:inherit;font-size:13px;color:var(--text);}
.inTbl .inCell:focus{outline:2px solid var(--accent);outline-offset:-2px;background:#fffde8;} .inTbl .inCell.bad{background:#fee2e2;color:#b91c1c;}
.inTbl td.inRO{text-align:center;color:var(--text-muted);min-width:52px;padding:0 6px !important;} .inTbl td.inTot{font-weight:800;color:var(--accent);}
.inTbl tr.inDirty td{background:#fff7ed;} .inTbl input[type=checkbox]{width:17px;height:17px;}
.bcWrap{overflow-x:auto;border:1px solid var(--border);border-radius:10px;}
.bcChart{display:grid;grid-template-columns:70px 1fr;min-width:1100px;}
.bcHeadL{background:#db2777;}
.bcHead .bcDates{display:grid;background:#db2777;color:#fff;font-weight:800;font-size:12px;} .bcHead .bcDates>div{padding:7px 0;text-align:center;border-left:1px solid rgba(255,255,255,.35);}
.bcHead .bcTimes{display:grid;background:#fce7f3;color:#9d174d;font-size:11px;font-weight:700;} .bcTime{padding:3px 4px;}
.bcBerths>div{display:flex;align-items:center;justify-content:center;background:#db2777;color:#fff;font-weight:800;border-top:1px solid rgba(255,255,255,.4);box-sizing:border-box;}
.bcBody{position:relative;background:#fafafa;overflow:hidden;}
.bcGrid{position:absolute;inset:0;display:grid;} .bcCol{border-left:1px solid #eceff3;} .bcCol.day{border-left:1px solid #d6dbe2;}
.bcRowLine{position:absolute;left:0;right:0;border-top:1px solid #d6dbe2;}
.bcBlock{position:absolute;border-radius:4px;box-shadow:0 1px 3px rgba(0,0,0,.25);font-size:11px;display:flex;flex-direction:column;cursor:pointer;overflow:hidden;box-sizing:border-box;padding:3px 2px;}
.bcBlock:hover{outline:3px solid #db2777;z-index:5;}
.bcNums{display:flex;justify-content:space-between;font-size:10.5px;opacity:.9;}
.bcMid{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;text-align:center;} .bcRoute{font-weight:800;} .bcCode{font-size:10.5px;word-break:break-all;}
.bcBottom{text-align:center;font-size:10.5px;}
.bcInfo{background:#fff;border-radius:10px;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,.18);}
.bcInfoHead{position:relative;background:#fce7f3;color:#dc2626;font-weight:800;text-align:center;padding:9px 34px;font-size:14px;}
.bcX{position:absolute;right:8px;top:6px;border:0;background:transparent;color:#dc2626;font-size:16px;font-weight:800;cursor:pointer;}
.bcInfo table{width:100%;border-collapse:collapse;font-size:12.5px;color:#111;}
.bcInfo td{padding:6px 10px;border-bottom:1px solid #f3e4ec;}
.bcK{color:#6b7280;width:46%;} .bcK.pt{color:#dc2626;font-weight:800;} .bcV{font-weight:800;}
.bcRemark{text-align:center;font-weight:800;}
.bcQc th{background:#fce7f3;color:#dc2626;font-weight:800;padding:7px 6px;font-size:12.5px;}
.bcQc td{text-align:center;font-weight:800;padding:6px;} .bcQcIc{margin-right:6px;}
/* 근태관리 보정값 팝업: 현재값 + 보정값 ± 입력값 = 합계 */
.apGrid{display:grid;grid-template-columns:1fr auto 1fr auto minmax(64px,1.4fr) auto 1fr;column-gap:8px;row-gap:4px;align-items:center;}
.apGrid label{font-size:12px;color:var(--muted,#6b7280);white-space:nowrap;}
.apNum{font-weight:800;white-space:nowrap;}
.apOp{font-weight:800;text-align:center;}
.apGrid input{width:100%;min-width:0;height:34px;margin:0;box-sizing:border-box;}
.apSign{width:30px;height:30px;border-radius:8px;border:1px solid var(--border);background:var(--bg);color:var(--accent);font-size:17px;font-weight:800;cursor:pointer;padding:0;line-height:1;}
/* 선석 팝업: 휴대폰에서 화면보다 길면 잘리지 않고 위아래로 스크롤 */
.bcScrim{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:500;display:flex;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain;
  padding:calc(14px + env(safe-area-inset-top,0px)) 10px calc(14px + env(safe-area-inset-bottom,0px));}
.bcPopBox{max-width:440px;width:100%;margin:auto;}
@media (max-width:480px){
  .bcInfo table{font-size:12px;} .bcInfo td{padding:5px 8px;}
  .bcQc th{font-size:11.5px;padding:6px 3px;} .bcQc td{font-size:11px;padding:5px 3px;white-space:nowrap;} .bcQcIc{margin-right:3px;}
}
.vslCard{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px 16px 18px;margin-bottom:16px;}
.vslCardHead{display:flex;align-items:center;margin-bottom:12px;font-size:15px;}
.vslBerths{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;}
.vslBerth{border:1px dashed var(--border);border-radius:12px;background:var(--bg);min-height:200px;padding:14px;display:flex;flex-direction:column;}
.vslBerth.on{border-style:solid;background:var(--surface);}
.vslBerthHead{display:flex;align-items:center;gap:10px;font-weight:800;color:var(--text-muted);font-size:15px;}
.vslBerth.on .vslBerthHead{color:#db2777;}
.vslBerthIc{width:34px;height:34px;border-radius:50%;background:var(--surface);border:1px solid var(--border);display:inline-flex;align-items:center;justify-content:center;font-size:15px;}
.vslBerthEmpty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:13px;}
.vslBerth.on{background:#fdf2f8;border-color:#fbcfe8;}
.vslBerthIc.on{background:#db2777;border-color:#db2777;color:#fff;}
.vslShipNo{color:var(--text);font-weight:800;margin-left:auto;margin-right:auto;}
.vslOp{background:#db2777;color:#fff;border-radius:999px;padding:2px 10px;font-size:12px;font-weight:800;}
.vslTimes{background:#fff7fb;border-radius:10px;padding:4px 12px;margin:12px 0 10px;}
.vslTimeRow{display:flex;justify-content:space-between;align-items:center;padding:6px 0;font-size:12.5px;border-bottom:1px solid #fce7f3;}
.vslTimeRow:last-child{border-bottom:0;} .vslTimeRow span{color:#475569;font-weight:700;} .vslTimeRow b{font-size:12.5px;color:#0f172a;}
.vslDot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#db2777;margin-right:7px;vertical-align:middle;}
.vslMid{display:flex;align-items:center;gap:12px;margin:6px 0 12px;}
.vslRing{position:relative;width:110px;height:110px;flex:0 0 auto;}
.vslRingIn{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.vslRingIn span{font-size:26px;line-height:1;} .vslRingIn b{color:#db2777;font-size:20px;margin-top:2px;}
.vslBoxes{display:flex;gap:8px;flex:1;min-width:0;}
.vslBox{flex:1;border-radius:10px;padding:8px 10px;min-width:0;} .vslBox.dis{background:#fbcfe8;} .vslBox.load{background:#ffe8dd;}
.vslBoxT{font-size:12px;font-weight:700;color:#db2777;} .vslBox.load .vslBoxT{color:#ea580c;}
.vslBoxN b{font-size:18px;color:#0f172a;} .vslBoxN span{font-size:12px;color:#64748b;}
.vslBar{height:5px;border-radius:5px;background:rgba(255,255,255,.8);margin-top:6px;overflow:hidden;} .vslBar i{display:block;height:100%;background:#db2777;} .vslBox.load .vslBar i{background:#ea580c;}
.vslChips{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;}
.vslChip{background:#eef0f3;border-radius:999px;padding:6px 12px;font-size:12.5px;color:#64748b;} .vslChip b{color:#0f172a;font-size:16px;margin-left:4px;}
.vslChip.g{background:#e7f6ec;} .vslChip.g b{color:#15803d;} .vslChip.o{background:#ffefe3;} .vslChip.o b{color:#ea580c;}
.vslBerthBody{margin-top:10px;} .vslShip{font-weight:800;font-size:15px;margin-bottom:4px;} .vslLine{font-size:13px;margin:2px 0;}
.vslTbl{width:100%;border-collapse:collapse;font-size:13px;}
.vslTbl thead th{background:#fce7f3;color:#9d174d;font-weight:800;padding:8px 6px;text-align:center;border-bottom:2px solid #db2777;}
.vslTbl tbody td{padding:9px 6px;border-bottom:1px solid var(--border);}
.vslTbl td.vslEmptyRow{text-align:center;color:var(--text-muted);padding:16px;}
.mailDay{margin:14px 0 6px;color:#9d174d;font-size:14px;} .mailTbl td{text-align:center;font-size:12.5px;padding:5px 6px;} .mailTbl th{font-size:12px;}
.adjCell{cursor:pointer;} .adjCell:hover{outline:2px solid var(--accent);outline-offset:-2px;} .adjMark{color:var(--accent);font-size:9px;margin-left:1px;}
.nameLink{cursor:pointer;text-decoration:underline dotted;text-underline-offset:3px;}
.nameLink:hover{color:var(--accent);}
:root th.gh.g-blk{background:#e5e7eb !important;color:#111 !important;} /* 근태 집계 '지원근무' 머리글: 연한 회색 */
.otSum td.gc,.otSum th.gc,.otSum td.otc{min-width:50px;padding:4px 6px !important;}
.dragHandle{display:inline-flex;align-items:center;justify-content:center;width:26px;height:28px;margin-right:4px;border-radius:6px;
  cursor:grab;color:var(--text-muted);font-size:16px;touch-action:none;user-select:none;-webkit-user-select:none;}
.dragHandle:hover{background:var(--accent-soft);color:var(--accent);}
body.team-dragging, body.team-dragging *{cursor:grabbing !important;user-select:none;-webkit-user-select:none;}
tr.dragging{opacity:.35;}
tr.drop-before td{box-shadow:inset 0 3px 0 var(--accent);}
tr.drop-after td{box-shadow:inset 0 -3px 0 var(--accent);}
[data-team-drop].drop-into{outline:2px dashed var(--accent);outline-offset:4px;}

.badge-code{display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;
  border-radius:6px;padding:2px 7px;border:1px solid transparent;}
.bc-D{background:var(--amber-soft);color:var(--amber);border-color:var(--amber-line);}
.bc-N{background:var(--night-soft);color:var(--night);border-color:var(--night-line);}
.bc-OFF{background:var(--bg);color:var(--text-muted);border-color:var(--border);}
.bc-DN{background:var(--accent-soft);color:var(--accent);border-color:var(--accent-line);}
.bc-ND{background:var(--accent-soft);color:var(--accent);border-color:var(--accent-line);}
.bc-DS{background:var(--ok-soft);color:var(--ok);border-color:var(--ok-line);}
.bc-NS{background:var(--ok-soft);color:var(--ok);border-color:var(--ok-line);}
.bc-IN{background:var(--bg);color:var(--text);border-color:var(--border);}
.bc-status{background:var(--warn-soft);color:var(--warn);border-color:var(--warn-line);}

table.tbl{border-collapse:collapse;width:100%;font-size:12.5px;}
.tbl th,.tbl td{border:1px solid var(--border);padding:6px 8px;text-align:left;white-space:nowrap;}
.tbl th{background:var(--bg);font-weight:700;color:var(--text-muted);font-size:11.5px;}
.scrollx{overflow-x:auto;max-width:100%;border-radius:10px;}
.gridwrap{border:2px solid var(--text);border-radius:10px;}

.gridwrap table.gtbl{border-collapse:collapse;font-size:11.5px;}
.gtbl th,.gtbl td{border:1px solid var(--border);padding:0;text-align:center;}
.gtbl th{background:var(--bg);color:var(--text-muted);font-weight:700;padding:5px 3px;position:sticky;top:0;z-index:2;}
.gtbl td.namecell{background:var(--surface);text-align:left;padding:6px 10px;font-weight:700;white-space:nowrap;
  position:sticky;left:0;z-index:1;}
.gtbl th.namehead{position:sticky;left:0;top:0;z-index:3;text-align:left;padding:6px 10px;}
.gtbl td.daycell{width:34px;height:34px;cursor:pointer;}
.gtbl td.daycell:hover{outline:2px solid var(--accent);outline-offset:-2px;}
.gtbl th.weekday,.tbl th.weekday{color:var(--text);}
.gtbl th.sunday,.tbl th.sunday{color:var(--warn);}
.gtbl th.saturday,.tbl th.saturday{color:var(--accent);}
.gtbl th.holiday,.tbl th.holiday{color:var(--warn);font-weight:800;}
.gtbl td.sunday,.tbl td.sunday{color:var(--warn);}
.gtbl td.saturday,.tbl td.saturday{color:var(--accent);}
.gtbl td.holiday,.tbl td.holiday{color:var(--warn);}
.daycell .mini{font-size:10.5px;font-weight:700;}
.daycell .mini2{font-size:8.5px;color:var(--text-muted);display:block;}
/* 근태관리(통합) 화면: 좌(집계)·우(월별표) 표의 행 높이/글자 크기를 강제로 맞춤 */
.ctbl.gtbl th,.ctbl.gtbl td{height:30px !important;font-size:10.5px !important;padding:2px 3px !important;box-sizing:border-box;}
.ctbl.gtbl td.namecell,.ctbl.gtbl th.namehead{padding:2px 8px !important;font-size:11px !important;}
.ctbl.gtbl td.daycell{width:30px !important;}
td.daycell.filled{border-color:rgba(255,255,255,.7);}
.gtbl th.wkA{background:#fce7f3 !important;} .gtbl th.wkB{background:#dbeafe !important;}
.gtbl td.daycell.wkA{background:#fdf2f8;} .gtbl td.daycell.wkB{background:#eff6ff;}
/* 월별 근태: 날짜 머리글만 주 단위 색, 본문 칸은 흰색 */
.ctbl th.sunday,.ctbl th.holiday{color:#dc2626 !important;font-weight:900 !important;-webkit-text-stroke:.3px #dc2626;} /* 월별 근태: 일요일·공휴일 빨간 글씨 더 굵게 */
.ctbl th.wkA{background:#dbeafe !important;} .ctbl th.wkB{background:#dcfce7 !important;} /* 월별 근태 주 색: 연한 청색 / 연한 녹색 */
.ctbl td.daycell.wkA,.ctbl td.daycell.wkB{background:var(--surface);}
/* 오늘 날짜 세로줄: 바깥 테두리보다 얇은 검은 테두리(PC·휴대폰 같은 굵기) */
.ctbl .todayCol{border-left:calc(var(--sepW,1px) * 3) solid #7c3aed !important;border-right:calc(var(--sepW,1px) * 3) solid #7c3aed !important;}
.ctbl :is(td,th):has(+ .todayCol){border-right:calc(var(--sepW,1px) * 3) solid #7c3aed !important;}
.ctbl .todayCol + :is(td,th){border-left:calc(var(--sepW,1px) * 3) solid #7c3aed !important;}
.ctbl .todayCol.todayTop{border-top:calc(var(--sepW,1px) * 3) solid #7c3aed !important;}
.ctbl .todayCol.todayBot{border-bottom:calc(var(--sepW,1px) * 3) solid #7c3aed !important;}
/* 근태 집계: OT 칸 말고는 칸 폭을 똑같이 */
.cmbLeft .ctbl thead tr:nth-child(2) th:not(.otCol){width:32px;min-width:32px;max-width:32px;}
.cmbLeft .ctbl thead tr:nth-child(2) th:not(.otCol){padding:4px 0 !important;letter-spacing:-.5px;white-space:nowrap !important;word-break:keep-all;}
@media (max-width:700px){
  /* 휴대폰(아이폰 포함): MCH·MCS가 두 줄로 꺾이지 않고, 모든 칸이 같은 폭 */
  .cmbLeft .ctbl thead tr:nth-child(2) th:not(.otCol){width:46px;min-width:46px;max-width:none;font-size:11px !important;}
  .cmbLeft .ctbl tbody td:not(.namecell):not(:first-child){min-width:46px;}
  /* 휴대폰 월별 근태: 근태 집계와 같은 크기로 크게(칸 넓게·줄 높게·글자 크게) — 옆으로 밀어서 봄 */
  .cmbRight .ctbl.gtbl td.daycell{width:40px !important;min-width:40px;}
  .cmbRight .ctbl.gtbl td.daycell .mini{font-size:12.5px;}
  .cmbRight .ctbl.gtbl thead th{font-size:12.5px !important;min-width:40px;}
  .cmbRight .ctbl.gtbl td.namecell,.cmbRight .ctbl.gtbl th.namehead{font-size:12.5px !important;min-width:64px;white-space:nowrap;}
  .cmbRight .ctbl.gtbl tbody td{height:40px !important;}
}
/* 월별 근태 성명 옆 칸 [지원 | 순번 | 퇴근]: 순번 제목을 누르면 평일·공휴일·일요일 선택 */
.ctbl th.mgFix{min-width:34px;width:34px;padding:1px 2px !important;line-height:1.15;white-space:nowrap;color:#111 !important;}
.ctbl th.mgRkHead{position:relative;cursor:pointer;}
.ctbl th.mgRkHead select.mgRkSel{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:pointer;font-size:16px;border:0;margin:0;-webkit-appearance:none;appearance:none;}
.ctbl td.mgFix{min-width:34px;width:34px;padding:0 2px !important;}
.cmbRight .ctbl th.mgFixEnd,.cmbRight .ctbl td.mgFixEnd{border-right:var(--sepW,1px) solid #111 !important;}
.cmbRight .ctbl th.mgFixEnd + th,.cmbRight .ctbl td.mgFixEnd + td{border-left:var(--sepW,1px) solid #111 !important;}
.cmbRight .ctbl th.namehead + th.mgFix,.cmbRight .ctbl td.namecell + td.mgFix{border-left:1px solid #c4cad3 !important;}
.cmbRight .ctbl th.namehead,.cmbRight .ctbl td.namecell{border-right-color:#c4cad3 !important;}
@media (max-width:700px){
  /* 휴대폰: 성명·지원·순번·퇴근을 왼쪽에 고정 → 말일까지 옆으로 밀면 날짜가 퇴근 바로 옆으로 들어옴 */
  .scrollx.mFreeze td.mgFix{position:sticky;z-index:2;}
  .scrollx.mFreeze thead th.mgFix{position:sticky;z-index:7;box-shadow:inset 0 -1px 0 #111;}
  .scrollx.mFreeze td.mgFixEnd{box-shadow:inset -1px 0 0 #111;}
  .scrollx.mFreeze thead th.mgFixEnd{box-shadow:inset -1px 0 0 #111, inset 0 -1px 0 #111;}
  .scrollx.mFreeze td.namecell{z-index:3;}
  .cmbRight .ctbl.gtbl thead th.mgFix{min-width:34px;width:34px;font-size:11.5px !important;}
  .cmbRight .ctbl.gtbl td.mgFix{min-width:34px;width:34px;}
}
/* PC 근태관리·월별 OT현황: 표 상자 안에서 위아래·옆으로 밂(가로 스크롤 막대가 화면 안에 보임), 머리글은 위에 고정 */
.pcFreeze{overflow:auto !important;overscroll-behavior:contain;}
.pcFreeze thead th{position:sticky;z-index:5;}
.pcFreeze thead th.namehead{z-index:7;}
.pcFreeze thead th.namehead.noStick{z-index:5;}
.pcFreeze .cmbRight thead th.mgFix{z-index:6;}
.cmbWrap.cmbJoin.pcFreeze .cmbLeft .scrollx,.cmbWrap.cmbJoin.pcFreeze .cmbRight .scrollx{overflow:visible !important;}
/* PC 근태관리·월별 OT현황 틀고정(배차표처럼): 요약 칸은 왼쪽에 고정, 날짜 칸만 밂, 끝 여백으로 말일까지 */
.fzInner{display:flex;align-items:flex-start;width:max-content;}
.fzInner > table{flex:0 0 auto;}
.fzTail{flex:0 0 auto;height:1px;align-self:flex-start;}
.pcFreeze td.fzCol,.pcFreeze th.fzCol{position:sticky !important;}
.pcFreeze tbody td.fzCol{z-index:3;}
.pcFreeze thead th.fzCol{z-index:8 !important;}
.pcFreeze tbody td.fzCol:not(.gc):not(.rkCol):not([style*="background"]){background:var(--surface);}
.pcFreeze .fzEnd{box-shadow:inset -2px 0 0 #111 !important;}
.cmbWrap.cmbFzLeft > .cmbLeft{position:sticky;left:0;z-index:9;background:var(--surface);}
/* PC 근태관리(두 표를 붙여 옆으로 밂): 월별 근태로 넘어가면 성명·지원·순번이 왼쪽에 고정 */
.cmbWrap.cmbJoin .cmbRight td.mgFix{position:sticky;z-index:2;}
.cmbWrap.cmbJoin .cmbRight td.mgFixEnd{box-shadow:inset -1px 0 0 #111;}
.cmbWrap.cmbJoin .cmbRight thead th.mgFix{position:sticky;z-index:4;box-shadow:inset 0 -1px 0 #111;}
.cmbWrap.cmbJoin .cmbRight thead th.mgFixEnd{box-shadow:inset -1px 0 0 #111, inset 0 -1px 0 #111;}
.cmbWrap.cmbJoin .cmbRight td.namecell{z-index:3;}
/* 성명 칸 가운데 정렬(근태 집계·월별 근태·월별 OT현황) */
.ctbl td.namecell,.ctbl th.namehead,.otSum td.namecell,.otSum th.namehead{text-align:center !important;}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .gtbl th.wkA{background:#1b2332 !important;} :root:not([data-theme="light"]) .gtbl th.wkB{background:#253044 !important;}
  :root:not([data-theme="light"]) .gtbl td.daycell.wkA{background:#161d2b;} :root:not([data-theme="light"]) .gtbl td.daycell.wkB{background:#1d2637;} }
/* 서류 메일: 보내는 사람 이름·메일 한 줄(휴대폰은 두 줄) */
.dmFromRow{display:flex;gap:6px;flex-wrap:wrap;}
.dmFromRow input{flex:1 1 140px;min-width:0;}
/* 출퇴근 입력: 저장된 날은 [수정] 전까지 보기만(칸 흐리게) */
.inTbl.inView input.inCell{background:transparent !important;border-color:transparent !important;color:var(--text) !important;-webkit-text-fill-color:var(--text);opacity:1;}
.inTbl.inView input.inChk{opacity:.75;}
/* 월별 근태: 날짜 메모 순서 번호(아주 작게, 근태코드 크기는 그대로) */
.ctbl td.daycell{position:relative;}
.ctbl td.daycell sup.mmNo{position:absolute;top:1px;right:1px;font-size:7px;line-height:1;font-weight:800;color:#111;opacity:.85;pointer-events:none;}
/* 월별 근태: 그 조가 야간인 주의 일요일 칸은 회색 */
.ctbl.gtbl td.daycell.sunN{background:#d1d5db;}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]) .ctbl.gtbl td.daycell.sunN{background:#3a4150;} }
:root[data-theme="dark"] .ctbl.gtbl td.daycell.sunN{background:#3a4150;}
/* 휴대폰 가로 화면(안드로이드·아이폰): 근태 집계와 월별 근태를 한 줄로 나란히 — 줄이지 않고 원래 크기로, 좌우로 밀어서 봄
   (표 줄이기(zoom)는 브라우저마다 계산이 달라 좌우가 어긋나므로 쓰지 않음) · 두 표의 줄 높이를 같게, 첫 줄 위치를 맞춤 */
@media (orientation:landscape) and (max-height:500px) and (pointer:coarse){
  .cmbWrap{flex-wrap:nowrap !important;gap:10px !important;align-items:flex-start !important;overflow-x:auto;-webkit-overflow-scrolling:touch;padding-bottom:6px;}
  .cmbWrap .panel{padding:8px !important;flex:0 0 auto !important;max-width:none !important;min-width:0 !important;width:auto !important;}
  .cmbLeft .scrollx,.cmbRight .scrollx{overflow:visible !important;max-height:none !important;}
  .cmbWrap table.ctbl{zoom:1 !important;width:auto !important;}
  .cmbWrap .ctbl tbody td,.cmbWrap .cmbRight .ctbl.gtbl tbody td{height:30px !important;padding-top:0 !important;padding-bottom:0 !important;font-size:12.5px !important;}
  .cmbWrap .ctbl thead th{font-size:12px !important;}
  .cmbCtrl{height:40px !important;min-height:40px !important;margin-bottom:8px !important;flex-wrap:nowrap !important;overflow:hidden;}
  .cmbCtrl input[type=date]{height:32px !important;font-size:13px !important;padding:2px 6px !important;width:auto;}
  .cmbCtrl h3{font-size:15px;}
  .cmbLeft .ctbl td.stNo,.cmbLeft .ctbl thead tr:first-child th:first-child{width:30px !important;min-width:30px !important;max-width:30px !important;padding:0 !important;}
  .cmbLeft .ctbl td.stName,.cmbLeft .ctbl thead tr:first-child th:nth-child(2),.cmbRight .ctbl td.namecell,.cmbRight .ctbl th.namehead{width:62px !important;min-width:62px !important;max-width:62px !important;white-space:nowrap;padding-left:2px !important;padding-right:2px !important;}
  .cmbLeft .ctbl thead tr:nth-child(2) th:not(.otCol){width:38px !important;min-width:38px !important;max-width:38px !important;}
  .cmbLeft .ctbl th.otCol{width:52px !important;min-width:52px !important;max-width:52px !important;}
  .cmbRight .ctbl.gtbl td.daycell{width:34px !important;min-width:34px !important;}
  .cmbRight .ctbl.gtbl thead th:not(.namehead){min-width:34px !important;}
}
/* 근태관리: 집계(왼쪽)와 월별 근태코드(오른쪽)를 나란히, 행 높이를 맞춤 */
.cmbWrap{display:flex;gap:14px;align-items:flex-start;flex-wrap:wrap;}
/* 휴대폰 세로: 시트 두 개(근태 집계 / 월별 근태) — 단추로 하나씩 */
.cmbPhTop{display:flex;align-items:center;gap:5px;flex-wrap:nowrap;margin:0 0 8px;}
.cmbPhTop .phT{font-size:14px;white-space:nowrap;margin-right:1px;}
.cmbPhTop input[type=date]{min-width:0;flex:1 1 0;max-width:118px;height:30px;padding:2px 4px;font-size:12px;border:1px solid var(--border);border-radius:7px;background:var(--bg);color:var(--text);box-sizing:border-box;}
.cmbPhTop .phNav{padding:4px 9px !important;}
.cmbPhTop .phYm{font-size:14px;white-space:nowrap;}
.cmbPhTop .phTeam{margin-left:auto;display:flex;gap:4px;flex:0 0 auto;}
.cmbPhTop .phTeam .btn.sm{padding:4px 8px;font-size:12px;}
.cmbTabs{display:none;}
@media (max-width:700px){
  .cmbTabs{display:flex;gap:0;margin:0 0 6px;border:1.5px solid var(--btn);border-radius:10px;overflow:hidden;}
  .cmbTab{flex:1 1 0;border:0;background:var(--surface);color:var(--btn);font:inherit;font-weight:700;font-size:13.5px;padding:6px 0;cursor:pointer;}
  .cmbTab + .cmbTab{border-left:1.5px solid var(--btn);}
  .cmbTab.on{background:var(--btn);color:#fff;}
  .cmbWrap.cmbShow-stat .cmbRight{display:none !important;}
  /* 휴대폰 세로: 두 표를 옆으로 이어 붙여 한 번에 밀어 봄 */
  .cmbWrap.cmbPhJoin{flex-wrap:nowrap !important;gap:0 !important;align-items:flex-start !important;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x pan-y pinch-zoom;}
  .cmbWrap.cmbPhJoin > .panel{flex:0 0 auto !important;max-width:none !important;min-width:0 !important;width:auto !important;padding:4px !important;}
  .cmbWrap.cmbPhJoin > .cmbLeft{padding-right:0 !important;border-top-right-radius:0;border-bottom-right-radius:0;border-right:0;}
  .cmbWrap.cmbPhJoin > .cmbRight{padding-left:0 !important;padding-right:14px !important;border-top-left-radius:0;border-bottom-left-radius:0;border-left:0;}
  .cmbWrap.cmbPhJoin .scrollx{overflow:visible !important;max-height:none !important;}
  .cmbWrap.cmbPhJoin .cmbLeft .gridwrap{border-right:0;border-top-right-radius:0;border-bottom-right-radius:0;}
  .cmbWrap.cmbPhJoin .cmbRight .gridwrap{border-top-left-radius:0;border-bottom-left-radius:0;}
  .cmbWrap.cmbPhJoin td.mgFix{position:sticky;z-index:2;}
  .cmbWrap.cmbPhJoin td.mgFixEnd{box-shadow:inset -1px 0 0 #111;}
  .cmbWrap.cmbPhJoin thead th.mgFix{position:sticky;z-index:4;box-shadow:inset 0 -1px 0 #111;}
  .cmbWrap.cmbPhJoin thead th.mgFixEnd{box-shadow:inset -1px 0 0 #111, inset 0 -1px 0 #111;}
  .cmbWrap.cmbPhJoin .cmbRight td.namecell{z-index:3;}
  .cmbWrap.cmbPhJoin .cmbRight thead th.namehead{z-index:5;}
  .cmbPhTop .phV{display:none;align-items:center;gap:5px;min-width:0;flex:1 1 auto;}
  .cmbPhTop[data-on="stat"] .phV-stat,.cmbPhTop[data-on="month"] .phV-month{display:flex;}
  .cmbWrap.cmbShow-month .cmbLeft{display:none !important;}
}
/* PC: 엑셀처럼 근태 집계와 월별 근태를 한 장으로 붙여서(사이 간격 없이, 줄 높이·머리글 높이 같게) */
.cmbWrap.cmbJoin{gap:0 !important;flex-wrap:nowrap !important;}
.cmbJoin .cmbLeft{flex:0 0 auto !important;max-width:none !important;border-right:0;border-top-right-radius:0;border-bottom-right-radius:0;padding-right:0 !important;}
.cmbJoin .cmbRight{flex:1 0 auto !important;min-width:auto;border-left:0;border-top-left-radius:0;border-bottom-left-radius:0;padding-left:0 !important;}
.cmbJoin .cmbLeft .gridwrap{border-right:0;border-top-right-radius:0;border-bottom-right-radius:0;}
.cmbJoin .cmbRight .gridwrap{border-top-left-radius:0;border-bottom-left-radius:0;}
.cmbJoin .cmbRight .cmbCtrl{padding-left:14px;}
.cmbJoin .cmbLeft .scrollx,.cmbJoin .cmbRight .scrollx{overflow:visible !important;}
/* 월별 OT현황처럼 스크롤 하나로: 두 표를 한 상자 안에서 같이 옆으로 밀고(아래 스크롤 막대 하나), No·성명은 왼쪽에 고정 */
.cmbWrap.cmbJoin{overflow-x:auto;overflow-y:hidden;align-items:stretch !important;background:var(--surface);border:1px solid var(--border);border-radius:12px;}
.cmbJoin > .panel{border:0 !important;border-radius:0 !important;background:transparent;}
.cmbWrap .panel{margin-bottom:0;padding:14px;}
.cmbLeft{flex:0 0 auto;max-width:100%;}
.cmbRight{flex:1 1 360px;min-width:0;}
@media (min-width:861px){ /* PC: 근태 집계는 좁게(44%), 월별 근태는 넓게 */
  .cmbLeft{flex:0 0 min(calc(44% - 7px), 600px);max-width:min(calc(44% - 7px), 600px);min-width:0;}
  .cmbRight{flex:1 1 0;}
  .cmbLeft .ctbl td.namecell a,.cmbLeft .ctbl td.namecell{white-space:nowrap;}
  /* OT 칸은 숫자(예: 549.5)만 들어갈 폭으로 좁게 */
  .cmbLeft .ctbl th.otCol{width:50px;min-width:50px;max-width:50px;padding-left:2px !important;padding-right:2px !important;}
  /* 월별 근태: 성명 칸을 이름 폭만큼만 */
  .cmbRight .ctbl th.namehead,.cmbRight .ctbl td.namecell{width:58px;min-width:58px;max-width:58px;padding-left:2px !important;padding-right:2px !important;white-space:nowrap;}
}
.cmbCtrl{min-height:34px;display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:6px 10px;margin-bottom:8px;}
.cmbCtrl h3{margin:0;white-space:nowrap;}
/* 근태관리 두 표의 제목 줄을 한 줄로: 근태 집계 제목(+UNION 날짜) / 월별 근태 제목 + 이전달·연월·다음달 */
.cmbCtrl .row{height:auto !important;margin:0 !important;gap:6px;flex-wrap:nowrap;align-items:center !important;}
.cmbCtrl .field{margin:0;min-width:0 !important;}
.cmbCtrl .field label{display:none;}
.cmbCtrl input[type=date]{padding:4px 6px;font-size:12.5px;height:30px;box-sizing:border-box;}
.cmbCtrl .btn.sm{padding:4px 9px;}
.cmbCtrl:has(input[type=date]) h3 span{display:none;} /* UNION: 날짜 칸이 있으면 제목 옆 기간 글자는 숨겨 한 줄로 */
.ctbl.gtbl thead th{height:34px !important;}
/* 배차표: 가로로 밀어서 보기 + 왼쪽 정보칸·머리글 고정 + 줄 높이 통일 */
.dpScrollBar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:10px 0 8px;}
.dpWrap{overflow:auto;max-height:calc(100vh - 150px);border:2px solid var(--text);border-radius:0 0 10px 10px;background:var(--surface);-webkit-overflow-scrolling:touch;}
@media (min-width:701px){ .dpWrap{overflow-x:scroll;} #content .dpBox{width:100%;} } /* PC 배차표: 틀은 화면 오른쪽 끝까지, 아래 가로 스크롤 막대는 늘 보이게 */
/* 배차표 끝 여백: 막대를 끝까지 밀면 마지막 시간 칸이 왼쪽 고정칸(No~승무) 바로 옆까지 옴 */
.dpInner{display:flex;align-items:flex-start;width:max-content;}
.dpInner > #dpTable{flex:0 0 auto;}
.dpTail{flex:0 0 auto;height:1px;}
#dpTable{border-collapse:separate;border-spacing:0;font-size:12px;}
#dpTable th,#dpTable td{height:36px;border-right:1px dotted #111;border-bottom:1px dotted #111;text-align:center;padding:0 4px;white-space:nowrap;}
#dpTable thead th{position:sticky;top:0;z-index:3;background:var(--bg);}
#dpTable td.dpLockCell{min-width:42px;width:42px;background:repeating-linear-gradient(45deg,transparent 0 6px,rgba(0,0,0,.04) 6px 8px);cursor:not-allowed;}
#dpTable td.dpCell{min-width:42px;width:42px;cursor:pointer;user-select:none;-webkit-user-select:none;touch-action:manipulation;-webkit-touch-callout:none;} /* manipulation = 스크롤+두 손가락 확대·축소 허용 */
#dpTable th.dpSlotH{min-width:42px;width:42px;}
#dpTable th.dpHH{text-align:left;padding:0 0 0 1px !important;font-size:15px;font-weight:800;letter-spacing:-.3px;}
#dpTable th.dpMM{text-align:left;padding:0 0 0 1px !important;font-size:10px;font-weight:600;}
#dpTable td.dpMeal{min-width:42px;width:42px;padding:0 !important;}
#dpTable .dpInline{width:100%;height:30px;border:0;outline:2px solid #1d4ed8;background:#fff;color:#111;font-weight:800;font-size:16px;text-align:center;padding:0;box-sizing:border-box;} /* 16px 미만이면 아이폰이 입력할 때 화면을 자동 확대함 */
#dpTable tr.dpOff td:not(.dpPainted){background:#e5e7eb !important;color:#6b7280;}
/* 출퇴근 입력: 근무자가 아닌 사람(휴무·휴가 등) 줄은 배차표처럼 흐린 회색 */
.inTbl tr.inOff td{background:#e5e7eb !important;color:#6b7280;}
.inTbl tr.inOff input.inCell{color:#6b7280;}
/* 월별 OT현황: 담당 체크한 날은 아주 연한 분홍 */
.otSum td.otDam,.otSum td.otDam.wkA,.otSum td.otDam.wkB{background:#ffe4ef !important;}
.otSum td.otMealC{position:relative;}
.dpDoneBtn{background:#fff !important;color:#15803d !important;border:1.5px solid #22c55e !important;font-weight:800;}
.dpDoneBtn.on,.dpDoneChip{background:#16a34a !important;color:#fff !important;border:1.5px solid #16a34a !important;}
#dpDoneAlert{position:fixed;left:50%;top:calc(env(safe-area-inset-top,0px) + 14px);transform:translateX(-50%);z-index:1000;background:#16a34a;color:#fff;border-radius:14px;padding:14px 22px;box-shadow:0 10px 30px rgba(0,0,0,.3);display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;max-width:92vw;animation:dpDonePop .35s ease-out;}
#dpDoneAlert b{font-size:20px;} #dpDoneAlert span{font-size:12px;opacity:.9;}
@keyframes dpDonePop{from{transform:translate(-50%,-20px);opacity:0;}to{transform:translate(-50%,0);opacity:1;}}
@media (max-width:700px){
  .dpHead{flex-wrap:nowrap !important;gap:4px !important;max-width:100%;}
  .dpHead > *{flex:0 0 auto;white-space:nowrap;}
  .dpHead #dpDate{flex:1 1 auto;width:118px;min-width:84px;max-width:124px;padding:6px 3px !important;font-size:12.5px !important;}
  .dpHead .btn.sm,.dpHead .dpDoneChip{padding:6px 7px;font-size:12.5px;}
}
@media (max-width:370px){
  .dpHead #dpDate{min-width:74px;}
  .dpHead .dpKakaoBtn{padding-left:5px !important;padding-right:5px !important;}
  .dpHead .dpLbl{display:none;}
  .dpHead .btn.sm,.dpHead .dpDoneChip{padding:6px 6px;font-size:12px;}
}
.dpPushBtn.on{background:#eff6ff !important;color:#1d4ed8 !important;border-color:#93c5fd !important;font-weight:800;}
.dpKakaoBtn,.btn.dpKakaoGo{background:#fee500 !important;color:#191919 !important;border-color:#e6cf00 !important;font-weight:800;} /* 배차완료 카톡 보내기(카카오 노란색) */
.inBtnRow .inDirtyS{display:none;}
@media (max-width:700px){ /* 휴대폰 출퇴근 입력: 저장·수정·조장 마감·조장 수정을 한 줄로, 설명 글은 숨김 */
  .inBtnRow{flex-wrap:nowrap !important;gap:5px !important;}
  .inBtnRow .inLeadBtns{display:contents;}
  .inBtnRow .btn{flex:1 1 auto;min-width:0;padding:8px 4px !important;font-size:12.5px !important;white-space:nowrap;}
  .inBtnRow .inDirty{display:none;} .inBtnRow .inDirtyS{display:inline;}
  .inBtnRow .inLockMsg{display:none;}
}
@media (max-width:700px){ .dpKakaoBtn .dpLbl{display:none;} .dpKakaoBtn{padding-left:8px !important;padding-right:8px !important;} } /* 휴대폰: 윗줄이 넘치지 않게 카톡 단추는 💬만 */
.dpDoneChip{display:inline-flex;align-items:center;gap:4px;padding:5px 10px;border-radius:8px;font-size:13px;font-weight:800;}
.dpDoneBtn small,.dpDoneChip small{font-weight:600;opacity:.85;font-size:11px;}
.otSum td.otMealC sup.otMealNo{position:absolute;top:1px;right:2px;font-size:7.5px;line-height:1;font-weight:800;color:#b45309;letter-spacing:-.3px;pointer-events:none;}
/* 근태관리(집계·월별 근태)·월별 OT현황: 3명마다 검은 구분선 */
.ctbl tbody tr:nth-child(3n):not(:last-child) > td,.otSum tbody tr:nth-child(3n):not(:last-child) > td{border-bottom:var(--sepW,1px) solid #111 !important;}
.ctbl tbody tr:nth-child(3n+1):not(:first-child) > td,.otSum tbody tr:nth-child(3n+1):not(:first-child) > td{border-top:var(--sepW,1px) solid #111 !important;}
.otSum tbody tr:nth-child(3n):not(:last-child) td.stNo{box-shadow:inset -1px 0 0 #c4cad3, inset 0 -1px 0 #111 !important;}
.otSum tbody tr:nth-child(3n):not(:last-child) td.namecell.stName{box-shadow:inset -1px 0 0 #111, inset 0 -1px 0 #111, 1px 0 0 #111 !important;}
/* 지원계획표: 모든 칸을 검은 선으로 */
#splanTable{border-collapse:collapse;margin:0;width:auto;border:0 !important;}
@media (min-width:701px){ #splanTable{width:734px;table-layout:fixed;} #splanTable td.spLbl,#splanTable thead tr:first-child th:first-child{width:134px;} #splanTable td.spLbl{font-size:12px;letter-spacing:-.3px;} #splanTable .spIn{width:100% !important;box-sizing:border-box;} }
#splanTable tr > :first-child{border-left:0 !important;} #splanTable tr > :last-child{border-right:0 !important;}
#splanTable thead tr:first-child > th{border-top:0 !important;} #splanTable tbody tr:last-child > td{border-bottom:0 !important;}
#splanTable td.spLbl{padding:2px 6px !important;}
#splanTable th{padding:4px 2px !important;}
#splanTable th,#splanTable td{color:#111 !important;text-align:center !important;vertical-align:middle;padding:2px 4px;}
#splanTable thead th{font-weight:800;font-size:12px;background:#f1f5f9;}
#splanTable td.spLbl{font-weight:700;white-space:nowrap;padding:2px 10px;}
#splanTable .spIn{width:52px;border:0;border-radius:0;padding:3px 2px;background:transparent;color:#111;text-align:center;font:inherit;font-size:12px;outline:none;}
#splanTable td.spInCell{padding:0 !important;background:#fffbea;}   /* 입력 칸: 네모 없이 칸 자체가 입력창(연한 노란 바탕) */
#splanTable td.spInCell .spIn{width:100% !important;height:100%;min-height:28px;box-sizing:border-box;}
#splanTable td.spInCell:focus-within{box-shadow:inset 0 0 0 2px #2563eb;}
#splanTable.spTall .spIn{height:var(--spInH);font-size:15px;box-sizing:border-box;}
/* 지원계획표: 숫자 진하게·모두 검은 글씨 (날짜 머리글만 토요일 파랑·일요일/공휴일 빨강) */
#splanTable .spIn,#splanTable tbody td:not(.spLbl){font-weight:800 !important;color:#111 !important;}
#splanTable th.spSat{color:#1d4ed8 !important;}
#splanTable th.spHol{color:#dc2626 !important;}
#splanTable.spTall td{font-size:14px;}
@media (max-width:700px){ #prevWeek,#nextWeek{display:none !important;} } /* 휴대폰 지원계획표: 이전주·다음주 버튼 숨김 */
#splanTable tbody td.sp-avail:not(.spLbl){color:#1d4ed8 !important;font-weight:800;}   /* 지원가능 파랑 */
#splanTable td.sp-attend{color:#111 !important;font-weight:900;}
#splanTable tbody td.sp-ratio:not(.spLbl){color:#dc2626 !important;font-weight:800;}   /* 교대비율 빨강 (출근원은 검정) */
/* 표 폭만큼만 테두리(오른쪽 빈 공간 없앰) */
.scrollx.fitW{width:fit-content;max-width:100%;}
.dpBox{width:fit-content;max-width:100%;}
#splanTable th,#splanTable td{border:1px solid #111 !important;}
#dpTable tr.dpOff .dpNote{color:#9ca3af;}
#dpTable tr.dpGrp > td{border-bottom:1px solid #111 !important;}
#dpTable tr.dpLast > td{border-bottom:1px solid #111 !important;} /* 조원(No·성명) 끝나는 곳: 지원 줄과 구분 */
#dpTable td.dpRk{background:var(--g-soft) !important;}
#dpTable td.dpRk .rkPlain{color:#111;font-weight:800;font-size:12px;}
#dpTable tr.dpOff td.dpRk{background:#e5e7eb !important;}
#dpTable .dpTxt{font-size:10px;font-weight:800;line-height:1.1;display:block;overflow:hidden;white-space:nowrap;}
#dpTable th.dpMealH{border-top:2px solid #E03131 !important;}
#dpTable td.dpMealF{border-bottom:2px solid #E03131 !important;}
#dpTable .mL{border-left:2px solid #E03131 !important;}
#dpTable .mR{border-right:2px solid #E03131 !important;}
#dpTable .dpNote{width:100%;height:100%;min-height:34px;border:0;background:transparent;color:#E03131;font-weight:800;font-size:12px;text-align:center;padding:0 2px;font-family:inherit;}
#dpTable .dpNote:focus{outline:2px solid #E03131;outline-offset:-2px;background:#fff5f5;}
#dpTable .dpNote:disabled{color:#E03131;opacity:1;-webkit-text-fill-color:#E03131;}
#dpTable .dpI{position:sticky;background:var(--surface);z-index:2;}
#dpTable thead .dpI{z-index:4;background:var(--bg);}
#dpTable .dpI1{left:0;min-width:40px;width:40px;}
#dpTable .dpI2{left:40px;min-width:88px;width:88px;font-weight:700;text-align:center !important;white-space:nowrap;}
#dpTable .dpI2 input{text-align:center;}
#dpTable .dpI3{left:128px;min-width:48px;width:48px;font-weight:700;}
#dpTable .dpI4{left:176px;min-width:50px;width:50px;}
#dpTable .dpI5{left:226px;min-width:46px;width:46px;border-right:1px solid #111;}
#dpTable td.dpI1[colspan]{min-width:272px;border-right:1px solid #111;}
@media (min-width:701px){
  /* PC: 배차표를 작게 — 행·열이 한 화면에 들어오도록 칸 크기·글씨를 줄임 */
  #dpTable{font-size:11px;}
  #dpTable th,#dpTable td{height:24px;padding:0 2px;}
  #dpTable td.dpCell,#dpTable td.dpLockCell,#dpTable th.dpSlotH,#dpTable td.dpMeal{min-width:37px;width:37px;}
  #dpTable th.dpHH{font-size:14px;}
  #dpTable th.dpMM{font-size:10px;}
  #dpTable .dpTxt{font-size:9px;}
  #dpTable .dpInline{height:22px;font-size:12px;}
  #dpTable .dpNote{min-height:22px;font-size:11px;}
  #dpTable .dpI1{min-width:30px;width:30px;}
  #dpTable .dpI2{left:30px;min-width:70px;width:70px;}
  #dpTable .dpI2 input{width:62px !important;font-size:11px;padding:2px 4px !important;}
  #dpTable .dpI3{left:100px;min-width:40px;width:40px;}
  #dpTable .dpI4{left:140px;min-width:42px;width:42px;}
  #dpTable .dpI5{left:182px;min-width:38px;width:38px;}
  #dpTable td.dpI1[colspan]{min-width:220px;}
  #dpTable .badge,#dpTable .rk{transform:scale(.85);}
}
@media (max-width:700px){
  /* 폰 배차표: 수정·초반·후반·당직·정비·기타 버튼을 한 줄로 */
  .dpPal{flex-wrap:nowrap !important;gap:4px !important;padding:6px !important;margin-bottom:8px !important;}
  .dpPal .dpCatBtn{flex:1 1 0;min-width:0;padding:7px 0 !important;font-size:12px !important;border-radius:8px !important;white-space:nowrap;}
  /* 폰 배차표 한 화면 맞춤: 줄 높이·글씨를 화면에 맞게 줄임(fitDispatch가 값 계산) */
  #dpTable.dpFit tbody td{height:var(--dpRowH) !important;font-size:var(--dpFs);line-height:1;padding-top:0;padding-bottom:0;}
  #dpTable.dpFit tbody .badge,#dpTable.dpFit tbody .rk{font-size:var(--dpFs) !important;height:auto;min-width:0;padding:1px 4px !important;line-height:1.05;transform:none;}
  #dpTable.dpFit tbody input{height:calc(var(--dpRowH) - 3px);padding:0 3px !important;font-size:var(--dpFs) !important;}
  /* 폰: 줄 높이를 낮춰 조원이 한 화면에 더 많이 들어오게 */
  .dpBox > div:first-child{padding:5px 10px !important;font-size:13px !important;}
  #dpTable{font-size:12px;}
  #dpTable th,#dpTable td{height:28px;}
  #dpTable .badge{padding:1px 5px;}
  /* 폰: No·성명·근태·순번·승무까지 고정(좁게) → 옆으로 밀어도 그대로 */
  #dpTable .dpI1{min-width:26px;width:26px;padding:0 1px;}
  #dpTable .dpI2{left:26px;min-width:58px;width:58px;padding:0 2px;}
  #dpTable .dpI2 input{width:52px !important;}
  #dpTable .dpI3{left:84px;min-width:36px;width:36px;padding:0 1px;}
  #dpTable .dpI4{left:120px;min-width:34px;width:34px;padding:0 1px;}
  #dpTable .dpI5{left:154px;min-width:34px;width:34px;padding:0 1px;border-right:1px solid #111;}
  #dpTable td.dpI1[colspan]{min-width:188px;}
  .dpScrollBar .hint{display:none;}
  #dpTable td.dpCell,#dpTable td.dpLockCell,#dpTable th.dpSlotH{min-width:38px;width:38px;}
}

@media (max-width:700px){
  /* 휴대폰 틀고정(근태 집계·월별 근태·월별 OT현황): 머리글 줄은 위에, No·성명은 왼쪽에 고정 */
  .scrollx.mFreeze{overflow:auto;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;touch-action:pan-x pan-y pinch-zoom;}
  .scrollx.mFreeze thead th{position:sticky;z-index:5;}
  .scrollx.mFreeze thead th.namehead{z-index:7;}
  .scrollx.mFreeze thead th.namehead.noStick{z-index:5;}
}
@media (max-width:700px){
  /* 휴대폰 출퇴근 입력: 위 날짜·조 버튼을 한 줄로 촘촘하게, 표는 fitInputMobile이 화면 높이에 맞춤 */
  .inCtl{gap:5px !important;margin-bottom:8px !important;flex-wrap:wrap;align-items:center !important;}
  .inCtl .field label{display:none;}
  .inCtl .field{min-width:0 !important;margin:0;}
  .inCtl #inDate{width:128px;padding:5px 6px;font-size:13px;}
  .inCtl .btn.sm{padding:5px 8px;font-size:12px;}
  .inCtl > b{font-size:13px !important;margin-left:2px !important;}
  #content table.gtbl.mFit tbody td{height:var(--mRowH) !important;font-size:var(--mFs) !important;line-height:1 !important;padding-top:0 !important;padding-bottom:0 !important;}
  #content table.gtbl.mFit tbody td .mini,#content table.gtbl.mFit tbody td .rkPlain,#content table.gtbl.mFit tbody td a{font-size:var(--mFs) !important;line-height:1 !important;}
  #content table.gtbl.mFit tbody tr{height:var(--mRowH) !important;}
  .inTbl.inFit tbody td{height:var(--inRowH) !important;font-size:var(--inFs);line-height:1;}
  .inTbl.inFit tbody td.inName{padding:0 5px !important;}
  .inTbl.inFit .inCell{height:calc(var(--inRowH) - 2px);font-size:var(--inFs);}
  .inTbl.inFit .badge{font-size:calc(var(--inFs) - 1px) !important;padding:0 4px !important;line-height:1.15;}
  .inTbl.inFit input[type=checkbox]{width:calc(var(--inRowH) * .5);height:calc(var(--inRowH) * .5);min-width:11px;min-height:11px;margin:0;}
}
/* 휴대폰 확대·축소 버튼(화면 오른쪽 아래에 떠 있음) */
.zoomFab{display:none;}
@media (max-width:700px){
  .zoomFab{display:flex;position:fixed;right:10px;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:60;align-items:center;gap:0;
    background:transparent;border:1px solid #f9a8d4;border-radius:999px;box-shadow:none;padding:2px;} /* 흰 배경 없이 투명 — 뒤 표가 비쳐 보임 */
  .zoomFab button{border:0;background:transparent;font:inherit;font-weight:800;font-size:18px;color:#be185d;width:38px;height:34px;border-radius:999px;}
  .zoomFab #zoomFabPct{font-size:11px;width:46px;color:#374151;white-space:nowrap;padding:0;}
  .zoomFab button{white-space:nowrap;line-height:1;}
  body.printing-sv .zoomFab,body.printing-acc .zoomFab,body.printing-ps .zoomFab{display:none !important;}
}
@media print{ .zoomFab,.zoomCtl{display:none !important;} }
/* PC 화면 확대·축소 버튼 */
.zoomCtl{display:flex;align-items:center;gap:2px;margin-right:10px;background:#fff;border:1px solid #f9a8d4;border-radius:9px;padding:2px;}
.zoomCtl button{border:0;background:transparent;font:inherit;font-weight:800;font-size:15px;color:#be185d;min-width:30px;height:28px;border-radius:7px;cursor:pointer;}
.zoomCtl button:hover{background:#fce7f3;}
.zoomCtl #zoomPct{font-size:12px;min-width:46px;color:#374151;}
@media (max-width:700px){ .zoomCtl{display:none;} }
@media (max-width:700px){
  /* 휴대폰 근태관리: 제목·버튼·표 사이 간격을 좁게, 월별 근태 제목 옆에 이전달·연월·다음달 */
  .cmbWrap{gap:10px;}
  .cmbWrap .panel{padding:10px 10px 12px;}
  .cmbCtrl{height:auto !important;margin-bottom:6px;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:flex-start;gap:6px 8px;}
  .cmbCtrl h3{font-size:15px;}
  .cmbCtrl .row{height:auto !important;margin:0 !important;gap:6px;}
  .cmbRight .cmbCtrl .row .btn.sm{padding:4px 8px;font-size:12px;}
  .cmbRight .cmbCtrl .row b{font-size:14px !important;}
  .cmbTeamRow{margin-bottom:8px !important;}
}
@media (max-width:700px){ header.app .status{min-width:0;flex-shrink:1;} header.app h1{flex:none;} }
@media (max-width:700px){ header.app .status span{white-space:normal;text-align:right;line-height:1.25;} header.app .status{overflow:hidden;} }
/* 월별 OT현황: 이전달 · 연월 · 다음달 한 줄 */
.otMonRow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:4px 0 8px;}
.otMonTxt{font-size:16px;white-space:nowrap;}
.otMonRange{font-size:12px;color:var(--text-muted);white-space:nowrap;}
@media (max-width:700px){
  .otMonRow{gap:6px;margin:2px 0 6px;}
  .otMonRow .btn.sm{padding:4px 8px;font-size:12px;}
  .otMonTxt{font-size:15px;}
  .otMonRange{display:none;} /* 휴대폰: 기간 글자는 숨겨서 빈 줄이 생기지 않게 */
  .otMonRow{flex-wrap:nowrap;}
  .otTeamRow{margin-bottom:8px !important;}
}
/* 선석 조회: 조회일자 줄(회사 사이트와 같은 모양) */
.bcSearch{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:#fdf2f8;border:1px solid #fbcfe8;border-radius:12px;padding:10px 16px;margin:4px 0 12px;}
.bcSearch b{color:#9d174d;font-size:15px;white-space:nowrap;} .bcSearch b i{color:#dc2626;font-style:normal;font-size:12px;}
.bcSearch input[type=date]{border:1px solid #f9a8d4;border-radius:8px;padding:6px 10px;font:inherit;font-size:15px;background:#fff;color:#111;}
.bcArrow{border:0;background:transparent;color:#db2777;font-size:18px;cursor:pointer;padding:2px 6px;}
.bcSearch #bcGo{background:#ec4899;border-color:#ec4899;color:#fff;padding:7px 22px;}
@media (max-width:700px){ .bcSearch{gap:6px;padding:8px 10px;} .bcSearch input[type=date]{font-size:16px;padding:5px 6px;} .bcSearch #bcGo{padding:6px 14px;} }
/* 결재칸·작업지휘자 이름 입력 */
.svSignBox td{padding:0 2px;vertical-align:middle;}
.svSignIn{width:100%;border:0;background:transparent;text-align:center;font:inherit;font-size:13px;font-weight:700;padding:0;outline:none;}
.svSignIn:focus,.svBossIn:focus{background:#fffde8;}
.svBossCell{white-space:nowrap;}
.svBossIn{width:140px;border:0;border-bottom:1px dashed #9ca3af;background:transparent;text-align:center;font:inherit;font-weight:700;padding:0 2px;outline:none;}
.svBossTxt{display:inline-block;min-width:140px;text-align:center;font-weight:700;}
.svIn.svSignIn::placeholder,.svBossIn::placeholder{color:#cbd5e1;font-weight:400;}
@media print{ .svSignIn::placeholder,.svBossIn::placeholder{color:transparent !important;} .svBossIn{border-bottom:0 !important;} }
/* 배차표·출퇴근 입력(조장 근태관리 포함): 칸 선은 검은 점선, 머리글 아래는 검은 실선 */
#dpTable thead th{border-bottom:1px solid #111 !important;}
.inTbl th,.inTbl td{border:1px dotted #111 !important;}
.inTbl thead th{border-bottom-style:hidden !important;box-shadow:inset 0 -1px 0 #111;} /* 머리글 아래 선: 겹쳐 두꺼워지지 않게 한 줄(1px)만 */
.inTbl thead th.namehead{box-shadow:inset 0 -1px 0 #111, 2px 0 0 var(--bg) !important;} /* 머리글이 위에 고정돼도 선이 보이게 */
/* 월별 OT현황: 이전달·연월·다음달 + 전체·1조·2조 한 줄 */
.otTopBar{display:flex;align-items:center;gap:6px 14px;flex-wrap:wrap;margin:4px 0 10px;}
.otTopBar .otMonRow{margin:0 !important;}
.otTopBar .otTeamRow{margin:0 !important;gap:6px;flex-wrap:nowrap;}
@media (max-width:700px){
  .otTopBar{flex-wrap:nowrap;gap:4px;margin:2px 0 6px;}
  .otTopBar .otMonRow{gap:3px;flex:0 1 auto;min-width:0;}
  .otTopBar .btn.sm{padding:4px 6px !important;font-size:11.5px !important;white-space:nowrap;}
  .otTopBar .otMonTxt{font-size:13px !important;white-space:nowrap;}
  .otTopBar .otTeamRow{gap:3px;margin-left:auto !important;}
}
/* 배차표 근태 칸: 토요일 만근 표시(분홍 글씨) */
#dpTable .dpMg{color:#db2777;font-weight:800;font-size:12px;white-space:nowrap;}
.inTbl .inMg{margin-left:4px;color:#db2777;font-weight:800;font-size:12.5px;white-space:nowrap;}
@media (max-width:700px){ #dpTable .dpMg{font-size:11px;} }
/* 장비 급여 관리 */
.fcaRep{border-collapse:collapse;font-size:13px;min-width:640px;}
.fcaRep td{border:1px solid #e2e8f0;padding:5px 8px;vertical-align:top;}
.fcaRep td.fcaTitle{font-size:16px;font-weight:900;border:0;padding:4px 0 8px;}
.fcaRep td.fcaSec{font-weight:800;background:#eef2ff;color:#1e3a8a;}
.fcaRep td.fcaTxt{color:#374151;border:0;padding:2px 0;}
.fcaRep tr.fcaGap td{border:0;height:8px;padding:0;}
.fcaRep td.fcaK{font-weight:700;background:#f8fafc;white-space:nowrap;}
.fcaRep td.fcaV{color:#1d4ed8;font-variant-numeric:tabular-nums;}
.fcaRep tr.fcaHdr td{background:#f1f5f9;font-weight:800;color:#111;}
@media (max-width:700px){ .fcaRep{font-size:12px;min-width:0;width:100%;} .fcaRep td.fcaK{white-space:normal;min-width:90px;} .fcaRep td{word-break:keep-all;overflow-wrap:anywhere;} .fcaRep td.fcaN{overflow-wrap:normal;word-break:keep-all;padding-left:5px;padding-right:5px;} }
.fcaRep td.fcaTitle,.fcaRep td.fcaTxt{white-space:normal;}
.eqTbl tr.fcaBase td{background:#f8fafc;font-weight:800;}
.eqBonusBar{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;margin-left:12px;}
.eqBonusIn{display:inline-flex;align-items:center;gap:4px;font-weight:700;font-size:13px;white-space:nowrap;}
.eqBonusIn input[type=checkbox]{width:auto !important;padding:0;}
.eqBonusIn input{width:56px;border:1px solid var(--border);border-radius:7px;padding:4px 6px;text-align:right;font:inherit;background:var(--bg);color:var(--text);}
.eqTbl td.eqBon{color:#047857;background:#f0fdf4;} .eqTbl th.eqBonH{background:#dcfce7;}
@media (max-width:700px){ .eqBonusBar{margin-left:0;order:3;width:100%;} }
.eqTbl{border-collapse:collapse;font-size:12.5px;}
.eqTbl th,.eqTbl td{border:1px solid #cbd5e1;padding:4px 6px;text-align:center;white-space:nowrap;}
.eqTbl thead th{background:#f1f5f9;font-weight:800;line-height:1.2;}
.eqTbl td.eqN{text-align:right;font-variant-numeric:tabular-nums;}
.eqTbl td.eqTot{font-weight:800;color:#1d4ed8;background:#eff6ff;}
.eqTbl td.eqDed{color:#b91c1c;}
.eqTbl td.eqNet{font-weight:800;color:#be185d;background:#fdf2f8;}
.eqTbl td.eqFut{background:#f8fafc;}
.eqTbl tfoot td{font-weight:800;background:#f8fafc;border-top:2px solid #111;}
.eqBar{flex-wrap:wrap;gap:6px;}
@media (max-width:700px){ .eqTbl{font-size:11.5px;} .eqTbl th,.eqTbl td{padding:3px 4px;}
  .eqTbl td.namecell,.eqTbl thead th:nth-child(3){position:sticky;left:0;z-index:2;background:#fff;box-shadow:1px 0 0 #94a3b8;} .eqTbl thead th:nth-child(3){background:#f1f5f9;} } /* 휴대폰: 옆으로 밀어도 성명 고정 */
/* 경위서·학자금 메일 보내기 */
/* 받는 사람 10칸(한 줄에 두 명) */
.mtGrid{display:grid;grid-template-columns:1fr 1fr;gap:6px;}
.mtIn{width:100%;min-width:0;box-sizing:border-box;border:1px solid var(--border);border-radius:8px;padding:7px 9px;background:var(--bg);color:var(--text);font:inherit;font-size:13.5px;}
.mtView .mtCell{border:1px dashed var(--border);border-radius:8px;padding:7px 9px;background:var(--bg);font-size:13.5px;word-break:break-all;}
.mtSave{display:flex;justify-content:flex-end;margin-top:6px;}
.docSel{border:1px solid var(--border);border-radius:8px;padding:7px 10px;background:var(--surface);color:var(--text);font:inherit;font-weight:700;font-size:14px;}
.dmToRow{display:flex;gap:6px;align-items:center;} .dmToRow .dmIn{flex:1;min-width:0;}
.dmToView{border:1px dashed var(--border);border-radius:8px;padding:8px 10px;background:var(--bg);font-size:14px;word-break:break-all;}
@media (min-width:1100px){ /* PC에서 서류를 하나만 고르면 메일 칸을 서류 오른쪽에 */
  .docArea.one{display:flex;gap:18px;align-items:flex-start;}
  .docArea.one .docMailRow{flex:1 1 360px;margin-top:30px;min-width:340px;}
  .docArea.one .docMailRow .docMail{flex:1 1 100%;max-width:560px;}
}
.docMailRow{display:flex;flex-wrap:wrap;gap:14px;margin-top:16px;align-items:flex-start;}
.docMailRow .docMail{flex:1 1 380px;max-width:640px;margin:0;}
.docMail h3{margin:0 0 10px;}
.docMail .dmField{margin-bottom:10px;min-width:0;}
.docMail .dmField label{font-size:12.5px;font-weight:700;}
.docMail .dmIn{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:8px;padding:8px 10px;background:var(--bg);color:var(--text);font:inherit;font-size:14px;}
.docMail textarea.dmIn{resize:vertical;min-height:80px;}
.dmSub{font-weight:400;font-size:12px;color:var(--text-muted);}
.dmFileRow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.dmFileBtn{cursor:pointer;}
.dmFiles{list-style:none;margin:8px 0 0;padding:0;display:flex;flex-direction:column;gap:4px;}
.dmFiles li{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:5px 8px;font-size:13px;}
.dmFiles li span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0;} .dmFiles i{color:var(--text-muted);font-style:normal;}
.dmDel{border:0;background:transparent;color:#b91c1c;font-weight:800;cursor:pointer;font-size:14px;}
.dmFoot{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-top:4px;}
@media (max-width:700px){ .docMailRow .docMail{flex:1 1 100%;max-width:none;} .docMail .dmIn{font-size:16px;} }
@media print{ .docMailRow{display:none !important;} }
.legend{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;font-size:11.5px;color:var(--text-muted);align-items:center;}
.legend .sw{display:inline-flex;align-items:center;gap:4px;}

.empty{color:var(--text-muted);font-size:12.5px;padding:20px;text-align:center;border:1px dashed var(--border);border-radius:10px;}
.hint{font-size:11.5px;color:var(--text-muted);margin-top:8px;}
.note{background:var(--amber-soft);border:1px solid var(--amber-line);color:var(--amber);border-radius:8px;
  padding:9px 12px;font-size:12px;margin-bottom:14px;}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--text);color:var(--surface);
  padding:9px 16px;border-radius:8px;font-size:12.5px;z-index:400;opacity:0;pointer-events:none;transition:opacity .25s;}
.toast.show{opacity:1;}

@media (max-width:860px){
  .menu-btn{display:flex;align-items:center;justify-content:center;}
  nav#nav{position:fixed;left:0;top:0;bottom:0;transform:translateX(-100%);transition:transform .2s;
    z-index:360;padding-top:calc(14px + env(safe-area-inset-top,0px));padding-bottom:calc(30px + env(safe-area-inset-bottom,0px));box-shadow:0 0 24px rgba(0,0,0,.25);}
  nav#nav.open{transform:translateX(0);}
  .scrim{z-index:350;}
  .scrim.show{display:block;}
  main#content{padding:16px 14px 50px;}
}

/* 조장관리·UNION 시트 고르기 팝업 */
.sheetPopScrim{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:600;display:flex;align-items:center;justify-content:center;padding:16px;}
.sheetPop{background:var(--surface);color:var(--text);border-radius:14px;width:100%;max-width:340px;max-height:calc(100vh - 32px);overflow:auto;box-shadow:0 12px 36px rgba(0,0,0,.28);}
.sheetPopHd{display:flex;align-items:center;justify-content:space-between;padding:12px 14px;background:#fce7f3;color:#9d174d;font-size:16px;position:sticky;top:0;}
.sheetPopX{border:0;background:transparent;color:#9d174d;font-size:18px;font-weight:800;cursor:pointer;padding:2px 6px;}
.sheetPopList{display:flex;flex-direction:column;padding:8px;gap:4px;}
.sheetPopItem{display:flex;align-items:center;gap:10px;width:100%;text-align:left;border:0;background:transparent;color:var(--text);font:inherit;font-size:15px;padding:12px 12px;border-radius:10px;cursor:pointer;}
.sheetPopItem:hover{background:#fce7f3;color:#be185d;}
.sheetPopItem.on{background:#ec4899;color:#fff;font-weight:700;}
.sheetPopIc{width:24px;text-align:center;font-size:18px;}
/* UNION 시트 고르기 */
.unionBar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:0 0 14px;padding:10px 12px;background:#fdf2f8;border:1px solid #fbcfe8;border-radius:12px;}
.unionBarT{color:#9d174d;font-size:13px;margin-right:4px;white-space:nowrap;flex:none;}
.unionChip{display:inline-flex;align-items:center;gap:5px;border:1px solid #fbcfe8;background:#fff;color:#9d174d;border-radius:999px;padding:6px 12px;font:inherit;font-size:12.5px;font-weight:700;cursor:pointer;white-space:nowrap;}
.unionChip.on{background:#db2777;border-color:#db2777;color:#fff;}
.unionGrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;}
.unionCard{display:flex;flex-direction:column;align-items:center;gap:8px;padding:18px 10px;border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);font:inherit;font-size:14px;cursor:pointer;}
.unionCard:hover{border-color:#f472b6;background:#fdf2f8;}
.unionIc{font-size:26px;}
@media (max-width:520px){ .unionBar{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;} .unionGrid{grid-template-columns:repeat(2,minmax(0,1fr));} }

/* SNCT UNION 로그인 전 화면 */
.unGate{display:flex;justify-content:center;padding:40px 16px;}
.unGateCard{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:28px 22px;max-width:380px;width:100%;text-align:center;box-shadow:0 4px 18px rgba(157,23,77,.12);}
.unGateLogo{font-size:42px;line-height:1;}
.unGateCard h2{margin:8px 0 6px;color:#9d174d;font-size:22px;letter-spacing:.5px;}
.unGateCard p{margin:6px 0;color:var(--text-muted);line-height:1.55;}
.unGateBtn{background:#9d174d !important;border-color:#9d174d !important;color:#fff !important;font-size:16px;padding:10px 22px;margin-top:12px;}
/* UNION WORK 규정 보기 */
.uwHead{display:flex;flex-direction:column;gap:3px;padding:14px 16px;border-radius:12px;background:#fdf2f8;border:1px solid #fbcfe8;margin-bottom:10px;}
.uwHead b{font-size:20px;color:#9d174d;letter-spacing:.5px;}
.uwHead span{font-size:12px;color:var(--text-muted);}
.uwTitleRow{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0;}
.uwSubIn{font:inherit;font-size:13px;color:var(--text);background:#fff;border:1px solid #fbcfe8;border-radius:8px;padding:6px 10px;flex:1 1 220px;min-width:0;max-width:420px;}
.uwSubIn:focus{border-color:#ec4899;outline:none;box-shadow:0 0 0 2px #fce7f3;}
.uwSubIn::placeholder{color:#c08aa5;}
.uwTitleRow .uwSubTxt{font-size:13px;color:var(--text-muted);}
@media (max-width:520px){ .uwTitleRow{gap:8px;} .uwSubIn{font-size:16px;padding:5px 8px;flex:1 1 120px;} }   /* 휴대폰에서도 제목 옆에 */
.uwBar{position:sticky;top:0;z-index:5;display:flex;gap:8px;flex-wrap:wrap;padding:8px 0;background:var(--bg);}
.uwBar input{flex:1 1 200px;min-width:0;border:1px solid var(--border);border-radius:10px;padding:10px 12px;font:inherit;font-size:16px;background:var(--surface);color:var(--text);}
.uwBar select{flex:0 1 220px;min-width:0;max-width:100%;border:1px solid var(--border);border-radius:10px;padding:10px 8px;font:inherit;font-size:14px;background:var(--surface);color:var(--text);}
.uwCount{font-size:12.5px;color:#db2777;font-weight:700;margin:2px 2px 8px;min-height:1em;}
.uwBody{max-width:860px;}
.uwCh{margin:18px 0 8px;padding:8px 12px;border-left:4px solid #ec4899;background:#fdf2f8;border-radius:0 8px 8px 0;font-size:15px;color:#9d174d;scroll-margin-top:70px;}
.uwArt{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:8px;scroll-margin-top:70px;}
.uwArtH{font-weight:800;font-size:14.5px;margin-bottom:6px;color:var(--text);}
.uwL{margin:0 0 4px;font-size:14px;line-height:1.7;color:var(--text);word-break:keep-all;overflow-wrap:anywhere;}
.uwL1{padding-left:12px;} .uwL2{padding-left:28px;} .uwL3{padding-left:44px;}
.uwMark{background:#fde68a;color:inherit;padding:0 1px;border-radius:3px;}
@media (max-width:520px){ .uwHead b{font-size:18px;} .uwArt{padding:10px 12px;} .uwL{font-size:13.5px;} .uwL2{padding-left:20px;} .uwL3{padding-left:32px;} .uwBar select{flex:1 1 100%;} }

/* 규정 수정·출력 */
.uwTools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 8px;}
.uwChanged{font-size:12px;color:#b45309;font-weight:700;}
.uwEditTop{background:#fdf2f8;border:1px solid #fbcfe8;border-radius:12px;padding:12px;margin-bottom:10px;}
.uwEB{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px;margin-bottom:8px;}
.uwEC{background:#fdf2f8;border-color:#fbcfe8;}
.uwERow{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-bottom:6px;}
.uwETag{flex:none;font-size:11px;font-weight:800;color:#db2777;background:#fce7f3;border-radius:6px;padding:3px 7px;}
.uwEIn{flex:1 1 180px;min-width:0;border:1px solid var(--border);border-radius:8px;padding:8px 10px;font:inherit;font-size:16px;background:var(--bg);color:var(--text);}
.uwETa{width:100%;box-sizing:border-box;border:1px solid var(--border);border-radius:8px;padding:8px 10px;font:inherit;font-size:15px;line-height:1.6;background:var(--bg);color:var(--text);resize:vertical;}
.uwSaveBar{position:sticky;bottom:0;display:flex;gap:8px;flex-wrap:wrap;padding:10px 0;background:var(--bg);z-index:6;}
#uwPrint{display:none;}
@media print{
  @page{size:A4;margin:18mm 17mm 18mm;}
  body.printing-uw > *:not(#uwPrint){display:none !important;}
  body.printing-uw #uwPrint{display:block !important;position:static !important;}
  body.printing-uw #uwPrint, body.printing-uw #uwPrint *{visibility:visible !important;}
  body.printing-uw{background:#fff !important;}
  #uwPrint{font-family:"Batang","바탕","Noto Serif KR","Nanum Myeongjo",serif;color:#000;font-size:10.5pt;line-height:1.65;}
  .uwPCover{text-align:center;margin:30mm 0 18mm;}
  .uwPTitle{font-size:24pt;font-weight:800;letter-spacing:8pt;}
  .uwPSub{margin-top:6mm;font-size:10.5pt;color:#333;}
  .uwPCh{font-size:13pt;font-weight:800;text-align:center;margin:8mm 0 4mm;break-after:avoid;page-break-after:avoid;}
  .uwPArt{margin:0 0 3.5mm;break-inside:avoid;page-break-inside:avoid;}
  .uwPH{font-weight:800;margin-bottom:1mm;}
  .uwPL{margin:0 0 .8mm;word-break:keep-all;}
  .uwPL1{padding-left:4mm;} .uwPL2{padding-left:9mm;} .uwPL3{padding-left:14mm;}
  .uwPEnd{text-align:center;font-weight:800;font-size:12pt;margin-top:12mm;letter-spacing:2pt;}
}

/* 조합원 명부 */
.uwmTabs{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:4px;}
.uwmSum{font-size:12px;color:var(--text-muted);margin-left:4px;}
.uwmCnt{font-size:14px;color:#9d174d;}
.uwmImp{cursor:pointer;}
.uwmWrap{overflow-x:auto;-webkit-overflow-scrolling:touch;}
.uwmTbl{width:100%;border-collapse:collapse;font-size:13px;}
.uwmTbl th,.uwmTbl td{border:1px solid var(--border);padding:7px 8px;text-align:center;white-space:nowrap;}
.uwmTbl td.uwm-name{font-weight:800;}
.uwmTbl td.uwm-note,.uwmTbl td.uwm-email{white-space:normal;word-break:break-all;}
.uwmRow{cursor:pointer;} .uwmRow:hover td{background:#fdf2f8;}
.uwmPop{max-width:420px;}
.uwmForm{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px;}
.uwmForm label{display:flex;flex-direction:column;gap:3px;font-size:11.5px;font-weight:700;color:var(--text-muted);min-width:0;}
.uwmForm input{border:1px solid var(--border);border-radius:8px;padding:8px;font:inherit;font-size:16px;background:var(--bg);color:var(--text);min-width:0;width:100%;box-sizing:border-box;}
.uwmBtns{display:flex;gap:6px;flex-wrap:wrap;padding:0 12px 12px;}
.uwGrpBar{align-items:center;gap:8px;margin:0 0 10px;flex-wrap:nowrap;}
/* 조합원 명부 > 양식(근무유공자 추천서·공적조서): 화면은 A4 모양 그대로, 칸을 눌러 입력 */
.uwfBar{align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 8px;}
.uwfDoc{display:flex;flex-direction:column;gap:14px;align-items:center;overflow-x:auto;padding-bottom:6px;}
.uwfPage{width:186mm;max-width:100%;min-height:262mm;background:#fff;color:#111;box-shadow:0 1px 6px rgba(0,0,0,.15);padding:10mm 10mm;box-sizing:content-box;font-family:"Malgun Gothic","맑은 고딕","Apple SD Gothic Neo","Noto Sans KR",sans-serif;font-size:10.5pt;line-height:1.45;}
.uwfIn{display:inline-block;min-width:3em;min-height:1.3em;outline:none;border-radius:3px;background:#fffbea;padding:0 2px;white-space:pre-wrap;word-break:keep-all;overflow-wrap:anywhere;vertical-align:middle;}
.uwfIn:focus{background:#fff3c4;box-shadow:0 0 0 2px #2563eb;}
.uwfML{display:block;width:100%;box-sizing:border-box;min-height:3em;}
.uwfW{min-width:4em;}
.uwfChk{cursor:pointer;font-size:12pt;padding:0 2px;}
.uwfT{width:100%;border-collapse:collapse;table-layout:fixed;margin:0 0 4mm;}
.uwfT th,.uwfT td{border:1px solid #000;padding:1.6mm 1.8mm;vertical-align:middle;text-align:left;}
.uwfT th{font-weight:700;text-align:center;}
.uwfT th small{display:block;font-size:8pt;font-weight:400;}
.uwfC{text-align:center !important;} .uwfR{text-align:right;} .uwfBold .uwfIn{font-weight:800;font-size:12pt;}
.uwfT td.uwfC .uwfIn{text-align:center;}
.uwfT td > .uwfIn:not(.uwfW){width:100%;box-sizing:border-box;}
.uwfTitle{text-align:center;font-size:20pt;font-weight:900;letter-spacing:10pt;margin:6mm 0 6mm;}
.uwfTitleS{font-size:16pt;letter-spacing:4pt;margin:2mm 0 5mm;}
/* 근무유공자 추천서 */
.uwfRecTop{display:flex;align-items:flex-start;justify-content:space-between;margin:2mm 0 6mm;}
.uwfRecTitle{flex:1;text-align:center;font-size:18pt;font-weight:900;letter-spacing:2pt;margin-top:5mm;}
.uwfRecTitle{text-decoration:underline;text-underline-offset:5px;}
.uwfApv{border-collapse:collapse;font-size:9pt;} .uwfApv td{border:1px solid #000;text-align:center;width:16mm;padding:.8mm;} .uwfApv td.uwfApvV{width:7mm;} .uwfApvS td{height:15mm;}
.uwfRec .uwfT th{background:#d9d9d9;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.uwfRec .uwfT td{height:8mm;text-align:center;}
.uwfReason td.uwfBig{height:130mm;vertical-align:middle;}
.uwfReasonTxt{font-size:12pt;font-weight:700;line-height:1.8;text-align:left;}
.uwfFoot{padding:5mm 4mm !important;} .uwfFoot1{text-align:center;margin-bottom:4mm;} .uwfFoot2{text-align:right;margin-bottom:4mm;} .uwfFoot3{text-align:right;letter-spacing:1pt;}
/* 공적조서 */
.uwfM td,.uwfM th{height:9mm;} .uwfM td.uwfL{text-align:left;}
.uwfSum{margin-top:2mm;min-height:32mm;line-height:1.7;}
.uwfSpaced{font-weight:700;}
.uwfConfirm{padding:4mm !important;} .uwfConfirm > div{margin-bottom:5mm;}
.uwfSignLn{display:flex;justify-content:space-between;align-items:center;gap:3mm;font-weight:800;font-size:11.5pt;margin-top:6mm;}
.uwfT td.uwfHd,.uwfHd{text-align:center;font-weight:800;background:#f2f2f2;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.uwfM2 td{height:8mm;}
.uwfMeritCell{vertical-align:top !important;height:150mm;}
.uwfMeritTxt{line-height:1.75;}
.uwfM3 td,.uwfM3 th{height:10mm;font-size:10pt;}
.uwfNote{font-size:9.5pt;margin:0;}
.uwfSub{font-weight:800;margin:0 0 2mm;}
.uwfBox{border:1px solid #000;padding:3mm 4mm;margin:0 0 4mm;font-size:10pt;} .uwfBox p{margin:0 0 2mm;} .uwfBoxT{font-weight:800;text-align:center;margin-bottom:2mm;}
.uwfPledge{margin:4mm 0 8mm;line-height:1.7;}
.uwfDateL{font-size:11pt;margin:0 0 8mm;} .uwfSignL{font-size:11pt;margin:0 0 12mm;}
.uwfTo{font-size:15pt;font-weight:800;}
@media (max-width:700px){ .uwfDoc{align-items:flex-start;} .uwfPage{max-width:none;} }
/* 노동절 장학생 추천서 */
.uwfSchNo{font-size:9pt;}
.uwfS th,.uwfS td{font-size:9.5pt;padding:.6mm 1.4mm;height:6.4mm;line-height:1.3;}
.uwfSch .uwfTitle{font-size:18pt;margin:1mm 0 3mm;}
.uwfSch .uwfT{margin-bottom:1.5mm;}
.uwfS th small{font-size:7.5pt;}
.uwfAtt{font-size:8.3pt;line-height:1.38;}
.uwfPhotoCell{padding:1mm !important;}
.uwfPhotoBox{display:flex;align-items:center;justify-content:center;width:100%;height:33mm;cursor:pointer;color:#555;overflow:hidden;}
.uwfPhotoBox img{width:100%;height:100%;object-fit:cover;}
.uwfSecT{text-align:center !important;font-size:13pt;font-weight:900;letter-spacing:3pt;}
.uwfSmall{font-size:8.3pt;line-height:1.4;}
.uwfSchool > div{margin:1mm 0;}
.uwfRecBlk{text-align:center !important;padding:2mm 3mm !important;} .uwfRecBlk > div{margin:1.3mm 0;}
.uwfToBig{font-size:13pt;font-weight:900;text-align:left;margin-top:3mm !important;}
.uwfNotes{margin-top:1mm;}
.uwfO{display:inline-block;padding:0 4px;border-radius:50%;cursor:pointer;border:1.5px solid transparent;}
.uwfO.on{border-color:#111;}
.uwfWide{min-width:14em;}
.uwfPledgeBox{border:1px solid #000;padding:6mm 6mm;line-height:2;margin-top:6mm;} .uwfPledgeBox p{margin:0 0 3mm;}
.uwfSignBlk{text-align:right;line-height:2.4;font-size:11pt;}
.uwfAgree{font-size:10pt;line-height:1.75;} .uwfAgree p{margin:0 0 3mm;} .uwfAgreeLast{border:1px solid #000;padding:3mm;margin-top:5mm !important;}
.uwfGuide{margin:0 0 10px;border:1px solid var(--border);border-radius:8px;padding:6px 10px;background:var(--surface);font-size:12.5px;line-height:1.6;} .uwfGuide summary{cursor:pointer;font-weight:800;}
/* 경조사비 지급기준(A4 가로) */
.uwfPage.uwfLand{width:277mm;min-height:190mm;padding:8mm 10mm;}
.uwfGsGrid{display:grid;grid-template-columns:40% 1fr;gap:5mm;align-items:start;}
.uwfGsTitle{text-align:center;font-family:"Batang","바탕","Noto Serif KR",serif;font-size:15pt;font-weight:800;text-decoration:underline;text-underline-offset:4px;margin:0 0 1mm;}
.uwfGsDate{text-align:right;font-size:8.5pt;margin:0 0 .8mm;} .uwfGsDate .uwfIn{min-width:6em;}
.uwfGsT{margin:0 !important;} .uwfGsT th,.uwfGsT td{font-size:8.3pt;padding:.4mm 1mm;height:5mm;line-height:1.2;font-family:"Batang","바탕","Noto Serif KR",serif;}
.uwfGsT th{background:#dbeafe;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.uwfGsT td .uwfIn{min-width:1em;width:100%;box-sizing:border-box;}
.uwfGsU col,.uwfGsT{table-layout:auto;}
.uwfGsN{font-size:7.6pt !important;}
.uwfGsNote{font-size:8pt;margin-top:1mm;line-height:1.5;} .uwfGsNote .uwfIn{min-width:0;}
@page uwformL{size:A4 landscape;margin:10mm;}
/* 노동조합현황 정기 통보서(별지 제4호서식) — A4 가로 한 장 */
.uwfNt{font-size:8.4pt;line-height:1.3;}
.uwfNtGrid{display:grid;grid-template-columns:1fr 1fr;gap:5mm;align-items:start;}
.uwfNtTop{font-size:7.5pt;margin-bottom:1mm;}
.uwfNtTitle{border:1px solid #000;text-align:center;font-size:15pt;font-weight:800;padding:2.5mm 0;letter-spacing:1px;}
.uwfNtYr{font-size:9pt;font-weight:700;margin-left:2mm;}
.uwfNtSm{font-size:7pt;margin:.6mm 0 .8mm;}
.uwfNtT{margin:0 0 1.5mm !important;}
.uwfNtT th,.uwfNtT td{font-size:7.6pt;padding:.5mm .8mm;line-height:1.25;height:4.6mm;word-break:keep-all;}
.uwfNtT td.uwfNtL{font-size:7pt;color:#222;border-bottom:none;padding-bottom:0;height:3.6mm;}
.uwfNtT td.uwfNtV{border-top:none;height:8.2mm;padding-left:2mm;}
.uwfNt .uwfNtT td.uwfNtV > .uwfIn{width:auto;}
.uwfNt .uwfNtT td > .uwfIn.uwfNtN{width:auto;min-width:2.2em;}
.uwfNtOff td{height:9mm;}
.uwfNtS td{height:11mm;}
.uwfNt .uwfNtT td .uwfIn{font-size:7.8pt;}
.uwfNtT td.uwfNtV .uwfIn{min-width:1em;}
.uwfNtT th{background:#eee;font-weight:700;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
.uwfNtT th.uwfNtSec{writing-mode:vertical-rl;letter-spacing:2px;background:#f6f6f6;}
.uwfNtT td.uwfC .uwfIn,.uwfNtT td .uwfIn.uwfNtN{min-width:1.6em;}
.uwfNtT .uwfIn.uwfNtN{text-align:center;}
.uwfNtT .uwfChk{font-size:9pt;}
.uwfNtH{font-weight:800;font-size:8.6pt;margin:0 0 .6mm;}
.uwfNtDecl{border:1px solid #000;padding:3mm 3mm 4mm;margin-top:2mm;font-size:8.4pt;line-height:1.6;}
.uwfNtDecl .uwfNtDate{text-align:center;margin:9mm 0 8mm;font-size:9.5pt;}
.uwfNtDecl .uwfNtSign{text-align:right;font-size:9.5pt;}
.uwfNtDecl .uwfIn{min-width:3em;}
@media print{ #uwPrint.uwFormPrint.uwFormLand{width:277mm !important;page:uwformL;} #uwPrint.uwFormPrint .uwfPage.uwfLand{width:277mm;page:uwformL;} }
@page uwform{size:A4;margin:12mm;}
@media print{
  #uwPrint.uwFormPrint{page:uwform;max-width:none !important;width:186mm !important;}
  #uwPrint.uwFormPrint .uwfPage{box-shadow:none;padding:0;min-height:0;width:186mm;break-after:page;page-break-after:always;font-family:"Malgun Gothic","맑은 고딕","Apple SD Gothic Neo","Noto Sans KR",sans-serif;line-height:1.45;}
  #uwPrint.uwFormPrint .uwfPage:last-child{break-after:auto;page-break-after:auto;}
  #uwPrint.uwFormPrint .uwfIn{background:none !important;box-shadow:none !important;}
}
/* UNION > 연도별 타결 */
.stWrap{overflow:auto;-webkit-overflow-scrolling:touch;max-height:calc(100vh - 220px);border:2px solid var(--text);border-radius:10px;background:var(--surface);}
.stTbl{border-collapse:collapse;width:100%;min-width:980px;font-size:12.5px;}
.stTbl th,.stTbl td{border:1px solid #c4cad3;padding:4px 6px;text-align:center;vertical-align:middle;}
.stTbl thead th{position:sticky;top:0;z-index:2;background:#fce7f3;color:#9d174d;font-weight:800;}
.stTbl tr.stYearTop > td{border-top:2px solid #111;}
.stTbl td.stYear{font-weight:900;color:#9d174d;white-space:nowrap;background:#fdf2f8;position:relative;}
.stTbl td.stC0{font-weight:800;white-space:nowrap;} .stTbl td.stC1{font-weight:800;color:#1d4ed8;} .stTbl td.stC2{color:#b45309;font-weight:700;}
.stTbl td.stC6{text-align:left;min-width:220px;} .stTbl td.stRate{font-weight:900;color:#dc2626;white-space:nowrap;}
.stIn{display:inline-block;min-width:2.5em;min-height:1.2em;outline:none;border-radius:3px;padding:0 2px;}
.stIn:hover{background:#fffbea;} .stIn:focus{background:#fff3c4;box-shadow:0 0 0 2px #2563eb;}
.stDel{display:block;margin:3px auto 0;border:0;background:transparent;color:#dc2626;font-size:11px;cursor:pointer;}
@media print{ #uwPrint.uwFormPrint .stTbl{min-width:0;font-size:8.6pt;} #uwPrint.uwFormPrint .stTbl th,#uwPrint.uwFormPrint .stTbl td{border:1px solid #000;padding:1mm 1.2mm;} #uwPrint.uwFormPrint .stTbl thead th{position:static;-webkit-print-color-adjust:exact;print-color-adjust:exact;} .stPHd{font-size:13pt;font-weight:800;text-align:center;margin:0 0 3mm;} .stPFt{font-size:8.5pt;text-align:right;margin-top:2mm;} #uwPrint .stTbl tr{break-inside:avoid;} }
/* 조합원 명부: 명부 / 표창 탭 */
.uwmVTabs{display:flex;gap:0;margin:0 0 10px;border:1.5px solid #db2777;border-radius:10px;overflow:hidden;max-width:560px;}
.uwmVTab{flex:1 1 0;border:0;background:var(--surface);color:#db2777;font:inherit;font-weight:800;font-size:13.5px;padding:8px 6px;cursor:pointer;white-space:nowrap;}
.uwmVTab + .uwmVTab{border-left:1.5px solid #db2777;} .uwmVTab.on{background:#db2777;color:#fff;}
.uwAwGrid{display:flex;gap:14px;flex-wrap:wrap;align-items:flex-start;}
.uwAwBox{flex:1 1 320px;min-width:0;}
.uwAwHd{display:flex;align-items:center;gap:8px;margin:0 0 6px;} .uwAwHd b{font-size:14px;color:#9d174d;} .uwAwHd .btn{margin-left:auto;}
.uwAwTbl td.uwAwName{font-weight:800;}
.uwAwRow{cursor:pointer;} .uwAwRow:hover td{background:#fdf2f8;}
@media (max-width:700px){
  .uwAwTbl thead{display:table-header-group !important;} .uwAwTbl{display:table !important;} .uwAwTbl tbody{display:table-row-group !important;} .uwAwTbl tr{display:table-row !important;border:0 !important;padding:0 !important;margin:0 !important;background:none !important;}
  .uwAwTbl td{display:table-cell !important;border:1px solid var(--border) !important;padding:6px 6px !important;text-align:center !important;width:auto !important;} .uwAwTbl td::before{content:none !important;}
}
@media print{ .uwPAwSec{margin-top:6mm;break-inside:avoid;} .uwPAwT{font-weight:800;font-size:11pt;margin:0 0 2mm;} .uwPAw{font-size:10pt !important;} } .uwGrpBar .docSel{min-width:0;}
/* 비고 사진 */
.uwmThumb{width:34px;height:40px;object-fit:cover;object-position:center top;border-radius:4px;vertical-align:middle;border:1px solid var(--border);}
.uwmTbl td.uwm-photo{padding:3px 6px;width:46px;}
@media (max-width:700px){ .uwmTbl td.uwm-photo{padding:3px 0;width:100%;} .uwmTbl td.uwm-photo:empty{display:none;} }
.uwmThumbE{display:inline-flex;align-items:center;justify-content:center;font-size:16px;background:var(--bg);}
.uwmPhoto{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:0 12px 12px;}
.uwmPhLbl{width:100%;font-size:11.5px;font-weight:700;color:var(--text-muted);}
.uwmPhPrev{width:84px;height:96px;border:1px dashed var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;font-size:11px;color:var(--text-muted);background:var(--bg);}
.uwmPhPrev img{width:100%;height:100%;object-fit:cover;object-position:center top;}
.uwmPhBtns{display:flex;gap:6px;flex-wrap:wrap;}
/* 사진명단 고르기 창 */
.uwcPop{max-width:460px;}
.uwcBar{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:10px 12px 6px;}
.uwcCnt{margin-left:auto;font-size:12.5px;font-weight:800;color:#9d174d;}
.uwcOpt{display:flex;gap:6px;align-items:flex-start;padding:0 12px 6px;font-size:12px;color:var(--text-muted);cursor:pointer;} .uwcOpt input{width:16px;height:16px;flex:none;margin:1px 0 0;}
.uwcList{max-height:min(56vh,460px);overflow:auto;padding:4px 12px 10px;display:grid;grid-template-columns:1fr 1fr;gap:4px;}
.uwcItem{display:flex;align-items:center;gap:6px;padding:6px 8px;border:1px solid var(--border);border-radius:8px;font-size:13px;cursor:pointer;min-width:0;}
.uwcItem.on{background:#fdf2f8;border-color:#f9a8d4;}
.uwcItem input{width:18px;height:18px;flex:none;margin:0;}
.uwcItem b{white-space:nowrap;} .uwcItem span{color:var(--text-muted);font-size:11.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;} .uwcItem i{margin-left:auto;font-style:normal;font-size:12px;} .uwcItem i.no{color:var(--text-muted);}
@media (max-width:700px){ .uwcList{grid-template-columns:1fr;} }
/* 사진명단 출력: A4 가로, 4명 × 6줄. 카드 = 사진(2열×4행) + 직위·성명(3열) — 엑셀 열너비 6.5 ≒ 13.2mm, 행높이 19 ≒ 6.7mm */
@page uwcard{size:A4 landscape;margin:10mm;}
@media print{
  #uwPrint.uwCardPrint{page:uwcard;max-width:none !important;width:277mm !important;font-family:"Malgun Gothic","맑은 고딕","Apple SD Gothic Neo","Noto Sans KR",sans-serif;line-height:1.2;}
  .uwCardPage{display:grid;grid-template-columns:repeat(4,66.1mm);column-gap:4.2mm;row-gap:5mm;align-content:start;break-after:page;page-break-after:always;}
  .uwCardPage:last-child{break-after:auto;page-break-after:auto;}
  .uwCard{display:flex;width:66.1mm;height:26.8mm;break-inside:avoid;page-break-inside:avoid;}
  .uwCPh{width:26.5mm;height:26.8mm;flex:none;overflow:hidden;background:#fff;}
  .uwCPh img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block;}
  .uwCPh:empty{border:.35mm solid #000;border-right:0;box-sizing:border-box;}   /* 사진이 없으면 사진 칸 테두리만(손으로 붙이기용) */
  .uwCLb{flex:1;border:.35mm solid #000;display:flex;flex-direction:column;box-sizing:border-box;}
  .uwCPos{height:50%;border-bottom:.35mm solid #000;display:flex;align-items:center;justify-content:center;font-size:11pt;font-weight:800;letter-spacing:.5pt;}
  .uwCName{flex:1;display:flex;align-items:center;justify-content:center;font-size:19pt;font-weight:900;white-space:nowrap;}
  .uwCPos.p5{font-size:10pt;letter-spacing:0;} .uwCPos.p7{font-size:8.5pt;letter-spacing:0;}
  .uwCName.n3{letter-spacing:.45em;padding-left:.45em;} .uwCName.n4{letter-spacing:.06em;} .uwCName.n5{font-size:15pt;}
}
@media (max-width:700px){
  .uwmTbl thead{display:none;}
  .uwmTbl, .uwmTbl tbody, .uwmTbl tr, .uwmTbl td{display:block;width:100%;box-sizing:border-box;}
  .uwmTbl tr{border:1px solid var(--border);border-radius:10px;margin-bottom:8px;padding:6px 10px;background:var(--surface);}
  .uwmTbl td{border:0;padding:3px 0;text-align:left;white-space:normal;display:flex;gap:8px;}
  .uwmTbl td::before{content:attr(data-l);flex:none;width:68px;color:var(--text-muted);font-size:11.5px;font-weight:700;}
  .uwmTbl td:empty{display:none;}
  .uwmForm{grid-template-columns:1fr;}
}
@media print{
  .uwPMemHd{text-align:center;margin-bottom:5mm;}
  .uwPMemT{font-size:15pt;font-weight:800;}
  .uwPMemD{font-size:9.5pt;margin-top:1.5mm;}
  #uwPrint{width:100% !important;max-width:176mm !important;}
  .uwPMem{width:100% !important;border-collapse:collapse;font-size:8.5pt;table-layout:fixed;}
  .uwPMem .uwp-no{width:6%;} .uwPMem .uwp-reg{width:9%;} .uwPMem .uwp-emp{width:11%;} .uwPMem .uwp-part{width:11%;} .uwPMem .uwp-pos{width:12%;} .uwPMem .uwp-name{width:10%;} .uwPMem .uwp-tel{width:16%;white-space:nowrap !important;} .uwPMem .uwp-join,.uwPMem .uwp-leave{width:12%;white-space:nowrap !important;}
  .uwPMem th,.uwPMem td{border:1px solid #000;padding:1.4mm 1.2mm;text-align:center;white-space:normal !important;word-break:keep-all;overflow-wrap:anywhere;min-width:0 !important;}
  .uwPMem th{background:#eee !important;-webkit-print-color-adjust:exact;print-color-adjust:exact;}
  .uwPMem tr{break-inside:avoid;}
}

/* 업무규정·취업규칙 */
.uwPt{margin:22px 0 8px;padding:10px 14px;border-radius:10px;background:#9d174d;color:#fff;font-size:16px;scroll-margin-top:70px;}
.uwRg{margin:16px 0 8px;padding:9px 12px;border-radius:8px;background:#fce7f3;color:#9d174d;font-size:15.5px;border:1px solid #fbcfe8;scroll-margin-top:70px;}
.uwSec{font-size:14px;border-left-width:2px;margin-left:8px;}
.uwPre{font-family:ui-monospace,"D2Coding","Nanum Gothic Coding",Consolas,monospace;font-size:12px;line-height:1.55;white-space:pre;overflow-x:auto;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:8px 10px;margin:4px 0 8px;-webkit-overflow-scrolling:touch;}
@media print{
  .uwPPt{font-size:17pt;text-align:center;margin:0 0 8mm;padding-top:40mm;break-before:page;page-break-before:always;break-after:avoid;}
  .uwPRg{font-size:14pt;text-align:center;margin:0 0 5mm;break-before:page;page-break-before:always;break-after:avoid;}
  .uwPPt + .uwPRg{break-before:page;page-break-before:always;}
  .uwPCh.sec{font-size:11.5pt;}
  .uwPPre{font-family:"D2Coding","Nanum Gothic Coding","Courier New",monospace;font-size:8pt;line-height:1.4;white-space:pre-wrap;margin:1mm 0 2mm;border:0;}
}
/* ===== 시트마다 제목 상자 왼쪽에 노동조합 로고 ===== */
.uwHead{padding-left:76px !important;min-height:58px;justify-content:center;background-image:url(data:image/png;base64,) !important;background-repeat:no-repeat !important;background-position:16px center !important;background-size:48px auto !important;}
@media (max-width:700px){ .uwHead{padding-left:62px !important;background-position:12px center !important;background-size:40px auto !important;} }
/* ===== UNION > 회계(account.html을 화면 가득) ===== */
main#content.acctMode{padding:0 !important;overflow:hidden;display:flex;flex-direction:column;}
.acctFrame{border:0;width:100%;flex:1 1 auto;min-height:0;display:block;background:#f1f5f9;}
/* ===== UNION > 캘린더 ===== */
body:not(.isUnion) nav#nav .navPriv{display:none !important;}   /* 보기 전용: UNION 전용 메뉴는 안 보임(로그인은 위쪽 [UNION 로그인]) */
.calTop{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin:0 0 10px;}
.calNav{display:flex;align-items:center;gap:4px;}
.calNav button{border:1px solid var(--border);background:var(--surface);color:var(--text);border-radius:8px;width:36px;height:36px;font-size:18px;line-height:1;cursor:pointer;}
.calYm{font-size:18px;font-weight:800;min-width:118px;text-align:center;letter-spacing:-.02em;}
.calTop .spacer{flex:1 1 auto;}
.calLegend{display:flex;gap:10px;flex-wrap:wrap;font-size:11.5px;color:var(--text-muted);margin:0 0 8px;}
.calLegend i{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:4px;vertical-align:-1px;}
.calGrid{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--border);gap:1px;}
.calDow{background:var(--surface);text-align:center;font-size:12px;font-weight:800;padding:7px 0;color:var(--text-muted);}
.calDow.sun{color:#dc2626;} .calDow.sat{color:#2563eb;}
.calCell{background:var(--surface);min-height:max(104px, calc((100dvh - 330px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)) / var(--calRows,5)));padding:5px 5px 6px;display:flex;flex-direction:column;gap:3px;cursor:pointer;min-width:0;position:relative;text-align:left;border:0;font:inherit;color:inherit;}
.calCell:hover{background:var(--btn-soft);}
.calCell.out{background:var(--bg);cursor:default;}
.calCell.out .calNum{opacity:.35;}
.calCell.sel{box-shadow:inset 0 0 0 2px var(--btn);}
.calNumRow{display:flex;align-items:center;gap:4px;min-width:0;}
.calNum{font-size:13px;font-weight:800;line-height:22px;min-width:22px;height:22px;text-align:center;border-radius:11px;flex:none;}
.calCell.sat .calNum{color:#2563eb;}
.calCell.sun .calNum,.calCell.hol .calNum{color:#dc2626;}
.calCell.today .calNum{background:var(--btn);color:#fff;}
.calHol{font-size:10.5px;color:#dc2626;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0;}
.calEv{font-size:11.5px;line-height:1.3;padding:2px 5px;border-radius:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600;border-left:3px solid currentColor;}
.calEv b{font-weight:800;margin-right:3px;}
.calGrid .calEv{color:#111827 !important;background:none !important;border:0 !important;padding:1px 2px;border-radius:0;font-weight:600;}   /* 달력 칸 안 일정: 검은 글씨만(색 상자·왼쪽 줄 없음) */
.calGrid .calEv b{color:#111827;}
.calMore{font-size:11px;color:var(--text-muted);font-weight:700;padding-left:3px;}
.calDots{display:none;gap:3px;flex-wrap:wrap;padding:0 2px;}
.calDots i{width:7px;height:7px;border-radius:50%;display:block;}
.calC-gen{color:#be185d;background:#fdf2f8;} .calC-meet{color:#1d4ed8;background:#eff6ff;} .calC-nego{color:#b91c1c;background:#fef2f2;}
.calC-event{color:#047857;background:#ecfdf5;} .calC-edu{color:#b45309;background:#fffbeb;} .calC-etc{color:#475569;background:#f1f5f9;}
.calD-gen{background:#db2777;} .calD-meet{background:#2563eb;} .calD-nego{background:#dc2626;} .calD-event{background:#059669;} .calD-edu{background:#d97706;} .calD-etc{background:#64748b;}
.calDay{margin-top:12px;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:12px 14px;}
.calDayHd{display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;}
.calDayHd b{font-size:15px;}
.calDayHd .calHolTag{font-size:11.5px;color:#dc2626;font-weight:700;}
.calDayHd .spacer{flex:1 1 auto;}
.calList{display:flex;flex-direction:column;gap:6px;}
.calItem{display:flex;gap:10px;align-items:flex-start;padding:9px 10px;border-radius:10px;border:1px solid var(--border);background:var(--surface);cursor:pointer;text-align:left;font:inherit;color:inherit;width:100%;}
.calItem:hover{border-color:var(--btn-line);background:var(--btn-soft);}
.calItemBar{width:4px;align-self:stretch;border-radius:2px;flex:none;}
.calItemMain{min-width:0;flex:1;}
.calItemT{font-weight:800;font-size:14px;word-break:break-all;}
.calItemS{font-size:12px;color:var(--text-muted);margin-top:2px;}
.calItemM{font-size:12.5px;margin-top:4px;white-space:pre-wrap;word-break:break-all;}
.calEmpty{font-size:12.5px;color:var(--text-muted);padding:6px 2px;}
.calMonthHd{margin:16px 0 8px;font-size:14px;font-weight:800;}
.calMonthDate{font-size:12px;font-weight:800;color:var(--text-muted);margin:8px 0 4px;}
.calPop{max-width:420px;}
.calDayBody{padding:12px;max-height:55vh;overflow:auto;}
.sheetPopHd .calHolTag{font-size:12px;color:#dc2626;font-weight:700;margin-left:4px;}
.calForm{display:grid;grid-template-columns:1fr 1fr;gap:9px;padding:12px;}
.calForm label{display:flex;flex-direction:column;gap:3px;font-size:11.5px;font-weight:700;color:var(--text-muted);min-width:0;}
.calForm label.full{grid-column:1 / -1;}
.calForm input,.calForm select,.calForm textarea{border:1px solid var(--border);border-radius:8px;padding:8px;font:inherit;font-size:16px;background:var(--bg);color:var(--text);min-width:0;width:100%;box-sizing:border-box;}
.calForm textarea{min-height:80px;resize:vertical;}
.calColors{display:flex;gap:6px;flex-wrap:wrap;}
.calColors button{border:1px solid var(--border);border-radius:16px;padding:5px 10px;font:inherit;font-size:12.5px;font-weight:700;cursor:pointer;}
.calColors button.on{box-shadow:0 0 0 2px currentColor;}
.calPopBtns{display:flex;gap:8px;padding:0 12px 14px;flex-wrap:wrap;}
.calPopBtns .spacer{flex:1 1 auto;}
@media (max-width:700px){
  .calCell{min-height:max(64px, calc((100dvh - 330px - env(safe-area-inset-top,0px) - env(safe-area-inset-bottom,0px)) / var(--calRows,5)));padding:3px 2px 4px;}   /* 휴대폰: 달력이 화면 아래까지 차게 */
  .calGrid .calEv{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;white-space:normal;word-break:break-all;font-size:10px;line-height:1.2;padding:0 1px;}   /* 휴대폰도 * 일정 글자(2줄까지) */
  .calMore{font-size:9.5px;padding-left:1px;}
  .calDots{display:none;}
  .calHol{font-size:9px;text-align:center;}
  .calNumRow{flex-direction:column;gap:0;}
  .calNum{font-size:12.5px;}
  .calYm{font-size:16px;min-width:104px;}
  .calForm{grid-template-columns:1fr;}
}
</style>
</head>
<body>
<header class="app">
  <button class="menu-btn" id="menuBtn" aria-label="메뉴">☰</button>
  <h1><svg class="appLogo" viewBox="10 13 66 46" aria-hidden="true"><g fill="none" stroke="#e00000" stroke-width="2.6" stroke-linecap="square"><line x1="13.96" y1="40.48" x2="50.04" y2="17.52"/><line x1="35.96" y1="17.52" x2="72.04" y2="40.48"/><line x1="72.04" y1="31.52" x2="35.96" y2="54.48"/><line x1="50.04" y1="54.48" x2="13.96" y2="31.52"/><path d="M33 42 L37.3 31 L40.6 39.5"/><circle cx="47.6" cy="36.6" r="4.9"/></g></svg>SNCT 노동조합</h1>
  <div class="sub" id="headerSub" style="display:none;"></div>
  <div class="spacer"></div>
  <div class="zoomFab" id="zoomFab" aria-label="화면 확대·축소"><button type="button" data-zoom="-" aria-label="축소">−</button><button type="button" data-zoom="0" id="zoomFabPct" aria-label="원래 크기">100%</button><button type="button" data-zoom="+" aria-label="확대">＋</button></div>
  <div class="zoomCtl" id="zoomCtl" title="화면 확대·축소 (Ctrl + 마우스 휠, Ctrl + / Ctrl − 도 됨)"><button type="button" data-zoom="-" aria-label="축소">−</button><button type="button" data-zoom="0" id="zoomPct" aria-label="원래 크기">100%</button><button type="button" data-zoom="+" aria-label="확대">＋</button></div>
  <div class="status" id="dbStatus"><span class="dot off"></span>연결 확인 중…</div>
</header>
<div class="layout">
  <nav id="nav">
    <div class="navttl">근태관리</div>
    <a data-view="dispatch"><span class="ic">🚧</span>배차표</a>
    <a data-view="input"><span class="ic">✏️</span>출퇴근 입력</a>
    <a data-view="combined"><span class="ic">📋</span>근태관리</a>
    <a data-view="ot"><span class="ic">🧮</span>월별 OT현황</a>
    <a data-view="splan"><span class="ic">📋</span>지원계획표</a>
    <a data-view="accident"><span class="ic">📝</span>경위서&amp;학자금</a>
    <a class="navttl navUnion" data-view="leaderhub" data-role-section="leader" style="margin-top:10px;">조장관리 <span class="navUnionArr">›</span></a>
    <a class="navttl navUnion" id="navUnionSite" href="#" target="_blank" rel="noopener" data-role-section="union" style="margin-top:10px;">SNCT 노동조합 <span class="navUnionArr">↗</span></a>
    <a class="navttl navUnion" data-view="unionhub" data-role-section="union" style="margin-top:10px;">UNION WORK <span class="navUnionArr">›</span></a>
  </nav>
  <main id="content"></main>
</div>
<div class="scrim" id="scrim"></div>
<div class="toast" id="toast"></div>

<script>
/* ========================= 상태 ========================= */
// ★ 같은 파일로 두 사이트를 만듦: <html data-site="union">이면 'SNCT UNION'(조합원 명부·양식·규약&규정·취업&업무만, UNION 로그인 필수)
//   그 밖에는 근태관리 앱(UNION 메뉴는 빠지고 SNCT UNION 사이트로 가는 링크만)
const SITE_UNION = document.documentElement.dataset.site === 'union';
const UNION_SITE_URL = 'https://snctunion-svg.github.io/SNCT-UNION/';   // SNCT UNION 사이트 주소(github 저장소 이름이 다르면 여기만 바꾸기)
let VIEW = SITE_UNION ? 'uwcal' : 'dispatch'; // 처음 열면 배차표(SNCT UNION은 조합원 명부)
let db = null, userCap = null, dbReady = false;
let employees = [];        // [{id,name,part,order,active}]
let holidays = {};         // dateStr -> name
let codeDefs = {};         // code -> {code,label}
const FORCED_HIDDEN = ['IN','OFF','VA']; // 요청으로 삭제(목록·선택창에서 숨김)
let hiddenCodes = new Set(FORCED_HIDDEN); // 근무코드/근태코드 중 사용자가 "삭제"해서 목록·선택창에서 숨긴 코드들
let attendance = {};       // `${date}_${empId}` -> record
let curYear = 2026, curMonth = 9; // 표시 중인 년/월 (grid + input 기본값)
let unsub = { emp:null, hol:null, code:null, att:null, dispatch:null, splan:null, codeStats:null, otMatrix:null, hiddenCodes:null };
let prefill = null; // {date, employeeId} - 그리드에서 셀 클릭 시 입력화면 프리필
let inputViewDate = null, inputViewEmp = null; // 출퇴근 입력화면에서 마지막으로 보던 날짜/직원 (재렌더 시에도 유지)
let combinedTeamFilter = (()=>{ try{ return localStorage.getItem('snct_team_cmb')||''; }catch(e){ return ''; } })(); // 근태관리 표: '' (전체), '1', '2' — 기기에 기억
let combinedYm = null; // 근태관리 아래 '월별 근태코드' 표의 연/월 {y,m}
let teamOtFilter = ''; // 조별 월간집계: '' (전체), '1', '2'
let otMatrixStart = null, otMatrixEnd = null; // 월별 OT현황: 작업기간
let otPayYear = null, otPayMonth = null; // 월별 OT현황: 임금월(예: "10월"=9/26~10/25) 기준 연/월
let otTeamFilter = (()=>{ try{ return localStorage.getItem('snct_team_ot')||''; }catch(e){ return ''; } })(); // 월별 OT현황 — 기기에 기억
let dispatchTeamFilter = ''; // 배차표: '' (전체), '1', '2' — 새로 고침해도 고른 것 그대로(이 기기에 기억)
try{ const v = localStorage.getItem('snct_dp_team'); if(v==='' || v==='1' || v==='2') dispatchTeamFilter = v; }catch(e){}
let addCodeFormOpen = false; // 근태코드 화면: 코드 추가 폼 표시 여부
// 임금월 계산: "M월"은 (M-1월)26일 ~ M월25일
function payPeriodRange(y,m){
  let sy=y, sm=m-1;
  if(sm<1){ sm=12; sy=y-1; }
  return [dstr(sy,sm,26), dstr(y,m,25)];
}
let otMatrixAttendance = {}; // 기사별 OT현황 전용 출퇴근 데이터(작업기간 전체 구독)
let holYearFilter = null;
let dispatchDate = null, dispatchShift = 'day', dispatchPaint = '초반'; // 배차표 화면 상태
let dispatchSunPart = 'day'; // 일요일 배차표 보기: day(주간 07~19시) / night(야간 19~익일 07시) — 하루치 한 장을 나눠 보기
let paintSession = null; // {empId, changes:{slot:value}} - 배차표 드래그 색칠 중 임시 상태
let gridEdit = null; // {date, employeeId} - 월별표에서 셀 클릭 시 근무코드/근태코드 인라인 편집
let otDetailEmpId = null;
let otEdit = null; // 월별 OT현황에서 바로 보기·수정하는 칸 {date, employeeId}
function renderOtEdit(){
  const {date, employeeId} = otEdit;
  const e = employees.find(x=>x.id===employeeId); if(!e) return '';
  const rec = attStore[date+'_'+employeeId] || {};
  const [y,m,d] = date.split('-').map(Number);
  const c = computeDaily(rec.checkIn ? rec : null, date), sp = computeSupportDaily(rec, date), meal = computeMealAllowance(rec) + computeDamdang(rec);
  const chk = (n,l) => `<label style="display:flex;align-items:center;gap:5px;"><input type="checkbox" name="${n}" ${rec[n]?'checked':''}>${l}</label>`;
  const dc = gridCode(rec, date, String(e.name||'').trim());
  return `<div id="otEditScrim" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;display:flex;align-items:center;justify-content:center;overflow:auto;padding:16px;">
    <form id="otEditForm" class="panel" style="max-width:520px;width:100%;margin:0;" autocomplete="off">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
        <h3 style="margin:0;">${esc(e.name)} · ${m}/${d}(${weekdayKr(y,m,d)})</h3>${dc ? codeBadge(dc) : ''}
        <span style="flex:1"></span><button type="button" class="btn ghost sm" id="otEditClose">닫기</button>
      </div>
      <p class="hint" style="margin:0 0 10px;">${holidays[date] ? esc(holidays[date])+' · ' : ''}${c.valid ? esc(c.category)+' 근무' : '본근무 없음'}</p>
      <div class="row">
        <div class="field"><label>본출근</label><div style="display:flex;gap:4px;">${timeSelectRangeHtml('checkIn', rec.checkIn, [8,12,19,24])}</div></div>
        <div class="field"><label>본퇴근</label><div style="display:flex;gap:4px;">${timeSelectHtml('checkOut', rec.checkOut)}</div></div>
        <div class="field"><label>지원출근</label><div style="display:flex;gap:4px;">${timeSelectRangeHtml('supportIn', rec.supportIn, [8,12,19,24])}</div></div>
        <div class="field"><label>지원퇴근</label><div style="display:flex;gap:4px;">${timeSelectHtml('supportOut', rec.supportOut)}</div></div>
      </div>
      <div class="row" style="margin-top:8px;align-items:center;">
        <div class="field" style="min-width:90px;"><label>본조보상</label><input type="number" step="0.5" min="0" name="honjoComp" value="${esc(rec.honjoComp||'')}" placeholder="0" style="width:90px;"></div>
        <div class="field" style="min-width:90px;"><label>타조보상</label><input type="number" step="0.5" min="0" name="tajoComp" value="${esc(rec.tajoComp||'')}" placeholder="0" style="width:90px;"></div>
        ${chk('jochul','조출')}${chk('jungsik','중식')}${chk('seokchul','석출')}${chk('yasik','야식')}${chk('damdang','담당')}
      </div>
      <div class="cards" style="margin:12px 0 8px;grid-template-columns:repeat(4,1fr);">
        <div class="card"><div class="n" style="font-size:18px;">${fmtH(c.totalWork)}</div><div class="l">실근무</div></div>
        <div class="card"><div class="n" style="font-size:18px;">${fmtH(c.valid?c.premium:0)}</div><div class="l">본근무 가산</div></div>
        <div class="card"><div class="n" style="font-size:18px;">${fmtH(sp.valid?sp.premium:0)}</div><div class="l">지원 가산</div></div>
        <div class="card"><div class="n" style="font-size:18px;">${fmtH(meal)}</div><div class="l">식사·담당</div></div>
      </div>
      ${canEdit ? `<div class="row" style="justify-content:flex-end;">
        <button type="button" class="btn warn ghost sm" id="otEditDel" ${attStore[date+'_'+employeeId]?'':'disabled'}>초기화</button>
        <button type="submit" class="btn sm">저장</button>
      </div>` : '<p class="hint" style="margin:0;">보기 전용입니다.</p>'}
    </form></div>`;
}
function bindOtEdit(el){
  const f = document.getElementById('otEditForm'); if(!f) return;
  const close = ()=>{ otEdit = null; render(); };
  document.getElementById('otEditClose').onclick = close;
  document.getElementById('otEditScrim').onclick = (ev)=>{ if(ev.target.id==='otEditScrim') close(); };
  if(!canEdit){ f.querySelectorAll('input,select').forEach(x=> x.disabled = true); return; }
  f.onsubmit = (ev)=>{
    ev.preventDefault();
    const fd = new FormData(f), {date, employeeId} = otEdit;
    const rec = {
      date, employeeId,
      checkIn: readTimeSelect(fd,'checkIn'), checkOut: readTimeSelect(fd,'checkOut'),
      supportIn: readTimeSelect(fd,'supportIn'), supportOut: readTimeSelect(fd,'supportOut'),
      honjoComp: fd.get('honjoComp')||'', tajoComp: fd.get('tajoComp')||'',
      jochul: !!fd.get('jochul'), seokchul: !!fd.get('seokchul'), jungsik: !!fd.get('jungsik'), yasik: !!fd.get('yasik'), damdang: !!fd.get('damdang'),
      updatedAt: Date.now()
    };
    otEdit = null;
    saveAttendance(rec);
  };
  const del = document.getElementById('otEditDel');
  // 초기화: 출퇴근 시각·보상·식사만 지움(근무코드·근태코드·메모는 그대로)
  if(del) del.onclick = ()=> appConfirm('이 날의 출퇴근 시각·보상·식사 입력을 지울까요? (근태코드는 그대로)', ()=>{
    const {date, employeeId} = otEdit; otEdit = null;
    saveAttendance({date, employeeId, checkIn:'', checkOut:'', supportIn:'', supportOut:'', honjoComp:'', tajoComp:'', jochul:false, seokchul:false, jungsik:false, yasik:false, damdang:false, updatedAt: Date.now()});
  });
} // 기사별 OT현황: 달력 상세보기 중인 직원
const codeStatsIncludeMeal = true; // 근태 집계: 평일OT에 식사연장(식사계) 항상 포함 (체크 버튼 없음)
let codeStatsStart = null, codeStatsEnd = null; // 근태코드 집계: 집계 기간(시작~종료)
// 근태관리 집계 기간·식사연장 설정을 이 기기에 기억(다른 화면에 다녀오거나 앱을 다시 열어도 유지)
const CMB_PREF_KEY = 'snct_combined_range';
try{
  const p = JSON.parse(localStorage.getItem(CMB_PREF_KEY) || 'null');
  if(p && /^\d{4}-\d{2}-\d{2}$/.test(p.start||'') && /^\d{4}-\d{2}-\d{2}$/.test(p.end||'')){ codeStatsStart = p.start; codeStatsEnd = p.end; }
}catch(e){}
function saveCombinedPref(){
  try{ localStorage.setItem(CMB_PREF_KEY, JSON.stringify({start:codeStatsStart, end:codeStatsEnd, meal:codeStatsIncludeMeal})); }catch(e){}
  saveViewPrefsCloud({combinedStart:codeStatsStart, combinedEnd:codeStatsEnd, combinedMeal:codeStatsIncludeMeal});
}
// 월별 OT현황 기간도 같은 방식으로 기억
const OT_PREF_KEY = 'snct_ot_range';
const isYmd = v => /^\d{4}-\d{2}-\d{2}$/.test(v||'');
function loadOtPrefLocal(){
  try{
    const p = JSON.parse(localStorage.getItem(OT_PREF_KEY) || 'null');
    // 새로고침(앱을 새로 열면) 월별 OT현황은 항상 오늘이 속한 임금월로 시작 — 저장된 지난 기간은 쓰지 않음
    void p;
  }catch(e){}
}
function saveOtPref(){
  const v = {start:otMatrixStart, end:otMatrixEnd, payYear:otPayYear, payMonth:otPayMonth};
  try{ localStorage.setItem(OT_PREF_KEY, JSON.stringify(v)); }catch(e){}
  saveViewPrefsCloud({otStart:otMatrixStart, otEnd:otMatrixEnd, otPayYear, otPayMonth});
}
// 편집자가 바꾼 설정만 클라우드에 저장(보기 전용 사용자가 바꾼 건 그 기기에서만 잠시 유지)
function saveViewPrefsCloud(partial){
  if(!db || !canEdit || demoMode) return;
  db.doc('meta/viewPrefs').set(Object.assign({updatedAt: Date.now()}, partial), {merge:true}).catch(()=>{});
}
// 클라우드의 공용 설정을 화면에 반영
function applyViewPrefs(p){
  if(!p) return;
  if(isYmd(p.combinedStart) && isYmd(p.combinedEnd)){ codeStatsStart = p.combinedStart; codeStatsEnd = p.combinedEnd; }
  // 월별 OT현황 기간은 공용 설정을 따르지 않고 각 기기에서 오늘 기준 임금월로 시작
  try{
    localStorage.setItem(CMB_PREF_KEY, JSON.stringify({start:codeStatsStart, end:codeStatsEnd, meal:codeStatsIncludeMeal}));
    if(otMatrixStart) localStorage.setItem(OT_PREF_KEY, JSON.stringify({start:otMatrixStart, end:otMatrixEnd, payYear:otPayYear, payMonth:otPayMonth}));
  }catch(e){}
}
let codeStatsAttendance = {}; // 근태코드 집계 전용 출퇴근 데이터 (선택한 기간 전체를 별도로 구독)
let dispatch = {}; // `${date}_${shift}_${empId}` -> {slots:{slot:catKey}}
let weekStart = null; // 지원계획표 화면 상태 (해당 주의 월요일, YYYY-MM-DD)
let supportPlan = {}; // `${date}_${shift}` -> {capacity,quota,offCount,leadCount,preSupport,supportOff,support}
const DAY_SLOTS = ['07:00','07:30','08:00','08:30','09:00','09:30','10:00','10:30','11:00','11:30','12:00','12:30','13:00','13:30','14:00','14:30','15:00','15:30','16:00','16:30','17:00','17:30','18:00','18:30','19:00'];
// 일요일 24시간 배차표: 주간 07:00~18:30 + 야간 19:00~06:30 (다음날 07:00 교대까지)
const FULL_SLOTS_FN = ()=> DAY_SLOTS.slice(0, DAY_SLOTS.indexOf('19:00')).concat(NIGHT_SLOTS.slice(NIGHT_SLOTS.indexOf('19:00'), NIGHT_SLOTS.indexOf('07:00')));
// 일요일 야간 보기: 18~19(교대 겹침) + 19:00~06:30 + 다음날 07~08
const SUN_NIGHT_SLOTS_FN = ()=> ['18:00','18:30'].concat(NIGHT_SLOTS.slice(NIGHT_SLOTS.indexOf('19:00'), NIGHT_SLOTS.indexOf('07:00')), ['31:00','31:30']);
const NIGHT_SLOTS = ['18:00','18:30','19:00','19:30','20:00','20:30','21:00','21:30','22:00','22:30','23:00','23:30','24:00','00:30','01:00','01:30','02:00','02:30','03:00','03:30','04:00','04:30','05:00','05:30','06:00','06:30','07:00','07:30'];
// 승무(크레인 근무)로 세지 않는 칸: 당직(주황, 저장 값 '후반')·셔틀(회색, 저장 값 '당직')
function dpIsWork(cat){ return !!cat && cat!=='당직'; }   // 시간대별 인원: 당직(주황 '후반') 포함, 셔틀(회색 '당직')만 뺌
// 승무 시간: 근무·정비 + 당직(주황, 저장 값 '후반')까지 포함 — 셔틀(회색, 저장 값 '당직')만 뺌
function dpIsCrew(cat){ return !!cat && cat!=='당직'; }
const DISPATCH_CATS = [
  {key:'수정', bg:'#FFFFFF', fg:'#333333', border:'#c7cad1'},
  {key:'초반', label:'근무', bg:'#8CE24C', fg:'#1a3d00', border:'#8CE24C'},   // 이름만 '근무'(저장 값은 예전 그대로 '초반' — 이미 칠한 칸 유지)
  {key:'후반', label:'당직', bg:'#FFA654', fg:'#5c2d00', border:'#FFA654'},   // 주황 = 당직(저장 값은 예전 '후반')
  {key:'당직', label:'셔틀', bg:'#8C8C8C', fg:'#ffffff', border:'#8C8C8C'},   // 회색 = 셔틀(저장 값은 예전 '당직')
  {key:'정비', bg:'#F3B3F3', fg:'#5c005c', border:'#F3B3F3'},
  {key:'기타', hidden:true, bg:'#7A2FA8', fg:'#ffffff', border:'#7A2FA8'}   // 버튼은 없앰(예전에 칠한 칸 표시용)
];
// 배차표의 조출·중식·석출·야식 시간 칸(빨간 시각: 07·12·18·24시) — 칠하기 대신 한글·숫자를 직접 입력
// 월별 표 주 단위 색 구분(월~일 한 주씩 연한 회색 / 조금 더 진한 회색 번갈아)
function weekBand(ds){
  const [y,m,d] = mondayOf(ds).split('-').map(Number);
  const wk = Math.floor(Date.UTC(y,m-1,d) / (7*86400000));
  return (wk % 2) ? 'wkB' : 'wkA';
}
// 배차표 이름을 누르면: 그 사람의 오늘(보고 있는 날·근무) 배차를 시간대별로 묶어서 팝업
let dpWho = null; // empId 또는 supNN
function dpSlotOrder(){
  if(dispatchShift==='day') return DAY_SLOTS.filter(x=>x!=='19:00');
  if(dispatchShift==='night') return NIGHT_SLOTS;
  const a = FULL_SLOTS_FN(), b = SUN_NIGHT_SLOTS_FN(), seen = new Set(), out = [];
  a.slice(0, a.indexOf('19:00')).concat(b).concat(a.slice(a.indexOf('19:00'))).forEach(x=>{ if(!seen.has(x)){ seen.add(x); out.push(x); } });
  return out.sort((x,y)=> dpSlotMin(x) - dpSlotMin(y));
}
function dpSlotMin(s){ let [h,m] = String(s).split(':').map(Number); if(dispatchShift!=='day' && h < 7) h += 24; return h*60 + (m||0); }   // 야간은 자정 넘어 이어지게
function dpHM(min){ let h = Math.floor(min/60) % 24, m = min % 60; return String(h).padStart(2,'0') + ':' + String(m).padStart(2,'0'); }
function renderDpWho(){
  const empId = dpWho, isSup = String(empId).startsWith('sup');
  const drec = dispatch[`${dispatchDate}_${dispatchShift}_${empId}`] || {};
  const slots = drec.slots || {}, notes = drec.notes || {};
  const who = isSup ? ((window._dpAutoSup && window._dpAutoSup[empId]) || drec.name || '지원') : empName(empId);
  const e = isSup ? employees.find(x=> String(x.name||'').trim()===who) : employees.find(x=>x.id===empId);
  const rec = e ? (attendance[dispatchDate+'_'+e.id] || {}) : {};
  const code = e ? (gridCode(rec && rec.date ? rec : null, dispatchDate, String(e.name||'').trim()) || (isSup ? '' : scheduledShift(dispatchDate, e.team||''))) : '';
  // 같은 내용(색+글씨)이 이어지는 칸을 한 줄로 묶음
  const rows = []; let work = 0, duty = 0, shuttle = 0;
  dpSlotOrder().forEach(s=>{
    const cat = slots[s] || '', note = '';   // 칸에 직접 쓴 숫자·글씨는 팝업에 안 보임(색칠한 배차만)
    if(dpIsCrew(cat)) work += 0.5; else if(cat==='당직') shuttle += 0.5;
    if(!cat) return;
    const st = dpSlotMin(s), last = rows[rows.length-1];
    if(last && last.cat===cat && last.note===note && last.end===st) last.end = st + 30;
    else rows.push({cat, note, start: st, end: st + 30});
  });
  const [y,m,d] = dispatchDate.split('-').map(Number);
  const part = dispatchShift==='full' ? '일요일(주·야간)' : dispatchShift==='night' ? '야간' : '주간';
  const body = rows.length ? rows.map(r=>{ const c = dispatchCat(r.cat);
      return `<tr><td style="white-space:nowrap;font-weight:700;">${dpHM(r.start)} ~ ${dpHM(r.end)}</td>
        <td>${c ? `<span style="display:inline-block;background:${c.bg};color:${c.fg};border:1px solid ${c.border};border-radius:6px;padding:2px 8px;font-weight:700;">${esc(c.label||r.cat)}</span>` : ''}${r.note ? ` <span style="font-weight:600;">${esc(r.note)}</span>` : ''}</td>
        <td style="text-align:right;white-space:nowrap;color:var(--text-muted);">${fmtH((r.end - r.start)/60)}h</td></tr>`; }).join('')
    : `<tr><td colspan="3" class="hint" style="text-align:center;padding:14px 0;">오늘 배차가 없어요.</td></tr>`;
  // 음성으로 읽을 문장: "김의섭, 10월 18일 주간 배차입니다. 8시부터 10시까지 근무. … 승무 4.5시간."
  const sayT = min=>{ const h = Math.floor(min/60) % 24, mi = min % 60; return `${(dispatchShift==='night' || (dispatchShift==='full' && (sunPartNow(dispatchDate) || dispatchSunPart)==='night')) && h < 7 ? '새벽 ' : ''}${h}시${mi ? ' '+mi+'분' : ''}`; };
  // 일요일(주·야간 한 장)은 지금 보고 있는 쪽(주간 또는 야간)만 읽음
  // 일요일: 지금 그 일요일의 주간(07~19시)이면 주간만, 야간이면 야간만 읽음(다른 날을 보고 있으면 화면에서 고른 쪽)
  const sunPart = dispatchShift==='full' ? (sunPartNow(dispatchDate) || dispatchSunPart) : '';
  const sayPart = dispatchShift==='full' ? (sunPart==='night' ? '야간' : '주간') : part;
  let sRows = [], sWork = 0, sDuty = 0, sShuttle = 0;
  if(dispatchShift==='full'){
    const fa = FULL_SLOTS_FN(), partSlots = new Set(sunPart==='night' ? SUN_NIGHT_SLOTS_FN() : fa.slice(0, fa.indexOf('19:00')));
    dpSlotOrder().forEach(sl=>{
      if(!partSlots.has(sl)) return;
      const cat = slots[sl] || ''; if(!cat) return;
      if(dpIsCrew(cat)) sWork += 0.5; else if(cat==='당직') sShuttle += 0.5;
      const st = dpSlotMin(sl), last = sRows[sRows.length-1];
      if(last && last.cat===cat && last.end===st) last.end = st + 30; else sRows.push({cat, start: st, end: st + 30});
    });
  } else { sRows = rows; sWork = work; sDuty = duty; sShuttle = shuttle; }
  const hrs = n=> fmtH(n).replace(/\.0$/,'');
  window._dpWhoSpeech = `${who}, ${m}월 ${d}일 ${sayPart} 배차입니다. ` + (sRows.length
    ? sRows.map(r=>{ const c = dispatchCat(r.cat); return `${sayT(r.start)}부터 ${sayT(r.end)}까지 ${c ? (c.label||r.cat) : r.cat}.`; }).join(' ') + ` 승무 ${hrs(sWork)}시간${sDuty ? ', 당직 '+hrs(sDuty)+'시간' : ''}${sShuttle ? ', 셔틀 '+hrs(sShuttle)+'시간' : ''}입니다.`
    : `${sayPart} 배차가 없습니다.`);
  const ttsOk = dpTtsSupported();
  return `<div id="dpWhoScrim" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;display:flex;align-items:center;justify-content:center;">
    <div class="panel" style="max-width:380px;width:92%;margin:0;max-height:86vh;overflow:auto;">
      <h3 style="margin:0 0 2px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;">${esc(who)} ${code ? codeBadge(code) : ''}${(()=>{ const n = isSup ? (e && window._dpSupRank ? window._dpSupRank[e.id] : null) : (window._dpRank ? window._dpRank[empId] : null);
        return n!=null ? `<span style="font-size:13px;font-weight:700;background:#ede9fe;color:#5b21b6;border-radius:6px;padding:2px 8px;">${isSup ? '지원 순번' : '퇴근 순번'} ${n}</span>` : ''; })()}</h3>
      <p class="hint" style="margin:0 0 10px;">${m}/${d}(${weekdayKr(y,m,d)}) ${part} 배차</p>
      <table class="tbl" style="width:100%;font-size:13px;"><tbody>${body}</tbody></table>
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:10px;gap:8px;flex-wrap:wrap;">
        <b style="font-size:14px;">승무 ${fmtH(work)}h${duty ? ` <span style="font-weight:600;color:var(--text-muted);">· 당직 ${fmtH(duty)}h</span>` : ''}${shuttle ? ` <span style="font-weight:600;color:var(--text-muted);">· 셔틀 ${fmtH(shuttle)}h</span>` : ''}</b>
        <span style="display:flex;gap:6px;align-items:center;">${ttsOk ? `<button class="btn ghost sm" id="dpWhoSpeak" title="이 사람 배차를 소리로 읽어 줘요">🔊 듣기</button>` : ''}<button class="btn ghost sm" id="dpWhoClose">닫기</button></span>
      </div>
      ${ttsOk ? `<label style="display:flex;align-items:center;gap:6px;margin-top:8px;font-size:12px;color:var(--text-muted);cursor:pointer;"><input type="checkbox" id="dpWhoAuto"${dpTtsAuto() ? ' checked' : ''}> 이름을 누르면 자동으로 읽기</label>` : ''}
    </div></div>`;
}
// ===== 배차 음성 읽기(브라우저 내장 음성 — 아이폰·안드로이드·PC, 인터넷 연결 없이도 됨) =====
function dpTtsSupported(){ return typeof window!=='undefined' && 'speechSynthesis' in window && typeof SpeechSynthesisUtterance!=='undefined'; }
function dpTtsAuto(){ try{ return localStorage.getItem('snct_dp_tts')!=='0'; }catch(e){ return true; } }
function dpSpeak(text){
  if(!dpTtsSupported() || !text) return;
  try{
    const ss = window.speechSynthesis;
    const busy = ss.speaking || ss.pending;
    if(busy) ss.cancel();
    try{ ss.resume(); }catch(e){}
    const u = new SpeechSynthesisUtterance(text);
    u.lang = 'ko-KR'; u.rate = 0.95; u.pitch = 0.92;   // 차분하고 또렷하게 — 아나운서처럼 낮고 안정된 여성 목소리 느낌
    const v = dpPickVoice(ss.getVoices()||[]); if(v) u.voice = v;
    if(busy) setTimeout(()=>{ try{ ss.speak(u); }catch(e){} }, 120);   // 안드로이드 크롬: 취소 직후 바로 읽으면 소리가 안 나는 문제
    else ss.speak(u);
  }catch(e){}
}
// 기기에 있는 한국어 목소리 중 여성 목소리를 먼저 고름(자연스러운 '온라인/Natural' 목소리 우선)
//   PC 엣지: SunHi(Natural) · 윈도우: Heami · 아이폰/맥: Yuna·Sora·유나 · 안드로이드 구글: 기본 여성 목소리
function dpPickVoice(list){
  const ko = list.filter(x=> /^ko/i.test(x.lang||'') || /korean|한국/i.test(x.name||''));
  if(!ko.length) return null;
  const male = /injoon|hyunsu|minsang|gookmin|bongjin|male(?!.*female)|남성|남자|ko-kr-x-kod|ko-kr-x-koc/i;
  const score = x=>{ const n = String(x.name||''); let sc = 0;
    if(/sunhi|sun-hi|선희/i.test(n)) sc += 60;
    if(/yuna|유나|sora|소라|jimin|지민|seoyeon|서연|yujin|유진|heami|해미/i.test(n)) sc += 50;
    if(/female|여성|여자|ko-kr-x-ism|ko-kr-x-kob/i.test(n)) sc += 40;
    if(/natural|online|neural|premium|enhanced|고품질/i.test(n)) sc += 20;
    if(/google/i.test(n)) sc += 10;
    if(male.test(n)) sc -= 100;
    return sc; };
  return ko.slice().sort((a,b)=> score(b)-score(a))[0];
}
function dpSpeakStop(){ try{ if(dpTtsSupported()) window.speechSynthesis.cancel(); }catch(e){} }
try{ if(dpTtsSupported()){ window.speechSynthesis.getVoices(); window.speechSynthesis.onvoiceschanged = ()=>{}; } }catch(e){}
let dpPop = null; // {empId, slot}
let dpPopOpenedAt = 0;
function openDpPop(empId, slot){ dpPop = {empId, slot}; dpPopOpenedAt = Date.now(); render(); }
const dpPopReady = ()=> Date.now() - dpPopOpenedAt > 450; // 칸을 누른 손가락이 팝업 버튼을 눌러버리는 것 방지
function renderDpPop(){
  const id = `${dispatchDate}_${dispatchShift}_${dpPop.empId}`;
  const drec = dispatch[id] || {};
  const cur = (drec.slots||{})[dpPop.slot] || '', note = (drec.notes||{})[dpPop.slot] || '';
  const who = dpPop.empId.startsWith('sup') ? (drec.name || '지원') : empName(dpPop.empId);
  const btns = DISPATCH_CATS.filter(c=>c.key!=='수정' && !c.hidden).map(c=>`<button type="button" class="dpPopCat" data-cat="${esc(c.key)}" style="background:${c.bg};color:${c.fg};border:2px solid ${cur===c.key?'#111':c.border};border-radius:10px;padding:10px 0;font-weight:800;font-size:14px;cursor:pointer;">${esc(c.label||c.key)}</button>`).join('');
  return `<div id="dpPopScrim" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;display:flex;align-items:center;justify-content:center;">
    <div class="panel" style="max-width:360px;width:92%;margin:0;">
      <h3 style="margin:0 0 2px;">${esc(who)} · ${esc(dpPop.slot)}</h3>
      <p class="hint" style="margin:0 0 12px;">항목을 누르면 바로 칠해집니다.</p>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:8px;">${btns}</div>
      <button type="button" class="btn warn ghost sm" id="dpPopClear" style="width:100%;margin-bottom:10px;">색 지우기</button>
      <p class="hint" style="margin:0 0 8px;">글씨는 칸을 <b>두 번 누르면</b> 칸 안에서 바로 입력할 수 있어요.</p>
      <div class="row" style="justify-content:flex-end;"><button class="btn ghost sm" id="dpPopClose">닫기</button></div>
    </div></div>`;
}
// 배차표 칸 안에서 바로 글씨 입력(두 번 누르기)
// ===== 배차표: 엑셀처럼 칸 선택 → 팔레트(수정·초반·후반…) 누르면 선택한 칸에 적용 =====
// 선택은 {aEmp,aSlot}(처음 누른 칸) ~ {fEmp,fSlot}(끝 칸) 사각형. 다시 그려도 사람·시간으로 기억해서 유지
let dpSel = null, dpSelDragging = false;
function dpGridRows(){
  const table = document.getElementById('dpTable'); if(!table) return [];
  const anchorEmp = dpSel ? dpSel.aEmp : null;
  return Array.from(table.querySelectorAll('tbody tr')).filter(tr=>{
    const first = tr.querySelector('.dpCell'); if(!first) return false;
    // 휴무(회색) 줄은 건너뜀 — 처음 누른 줄이면 포함
    return !tr.classList.contains('dpOff') || first.dataset.dispatchEmp===anchorEmp;
  }).map(tr=> Array.from(tr.querySelectorAll('.dpCell')));
}
function dpSelRect(rows){
  if(!dpSel) return null;
  const find = (emp, slot)=>{ for(let r=0;r<rows.length;r++){ const c = rows[r].findIndex(td=> td.dataset.dispatchEmp===emp && td.dataset.dispatchSlot===slot); if(c>=0) return [r,c]; } return null; };
  const a = find(dpSel.aEmp, dpSel.aSlot), f = find(dpSel.fEmp, dpSel.fSlot) || a;
  if(!a) return null;
  return {r0: Math.min(a[0], f[0]), r1: Math.max(a[0], f[0]), c0: Math.min(a[1], f[1]), c1: Math.max(a[1], f[1])};
}
function dpSelCells(){
  const rows = dpGridRows(), R = dpSelRect(rows); if(!R) return [];
  const out = [];
  for(let r=R.r0;r<=R.r1;r++) for(let c=R.c0;c<=R.c1;c++) if(rows[r][c]) out.push(rows[r][c]);
  return out;
}
function dpApplySel(){
  const table = document.getElementById('dpTable'); if(!table) return;
  table.querySelectorAll('.dpCell.dpSelOn').forEach(td=>{ td.classList.remove('dpSelOn'); td.style.boxShadow = ''; });
  const rows = dpGridRows(), R = dpSelRect(rows); if(!R) return;
  const G = '#217346';
  for(let r=R.r0;r<=R.r1;r++) for(let c=R.c0;c<=R.c1;c++){
    const td = rows[r][c]; if(!td) continue;
    const sh = ['inset 0 0 0 999px rgba(0,0,0,.16)'];
    if(r===R.r0) sh.push(`inset 0 2px 0 ${G}`);
    if(r===R.r1) sh.push(`inset 0 -2px 0 ${G}`);
    if(c===R.c0) sh.push(`inset 2px 0 0 ${G}`);
    if(c===R.c1) sh.push(`inset -2px 0 0 ${G}`);
    td.style.boxShadow = sh.join(','); td.classList.add('dpSelOn');
  }
}
// 팔레트 적용: 초반·후반 등은 색칠, 수정은 색과 글자 모두 지움
function dpApplyCatToSel(catKey){
  if(!canEdit){ requireEdit(); return; }
  if(dpInlineCommit) dpInlineCommit(true);
  const cells = dpSelCells();
  if(!cells.length){ showToast('먼저 배차표에서 칸을 선택하세요.'); return; }
  const erase = catKey==='수정', val = erase ? '' : catKey, byEmp = {};
  cells.forEach(td=>{
    const emp = td.dataset.dispatchEmp, slot = td.dataset.dispatchSlot;
    const g = byEmp[emp] = byEmp[emp] || {changes:{}, clear:[]};
    if((td.dataset.dispatchCur||'') !== val){ g.changes[slot] = val; applyPaintToCell(td, val); }
    if(erase){ const note = (((dispatch[`${dispatchDate}_${dispatchShift}_${emp}`]||{}).notes)||{})[slot]; if(note){ g.clear.push(slot); td.innerHTML = ''; td.removeAttribute('title'); } }
  });
  const slots = new Set(cells.map(td=> td.dataset.dispatchSlot));
  slots.forEach(updateCountLive);
  Object.entries(byEmp).forEach(([emp, g])=>{
    if(Object.keys(g.changes).length || g.clear.length) saveDispatchSlots(dispatchDate, dispatchShift, emp, g.changes, g.clear);
  });
  Object.keys(byEmp).forEach(updateSuwuLive);
  dpApplySel();
}
// Delete·Backspace: 선택한 칸의 '글자만' 지움 — 칠한 색은 그대로(색 지우기는 '수정' 버튼으로만)
function dpClearNotesInSel(){
  if(!canEdit){ requireEdit(); return; }
  const cells = dpSelCells(), byEmp = {};
  cells.forEach(td=>{
    const emp = td.dataset.dispatchEmp, slot = td.dataset.dispatchSlot;
    const note = (((dispatch[`${dispatchDate}_${dispatchShift}_${emp}`]||{}).notes)||{})[slot];
    if(!note) return;
    (byEmp[emp] = byEmp[emp] || []).push(slot);
    td.innerHTML = ''; td.removeAttribute('title');
  });
  Object.entries(byEmp).forEach(([emp, slots])=> saveDispatchSlots(dispatchDate, dispatchShift, emp, {}, slots));
  dpApplySel();
}
// 글자 입력: 선택한 칸(처음 누른 칸)에 바로 입력. 첫 글자를 넘겨받으면 그 글자부터 시작(엑셀처럼)
function dpStartTyping(td, firstChar){
  if(!td || !canEdit) return;
  startDpInlineEdit(td, firstChar);
}
function dpMoveSel(dr, dc){
  const rows = dpGridRows(); const a = dpAnchorCell(); if(!a || !rows.length) return;
  let r = rows.findIndex(cs=> cs.includes(a)); if(r<0) return;
  let c = rows[r].indexOf(a);
  r = Math.max(0, Math.min(rows.length-1, r + dr)); c = Math.max(0, Math.min(rows[r].length-1, c + dc));
  const td = rows[r][c]; dpSel = {aEmp: td.dataset.dispatchEmp, aSlot: td.dataset.dispatchSlot, fEmp: td.dataset.dispatchEmp, fSlot: td.dataset.dispatchSlot};
  dpApplySel(); td.scrollIntoView({block:'nearest', inline:'nearest'});
}
function dpAnchorCell(){
  if(!dpSel) return null;
  const table = document.getElementById('dpTable'); if(!table) return null;
  return Array.from(table.querySelectorAll('.dpCell')).find(td=> td.dataset.dispatchEmp===dpSel.aEmp && td.dataset.dispatchSlot===dpSel.aSlot) || null;
}
// 키보드(PC): 글자 치면 입력, Delete/Backspace는 선택 칸 지우기(=수정), Esc는 선택 해제, 화살표는 한 칸 이동
document.addEventListener('keydown', (ev)=>{
  if(VIEW!=='dispatch' || !dpSel) return;
  const t = ev.target; if(t && (t.tagName==='INPUT' || t.tagName==='TEXTAREA' || t.tagName==='SELECT' || t.isContentEditable)) return;
  if(ev.ctrlKey || ev.metaKey || ev.altKey) return;
  if(ev.key==='Escape'){ dpSel = null; dpApplySel(); return; }
  if(ev.key==='Delete' || ev.key==='Backspace'){ ev.preventDefault(); dpClearNotesInSel(); return; } // 글자만 지움(색은 '수정'으로만)
  if(ev.key==='Enter' || ev.key==='F2'){ ev.preventDefault(); dpStartTyping(dpAnchorCell(), null); return; }
  const arrows = {ArrowLeft:[0,-1], ArrowRight:[0,1], ArrowUp:[-1,0], ArrowDown:[1,0]};
  if(arrows[ev.key]){ ev.preventDefault(); dpMoveSel(arrows[ev.key][0], arrows[ev.key][1]); return; }
  if(ev.key.length===1){ ev.preventDefault(); dpStartTyping(dpAnchorCell(), ev.key); }
});

let dpInlineCommit = null; // 열려 있는 입력칸을 저장하고 닫는 함수(다른 칸을 누르거나 팔레트를 누를 때 먼저 호출)
function startDpInlineEdit(td, firstChar){
  if(!td || !canEdit) return;
  if(dpInlineCommit) dpInlineCommit(true);
  const empId = td.dataset.dispatchEmp, slot = td.dataset.dispatchSlot;
  const id = `${dispatchDate}_${dispatchShift}_${empId}`;
  const prev = ((dispatch[id]||{}).notes||{})[slot] || '';
  const prevHtml = td.innerHTML, prevTitle = td.getAttribute('title');
  td.innerHTML = `<input type="text" class="dpInline" maxlength="10" autocomplete="off" value="${esc(firstChar!=null ? firstChar : prev)}">`;
  const inp = td.querySelector('input');
  inp.focus({preventScroll:true});
  if(firstChar!=null){ const n = inp.value.length; inp.setSelectionRange(n, n); } else inp.select();
  let done = false;
  const finish = (save)=>{
    if(done) return; done = true; dpInlineCommit = null;
    const v = inp.value.trim();
    if(save && v!==prev){
      // 화면을 통째로 다시 그리지 않고 그 칸만 바로 바꿔서, 다른 칸으로 옮겨도 글자가 그대로 보이게
      td.innerHTML = v ? `<span class="dpTxt">${esc(v)}</span>` : '';
      if(v) td.setAttribute('title', v); else td.removeAttribute('title');
      saveDispatchNote(dispatchDate, dispatchShift, empId, slot, v);
    } else {
      td.innerHTML = prevHtml;
      if(prevTitle!=null) td.setAttribute('title', prevTitle); else td.removeAttribute('title');
    }
  };
  dpInlineCommit = finish;
  inp.onkeydown = (ev)=>{
    if(ev.key==='Enter'){ ev.preventDefault(); finish(true); dpMoveSel(1, 0); }      // 엔터: 저장하고 아래 칸으로
    else if(ev.key==='Tab'){ ev.preventDefault(); finish(true); dpMoveSel(0, ev.shiftKey ? -1 : 1); }
    else if(ev.key==='Escape'){ ev.preventDefault(); finish(false); }
  };
  inp.onblur = ()=> finish(true);
  inp.onpointerdown = (ev)=> ev.stopPropagation();
}
// 1조/2조를 고르면 그 조의 그날 근무(교대 순환)에 맞춰 D → 주간(07~19시), N → 야간(18~07시)
function isSundayDs(ds){ const [y,m,d] = String(ds).split('-').map(Number); return new Date(y, m-1, d).getDay()===0; }
// 배차표의 '오늘': 야간 배차표만 다음날 08시까지 전날로 봄(주간은 그대로 자정에 넘어감)
//  00~08시에 보고 있는 조가 전날 야간 근무였으면(전체 보기 포함) 전날 야간, 주간 조면 오늘
// 지금 근무 중인 조: 08~18시는 오늘 주간 조, 그 밖에는 야간 조(00~08시는 어제 야간 조)
// 일요일 24시간(주간 07시 ~ 월요일 08시) 근무 조 = 그 주에 주간(D)인 조 (원본 엑셀 배차: 일요일 주·야간 모두 D 주 조가 근무)
function sundayTeam(ds){ return scheduledShift(ds,'1')==='D' ? '1' : '2'; }
function dpNowTeam(){
  try{ const n = new Date(), h = n.getHours(), t = todayStr();
    if(h >= 8 && h < 18) return isSundayDs(t) ? sundayTeam(t) : (scheduledShift(t,'1')==='D' ? '1' : '2');
    const d = h < 8 ? addDays(t, -1) : t;
    if(isSundayDs(d)) return sundayTeam(d);   // 일요일 저녁 ~ 월요일 08시: 일요일 24시간 조
    return scheduledShift(d,'1')==='N' ? '1' : '2';
  }catch(e){ return '1'; }
}
function dpWorkDate(){ return dpWorkDateFor(dispatchTeamFilter); }
// 그 조의 '지금 근무일': 08시 전이면 전날 야간(일요일이면 일요일 24시간 조)인 조는 전날, 아니면 오늘 — 배차표·출퇴근 입력 공통
function dpWorkDateFor(t){
  const n = new Date(), today = todayStr();
  if(n.getHours() >= 8) return today;
  const y = addDays(today, -1);
  if(t!=='1' && t!=='2') return y;
  if(isSundayDs(y)) return sundayTeam(y)===t ? y : today;   // 월요일 08시 전: 일요일 24시간 조는 아직 일요일(야간)
  return scheduledShift(y, t)==='N' ? y : today;
}
let dispatchAuto = true; // 날짜를 직접 고르지 않았으면 시간에 따라 자동(08시에 다음 날로)
// 자동 날짜로 바꾸기: 08시 전이면 전날 야간(일요일이면 하루치의 야간 쪽)
function dpApplyAutoDate(){
  dispatchDate = dpWorkDate(); autoDispatchShift();
  if(dispatchDate !== todayStr()){ if(isSundayDs(dispatchDate)) dispatchSunPart = 'night'; else dispatchShift = 'night'; } // 전날 야간
}
// 일요일 배차를 지금 시각으로: 주간(07~18시) / 야간(18시 ~ 월요일 08시) — 지금 그 일요일이 아니면 null
function sunPartNow(ds){
  const n = new Date(), h = n.getHours(), t = todayStr();
  if(ds===t) return (h >= 7 && h < 18) ? 'day' : (h >= 18 ? 'night' : null);
  if(ds===addDays(t, -1) && h < 8) return 'night';
  return null;
}
function autoDispatchShift(){
  if(isSundayDs(dispatchDate || todayStr())){ // 일요일: 하루치 한 장 — 지금이 그 일요일이면 시각(07~19시 주간, 그 밖 야간), 아니면 고른 조의 근무(D/N)
    dispatchShift = 'full';
    const t = (dispatchTeamFilter==='1' || dispatchTeamFilter==='2') ? dispatchTeamFilter : '1';
    dispatchSunPart = sunPartNow(dispatchDate || todayStr()) || 'day';
    return;
  }
  const team = (dispatchTeamFilter==='1' || dispatchTeamFilter==='2') ? dispatchTeamFilter : '1';
  const c = scheduledShift(dispatchDate || todayStr(), team);
  if(c) dispatchShift = c==='N' ? 'night' : 'day';
}
const DP_WORK_CODES = new Set(['D','N','DN','ND','DS','NS','SP']); // 배차표에서 '근무'로 보는 코드 (SP 지원패스 = 지원만 빠지고 본근무는 함)
// 선지원 코드(DS·NS): 그날은 상대 조 배차표 지원란에서만 일하므로, 자기 조 배차표에서는 흐리게·칠하기 막음·순번/인원에서 뺌
// DN·ND는 그날 자기 조 근무(DN = 주간 후 상대 조 야간 연장, ND = 야간 후 다음 날 상대 조 주간 연장)를 하므로 자기 조 배차표에서 막지 않음 — 선지원 DS·NS만 막음
const DP_SUPX_CODES = new Set(['DS','NS']);
// ===== 본선작업 현황: 선석별 작업현황 · STS별 작업현황만 표시(1분마다 새로고침) =====
// 회사 홈페이지를 구글 Apps Script(무료)가 대신 읽어 두 표만 JSON으로 넘겨줌 → 앱이 표로 그림
let vslApi = '';             // Apps Script 웹 앱 주소(UNION이 설정, 클라우드 meta/config에 저장)
let vslData = null, vslErr = '', vslLoading = false;
let vslOpen = (()=>{ try{ return localStorage.getItem('snct_vsl_open')!=='0'; }catch(e){ return true; } })();
let vslTimer = null, vslLoadedAt = 0, vslSetupOpen = false;
// 본선작업 화면(선석별 작업현황 + STS별 작업현황) — 회사 화면과 같은 구성
function vslStsTableHtml(d){
  const rows = ((d && d.sts) || []).map(r=>`<tr>${r.map(c=>`<td${c.rs>1?` rowspan="${c.rs}"`:''} style="text-align:center;">${esc(c.t)}</td>`).join('')}</tr>`).join('');
  return `<div class="scrollx"><table class="vslTbl"><thead>
      <tr><th rowspan="2">선석</th><th rowspan="2">모선항차</th><th rowspan="2">STS</th><th rowspan="2">작업위치</th><th colspan="3" class="vslGrp">잔여량</th><th rowspan="2">생산성<br>(VAN/HR)</th><th rowspan="2">예상작업완료시간</th></tr>
      <tr><th>양하</th><th>적하</th><th>합계</th></tr>
    </thead><tbody>${rows || '<tr><td colspan="9" class="vslEmptyRow">데이터가 없습니다.</td></tr>'}</tbody></table></div>`;
}
// 회사 화면의 선석 카드 글자 줄을 항목별로 나눔
const VSL_TIME_LABELS = ['접안예정시간','접안완료시간','작업시작시간','출항예정시간'];
function parseBerthLines(L){
  const isLabel = x => VSL_TIME_LABELS.includes(x) || ['양하','적하','총작업량','완료량','잔량'].includes(x);
  const after = lab => { const i = L.indexOf(lab); return i>=0 && i+1<L.length && !isLabel(L[i+1]) ? L[i+1] : ''; };
  const pair = lab => {
    const i = L.indexOf(lab); if(i<0) return null;
    let a = L[i+1]||'', b = '';
    if(/\/\s*$/.test(a)){ b = L[i+2]||''; a = a.replace(/\/\s*$/,''); }
    else if(a.includes('/')){ [a,b] = a.split('/'); }
    const done = Number(String(a).replace(/[^0-9.]/g,''))||0, total = Number(String(b).replace(/[^0-9.]/g,''))||0;
    return {done, total};
  };
  const pctLine = L.find(x=>/^\d+(\.\d+)?\s*%$/.test(x));
  const ship = L[0] || '';
  const op = L[1] && !isLabel(L[1]) && !/%$/.test(L[1]) && L[1].length<=12 ? L[1] : '';
  return {
    ship, op,
    times: VSL_TIME_LABELS.map(l=>({label:l, value:/^\d{4}[-./]\d{1,2}/.test(after(l)) ? after(l) : ''})),
    pct: pctLine ? parseFloat(pctLine) : null,
    dis: pair('양하'), load: pair('적하'),
    total: after('총작업량'), done: after('완료량'), remain: after('잔량'),
    ok: !!(ship && (L.includes('양하') || L.includes('접안예정시간')))
  };
}
function berthCardHtml(b){
  const has = !b.empty && b.lines && b.lines.length;
  if(!has) return `<div class="vslBerth"><div class="vslBerthHead"><span class="vslBerthIc">⚓</span><span>${esc(b.title)}</span></div><div class="vslBerthEmpty">작업이 없습니다.</div></div>`;
  const p = parseBerthLines(b.lines);
  if(!p.ok) return `<div class="vslBerth on"><div class="vslBerthHead"><span class="vslBerthIc on">⚓</span><span>${esc(b.title)}</span></div>
      <div class="vslBerthBody">${b.lines.map((l,k)=>`<div class="${k===0?'vslShip':'vslLine'}">${esc(l)}</div>`).join('')}</div></div>`;
  const pct = p.pct!=null ? p.pct : 0, R = 44, C = 2*Math.PI*R;
  const bar = x => x && x.total ? Math.min(100, Math.round(x.done/x.total*100)) : 0;
  const box = (name, x, cls) => `<div class="vslBox ${cls}"><div class="vslBoxT">${name}</div>
      <div class="vslBoxN"><b>${x ? x.done.toLocaleString() : 0}</b><span>/${x ? x.total.toLocaleString() : 0}</span></div>
      <div class="vslBar"><i style="width:${bar(x)}%"></i></div></div>`;
  return `<div class="vslBerth on">
    <div class="vslBerthHead"><span class="vslBerthIc on">⚓</span><span>${esc(b.title)}</span>
      <span class="vslShipNo">${esc(p.ship)}</span><span style="flex:1"></span>${p.op ? `<span class="vslOp">${esc(p.op)}</span>` : ''}</div>
    <div class="vslTimes">${p.times.map(t=>`<div class="vslTimeRow"><span><i class="vslDot"></i>${esc(t.label)}</span><b>${esc(t.value)}</b></div>`).join('')}</div>
    <div class="vslMid">
      <div class="vslRing"><svg viewBox="0 0 110 110" width="110" height="110">
          <circle cx="55" cy="55" r="${R}" fill="none" stroke="#fff" stroke-width="12"/>
          ${pct>0 ? `<circle cx="55" cy="55" r="${R}" fill="none" stroke="#db2777" stroke-width="12" stroke-linecap="round"
            stroke-dasharray="${(C*Math.min(pct,100)/100).toFixed(1)} ${C.toFixed(1)}" transform="rotate(-90 55 55)"/>` : ''}
        </svg><div class="vslRingIn"><span>🚢</span><b>${pct}%</b></div></div>
      <div class="vslBoxes">${box('양하', p.dis, 'dis')}${box('적하', p.load, 'load')}</div>
    </div>
    <div class="vslChips">
      <span class="vslChip">총작업량 <b>${esc(p.total)}</b></span>
      <span class="vslChip g">완료량 <b>${esc(p.done)}</b></span>
      <span class="vslChip o">잔량 <b>${esc(p.remain)}</b></span>
    </div>
  </div>`;
}
function pageVessel(){
  const d = vslData;
  const canSet = userRole==='union' || userRole==='all';
  const t = d && d.at ? (()=>{ const x = new Date(d.at); return `${String(x.getHours()).padStart(2,'0')}:${String(x.getMinutes()).padStart(2,'0')} 기준`; })() : '';
  const berths = (d && d.berths && d.berths.length ? d.berths : [{title:'선석#1',empty:true,lines:[]},{title:'선석#2',empty:true,lines:[]},{title:'선석#3',empty:true,lines:[]}]).map(berthCardHtml).join('');
  const msg = !vslApi ? `<div class="note" style="margin-bottom:12px;">본선작업 데이터 주소가 아직 설정되지 않았어요.${canSet ? ' 배차표의 본선작업 현황 칸 아래 \'데이터 주소 설정\'에서 넣어 주세요.' : ''}</div>`
            : (vslErr ? `<div class="note" style="margin-bottom:12px;">${esc(vslErr)}</div>` : (!d ? `<div class="hint" style="margin-bottom:12px;">불러오는 중…</div>` : ''));
  return `
  <h2 class="pgttl">본선작업</h2>
  ${msg}
  <div class="vslCard">
    <div class="vslCardHead"><b>선석별 작업현황</b><span class="hint" style="margin:0 0 0 8px;">${esc(t)}</span><span style="flex:1"></span>
      <button type="button" class="btn ghost sm" id="vslPageReload">↻ 새로고침</button></div>
    <div class="vslBerths">${berths}</div>
  </div>
  <div class="vslCard">
    <div class="vslCardHead"><b>STS별 작업현황</b></div>
    ${vslStsTableHtml(d)}
  </div>`;
}
function bindVesselPage(){
  const b = document.getElementById('vslPageReload'); if(b) b.onclick = ()=>{ vslLoadedAt = 0; reloadVessel(); };
  if(vslApi && (!vslData || Date.now()-vslLoadedAt > 55000)) reloadVessel();
  if(!vslTimer) vslTimer = setInterval(()=>{
    if(VIEW==='vessel' && document.visibilityState==='visible' && Date.now()-vslLoadedAt > 55000 && (VIEW==='vessel' || vslOpen)) reloadVessel();
  }, 15000);
}
// ===== 선석 조회(선석배정현황 그래픽) — 같은 Apps Script 주소에 ?type=berth =====
let berthData = null, berthErr = '', berthLoading = false, berthLoadedAt = 0, berthInfo = null, berthTimer = null;
// 조회일자별로 받은 선석 자료: {'' : 오늘(기본), '2026-10-01': 그 날부터 7일 …}
let berthSets = {}, berthQDate = '', berthSetErr = {}, berthSetLoading = {};
function berthSetDates(d){ return ((d && d.dates) || []).map(x=> (String(x).match(/\d{4}-\d{2}-\d{2}/)||[])[0]).filter(Boolean); }
async function fetchBerthSet(qd){
  qd = qd || '';
  if(!vslApi || berthSetLoading[qd]) return null;
  berthSetLoading[qd] = true;
  let j = null;
  try{
    const api = vslApi.replace(/\/macros\/u\/\d+\/s\//, '/macros/s/');
    const r = await fetch(api + (api.includes('?') ? '&' : '?') + 'type=berth' + (qd ? '&date=' + qd : '') + '&t=' + Date.now());
    j = await r.json();
    if(j && j.ok){ j._q = qd; berthSets[qd] = j; delete berthSetErr[qd]; if(!qd){ berthData = j; berthErr = ''; } try{ saveBerthLog(); }catch(e){} }
    else { const m = (j && j.dates === undefined) ? 'Apps Script에 선석 조회 기능이 아직 없어요. 새 코드로 바꾸고 새 버전으로 배포해 주세요.' : '회사 사이트에서 선석 정보를 받지 못했어요.'; berthSetErr[qd] = m; if(!qd) berthErr = m; j = null; }
  }catch(err){ const m = '선석 정보를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.'; berthSetErr[qd] = m; if(!qd) berthErr = m; }
  berthSetLoading[qd] = false;
  return j;
}
async function reloadBerth(){
  if(!vslApi || berthLoading) return;
  berthLoading = true; berthLoadedAt = Date.now();
  await fetchBerthSet('');
  if(berthQDate) await fetchBerthSet(berthQDate);
  berthLoading = false;
  if(VIEW==='berth' || VIEW==='safety') render();
}
// 관리감독자: 오늘 전 날짜 중 저장된 기록도 없고 받아 둔 자료에도 없는 날은 그 날짜로 회사 사이트를 조회해서 채움(조장·UNION)
let svBerthFillBusy = false;
async function svFillPastBerth(days){
  if(svBerthFillBusy || !vslApi || !(userRole==='leader' || userRole==='union' || userRole==='all')) return;
  const today = todayStr();
  const covered = new Set(); Object.values(berthSets).forEach(d=> berthSetDates(d).forEach(x=> covered.add(x)));
  const need = days.filter(ds=> ds < today && !(berthLog[ds] && (berthLog[ds].vessels || berthLog[ds].manual)) && !covered.has(ds) && !berthSetErr[ds]);
  if(!need.length) return;
  svBerthFillBusy = true;
  try{
    for(const ds of need){
      const cov = new Set(); Object.values(berthSets).forEach(d=> berthSetDates(d).forEach(x=> cov.add(x)));
      if(cov.has(ds)) continue;
      const j = await fetchBerthSet(ds);
      if(j && berthSetDates(j)[0] !== ds){ berthSetErr[ds] = '그 날짜로 조회하지 못했어요.'; delete berthSets[ds]; break; } // 날짜 조회가 안 되면(예전 Apps Script 등) 그만
      if(!j) break;
    }
  } finally { svBerthFillBusy = false; }
  if(VIEW==='safety') render();
}
function textOn(bg){
  const h = String(bg||'').replace('#',''); if(h.length<6) return '#111';
  const r = parseInt(h.slice(0,2),16), g = parseInt(h.slice(2,4),16), b = parseInt(h.slice(4,6),16);
  return (0.299*r + 0.587*g + 0.114*b) > 150 ? '#111' : '#fff';
}
function pageBerth(){
  const d = berthQDate ? (berthSets[berthQDate] || null) : berthData;
  const t = d && d.at ? (()=>{ const x = new Date(d.at); return `${String(x.getHours()).padStart(2,'0')}:${String(x.getMinutes()).padStart(2,'0')} 기준`; })() : '';
  const msg = !vslApi ? `<div class="note">본선작업 데이터 주소가 아직 설정되지 않았어요.</div>`
            : (berthQDate ? berthSetErr[berthQDate] : berthErr) ? `<div class="note">${esc(berthQDate ? berthSetErr[berthQDate] : berthErr)}</div>`
            : (d && berthQDate && berthSetDates(d)[0] !== berthQDate) ? `<div class="note">회사 사이트에서 ${esc(berthQDate)} 날짜로 조회하지 못해 오늘부터 보여 드려요. Apps Script를 새 코드로 바꾸고 새 버전으로 배포했는지 확인해 주세요.</div>`
            : !d ? `<div class="hint">불러오는 중…</div>` : '';
  let chart = '';
  if(d && d.dates && d.dates.length){
    const rows = d.rows && d.rows.length ? d.rows : [{name:'B1',h:180},{name:'B2',h:180},{name:'B3',h:320}];
    const H = rows.reduce((a,r)=>a+r.h,0) || 680, days = d.dates.length, cols = days*4;
    const timeCells = Array.from({length:cols},(_,i)=>`<div class="bcTime">${[0,6,12,18][i%4]}</div>`).join('');
    const grid = Array.from({length:cols},(_,i)=>`<div class="bcCol${i%4===0?' day':''}"></div>`).join('');
    let y = 0;
    const rowLines = rows.map(r=>{ y += r.h; return `<div class="bcRowLine" style="top:${y}px"></div>`; }).join('');
    const blocks = (d.blocks||[]).map((b,i)=>{
      const fg = textOn(b.bg);
      return `<div class="bcBlock" data-bi="${i}" style="left:${b.left}%;width:${b.width}%;top:${b.top}px;height:${b.height}px;background:${esc(b.bg)};color:${fg};">
        <div class="bcNums"><span>${esc(b.startNo)}</span><span>${esc(b.endNo)}</span></div>
        <div class="bcMid"><div class="bcRoute">${esc(b.route)}</div><div class="bcCode">${esc(b.code)}</div></div>
        <div class="bcBottom">${esc(b.bottom)}</div>
      </div>`;
    }).join('');
    chart = `<div class="bcWrap"><div class="bcChart" style="--H:${H}px;">
      <div class="bcHeadL"></div>
      <div class="bcHead"><div class="bcDates" style="grid-template-columns:repeat(${days},1fr);">${d.dates.map(x=>`<div>${esc(x)}</div>`).join('')}</div>
        <div class="bcTimes" style="grid-template-columns:repeat(${cols},1fr);">${timeCells}</div></div>
      <div class="bcBerths">${rows.map(r=>`<div style="height:${r.h}px;">${esc(r.name)}</div>`).join('')}</div>
      <div class="bcBody" style="height:${H}px;"><div class="bcGrid" style="grid-template-columns:repeat(${cols},1fr);">${grid}</div>${rowLines}${blocks}</div>
    </div></div>`;
  }
  const info = berthInfo!=null && d && d.blocks && d.blocks[berthInfo] ? d.blocks[berthInfo] : null;
  // 배 블록 팝업: 원본 'Calling Schedule Info' + QC 작업 표와 같은 구성(연분홍 머리, 빨간 글씨)
  const list = info ? (info.infoList && info.infoList.length ? info.infoList
      : Object.entries(info.info||{}).filter(([k])=>k!=='비고').map(([k,v])=>({k, v, pt:/^Actual/i.test(k)}))) : [];
  const remark = info ? (info.remark || (info.info && info.info['비고']) || '') : '';
  const pop = info ? `<div id="bcScrim" class="bcScrim">
      <div class="bcPopBox">
        <div class="bcInfo">
          <div class="bcInfoHead">Calling Schedule Info<button type="button" id="bcClose" class="bcX" aria-label="닫기">✕</button></div>
          <table><tbody>${list.map(r=>`<tr><td class="bcK${r.pt?' pt':''}">${esc(r.k)}</td><td class="bcV">${esc(r.v)}</td></tr>`).join('')}
            ${remark ? `<tr><td colspan="2" class="bcRemark">${esc(remark)}</td></tr>` : ''}</tbody></table>
        </div>
        ${info.qc && info.qc.length ? `<div class="bcInfo" style="margin-top:8px;">
          <table class="bcQc"><thead><tr><th>QC NO</th><th>Start Time</th><th>End Time</th></tr></thead><tbody>
            ${info.qc.map(q=>`<tr style="color:${esc(q.color||'#d92626')};"><td><span class="bcQcIc">🏗</span>${esc(q.no)}</td><td>${esc(q.start)}</td><td>${esc(q.end)}</td></tr>`).join('')}
          </tbody></table></div>` : ''}
      </div></div>` : '';
  const qv = berthQDate || todayStr();
  return `
  <h2 class="pgttl">선석 조회</h2>
  <div class="bcSearch">
    <b>조회일자 <i>*</i></b>
    <button type="button" class="bcArrow" id="bcPrevDay" aria-label="하루 전">◀</button>
    <input type="date" id="bcDate" value="${esc(qv)}">
    <button type="button" class="bcArrow" id="bcNextDay" aria-label="하루 뒤">▶</button>
    <button type="button" class="btn" id="bcGo">조회</button>
    ${berthQDate ? '<button type="button" class="btn ghost sm" id="bcToday">오늘</button>' : ''}
  </div>
  ${msg}
  <div class="vslCard">
    <div class="vslCardHead"><b>선석배정현황</b><span class="hint" style="margin:0 0 0 8px;">${esc(t)}</span><span style="flex:1"></span>
      <button type="button" class="btn ghost sm" id="bcReload">↻ 새로고침</button></div>
    ${chart || (d ? '<div class="empty">표시할 선석 일정이 없습니다.</div>' : (berthQDate && berthSetLoading[berthQDate] ? '<div class="hint">불러오는 중…</div>' : ''))}
    ${chart ? '<p class="hint" style="margin:8px 0 0;">배 블록을 누르면 선명·항차·접안/출항 시간·물량을 볼 수 있어요.</p>' : ''}
  </div>
  ${pop}`;
}
function setBerthQDate(v){
  if(!/^\d{4}-\d{2}-\d{2}$/.test(v||'')) return;
  berthQDate = v === todayStr() ? '' : v; berthInfo = null;
  if(berthQDate && !berthSets[berthQDate]){ render(); fetchBerthSet(berthQDate).then(()=>{ if(VIEW==='berth' || VIEW==='safety') render(); }); }
  else render();
}
function bindBerthPage(){
  const r = document.getElementById('bcReload'); if(r) r.onclick = ()=>{ berthLoadedAt = 0; if(berthQDate) delete berthSets[berthQDate]; reloadBerth(); };
  const di = document.getElementById('bcDate');
  const cur = ()=> (di && di.value) || berthQDate || todayStr();
  const pv = document.getElementById('bcPrevDay'); if(pv) pv.onclick = ()=> setBerthQDate(addDays(cur(), -1));
  const nx = document.getElementById('bcNextDay'); if(nx) nx.onclick = ()=> setBerthQDate(addDays(cur(), 1));
  const go = document.getElementById('bcGo'); if(go) go.onclick = ()=> setBerthQDate(cur());
  if(di) di.onkeydown = (e)=>{ if(e.key==='Enter'){ e.preventDefault(); setBerthQDate(cur()); } };
  const td = document.getElementById('bcToday'); if(td) td.onclick = ()=> setBerthQDate(todayStr());
  document.querySelectorAll('.bcBlock').forEach(b=> b.onclick = ()=>{ berthInfo = Number(b.dataset.bi); render(); });
  const c = document.getElementById('bcClose'); if(c) c.onclick = ()=>{ berthInfo = null; render(); };
  const sc = document.getElementById('bcScrim'); if(sc) sc.onclick = (e)=>{ if(e.target.id==='bcScrim'){ berthInfo = null; render(); } };
  if(vslApi && (!berthData || Date.now()-berthLoadedAt > 110000)) reloadBerth();
  if(!berthTimer) berthTimer = setInterval(()=>{ if(VIEW==='berth' && document.visibilityState==='visible' && Date.now()-berthLoadedAt > 110000) reloadBerth(); }, 20000);
}
function vesselPanelHtml(){
  return `<div id="vslPanel" class="panel" style="padding:12px 14px;margin-bottom:14px;">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <b style="font-size:15px;">🚢 본선작업 현황</b>
      <span id="vslTime" class="hint" style="margin:0;"></span>
      <span style="flex:1"></span>
      <button type="button" class="btn ghost sm" id="vslReload">새로고침</button>
      <button type="button" class="btn ghost sm" id="vslToggle">${vslOpen ? '접기' : '펼치기'}</button>
    </div>
    <div id="vslBody" style="display:${vslOpen?'block':'none'};margin-top:10px;"></div>
  </div>`;
}
function vslBodyHtml(){
  const canSet = userRole==='union' || userRole==='all';
  const setup = canSet ? `<div style="margin-top:8px;">${vslSetupOpen
      ? `<div class="row" style="align-items:center;"><input type="text" id="vslApiInput" value="${esc(vslApi)}" placeholder="Apps Script 웹 앱 주소 (https://script.google.com/macros/s/…/exec)" style="flex:1;min-width:240px;border:1px solid var(--border);border-radius:8px;padding:7px 10px;background:var(--bg);color:var(--text);font:inherit;"><button type="button" class="btn sm" id="vslApiSave">저장</button><button type="button" class="btn ghost sm" id="vslApiCancel">취소</button></div>`
      : `<a href="#" id="vslApiOpen" class="hint" style="margin:0;">데이터 주소 설정</a>`}</div>` : '';
  if(!vslApi) return `<div class="empty" style="padding:18px;">본선작업 데이터 주소가 아직 설정되지 않았어요.${canSet ? '' : ' (UNION에서 설정)'}</div>${setup}`;
  if(!vslData) return `<div class="empty" style="padding:18px;">${vslErr ? esc(vslErr) : '불러오는 중…'}</div>${setup}`;
  const d = vslData;
  const berths = (d.berths && d.berths.length ? d.berths : [{title:'선석#1',empty:true,lines:[]},{title:'선석#2',empty:true,lines:[]},{title:'선석#3',empty:true,lines:[]}]).map(b=>{
    const body = b.empty || !b.lines.length
      ? `<div style="color:var(--text-muted);text-align:center;padding:26px 0;">작업이 없습니다.</div>`
      : b.lines.map((l,k)=>`<div style="${k===0?'font-weight:800;font-size:14px;margin-bottom:4px;':'font-size:12.5px;'}">${esc(l)}</div>`).join('');
    return `<div style="border:1px ${b.empty?'dashed':'solid'} var(--border);border-radius:10px;padding:10px 12px;background:${b.empty?'var(--bg)':'var(--surface)'};min-width:0;">
      <div style="font-weight:800;color:${b.empty?'var(--text-muted)':'var(--accent)'};margin-bottom:6px;">${esc(b.title)}</div>${body}</div>`;
  }).join('');
  const rows = (d.sts||[]).map(r=>`<tr>${r.map(c=>`<td${c.rs>1?` rowspan="${c.rs}"`:''} style="text-align:center;">${esc(c.t)}</td>`).join('')}</tr>`).join('');
  return `${vslErr ? `<p class="hint" style="margin:0 0 6px;color:var(--warn);">${esc(vslErr)} (마지막으로 받은 내용 표시 중)</p>` : ''}
    <div style="font-weight:800;margin:2px 0 8px;">STS별 작업현황</div>
    ${vslStsTableHtml(d)}${setup}`;
}
function paintVessel(){
  const b = document.getElementById('vslBody'); if(!b) return;
  b.innerHTML = vslBodyHtml();
  const t = document.getElementById('vslTime');
  if(t && vslData && vslData.at){ const d = new Date(vslData.at); t.textContent = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')} 기준`; }
  const op = document.getElementById('vslApiOpen'); if(op) op.onclick = (e)=>{ e.preventDefault(); vslSetupOpen = true; paintVessel(); };
  const cc = document.getElementById('vslApiCancel'); if(cc) cc.onclick = ()=>{ vslSetupOpen = false; paintVessel(); };
  const sv = document.getElementById('vslApiSave');
  if(sv) sv.onclick = async ()=>{
    // 구글 계정이 여러 개일 때 붙는 '/u/1/' 부분은 빼고 저장(그대로 두면 '파일을 열 수 없습니다'가 남)
    const v = document.getElementById('vslApiInput').value.trim().replace(/\/macros\/u\/\d+\/s\//, '/macros/s/');
    if(v && !/^https:\/\/script\.google\.com\/macros\/s\/[^/]+\/exec/.test(v)){ showToast('https://script.google.com/macros/s/…/exec 형태의 웹 앱 주소를 넣어 주세요. (googleusercontent 주소는 안 돼요)'); return; }
    vslApi = v; vslSetupOpen = false; vslData = null; vslErr = ''; paintVessel(); reloadVessel();
    if(db && !demoMode){ try{ await db.doc('meta/config').set({vslApi: v}, {merge:true}); showToast('저장되었습니다.'); }catch(err){ showToast(saveErrMsg('저장에 실패했습니다.', err)); } }
  };
}
async function reloadVessel(){
  if(!vslApi || vslLoading){ paintVessel(); return; }
  vslLoading = true; vslLoadedAt = Date.now();
  try{
    const api = vslApi.replace(/\/macros\/u\/\d+\/s\//, '/macros/s/');
    const r = await fetch(api + (api.includes('?') ? '&' : '?') + 't=' + Date.now());
    const j = await r.json();
    if(j && (j.ok || (j.berths && j.berths.length))){ vslData = j; vslErr = ''; }
    else vslErr = '회사 사이트에서 내용을 받지 못했어요' + (j && j.code ? ` (응답 ${j.code})` : '') + '. 회사 내부망에서만 열리는 주소인지 확인해 주세요.';
  }catch(err){ vslErr = '본선작업 데이터를 불러오지 못했어요. 잠시 후 다시 시도해 주세요.'; }
  vslLoading = false;
  paintVessel();
  if(VIEW==='vessel') render();
}
function bindVesselPanel(){
  const rl = document.getElementById('vslReload'), tg = document.getElementById('vslToggle');
  if(rl) rl.onclick = reloadVessel;
  if(tg) tg.onclick = ()=>{
    vslOpen = !vslOpen; try{ localStorage.setItem('snct_vsl_open', vslOpen?'1':'0'); }catch(e){}
    document.getElementById('vslBody').style.display = vslOpen ? 'block' : 'none';
    tg.textContent = vslOpen ? '접기' : '펼치기';
    if(vslOpen) reloadVessel();
  };
  const body = document.getElementById('vslBody');
  if(body && !body.dataset.painted){ body.dataset.painted = '1'; paintVessel(); }
  if(!vslLoadedAt && vslOpen) reloadVessel();
  if(!vslTimer) vslTimer = setInterval(()=>{
    if(VIEW==='vessel' && document.visibilityState==='visible' && Date.now()-vslLoadedAt > 55000 && (VIEW==='vessel' || vslOpen)) reloadVessel();
  }, 15000);
}
// 일요일 야간의 다음날 아침 07시대는 주간 07시와 겹치지 않도록 '31:00'·'31:30'(=07시)으로 저장
function slotHourLabel(s){ const h = Number(String(s).split(':')[0]); return h>=25 ? String(h-24).padStart(2,'0') : String(s).split(':')[0]; }
// 빨간 칸(식사·교대): 07~08 · 12~13 · 18~19 · 24~01
function isMealSlot(s){ const hh = slotHourLabel(s); return hh==='07' || hh==='12' || hh==='18' || hh==='24' || hh==='00'; }
async function saveDispatchNote(dateStr, shift, empId, slot, text){
  if(!requireEdit()) return;
  const id = `${dateStr}_${shift}_${empId}`;
  const cur = Object.assign({date:dateStr, shift, employeeId:empId, slots:{}}, dispatch[id]||{});
  cur.notes = Object.assign({}, cur.notes||{}, {[slot]: text});
  if(!text) delete cur.notes[slot];
  dispatch[id] = cur;
  if(!db){ render(); return; }
  try{ await db.collection('dispatch').doc(id).set(cur); }
  catch(err){ showToast(saveErrMsg('배차 저장에 실패했습니다.', err)); render(); }
}
function dispatchCat(key){ return DISPATCH_CATS.find(c=>c.key===key); }
function currentEmpSlots(empId){
  const id = `${dispatchDate}_${dispatchShift}_${empId}`;
  const base = (dispatch[id] && dispatch[id].slots) || {};
  const overlay = {};
  if(paintSession) paintSession.rows.forEach(cells=> cells.forEach(c=>{ if(c.dataset.dispatchEmp===empId) overlay[c.dataset.dispatchSlot] = c.dataset.dispatchCur || ''; }));
  return Object.assign({}, base, overlay);
}
function countPaintedHours(empId){
  const slots = currentEmpSlots(empId);
  let n = 0;
  for(const k in slots){ if(dpIsCrew(slots[k])) n++; } // 셔틀만 승무 시간에서 뺌(당직은 포함)
  return n*0.5;
}
function applyPaintToCell(td, value){
  const cat = dispatchCat(value);
  td.style.background = cat ? cat.bg : 'transparent';
  td.style.color = cat ? cat.fg : 'var(--text)';
  td.dataset.dispatchCur = value || '';
  td.classList.toggle('dpPainted', !!cat);
}
function updateSuwuLive(empId){
  const cell = document.querySelector(`[data-dispatch-suwu="${empId}"]`);
  if(cell) cell.textContent = fmtH(countPaintedHours(empId));
}
function updateCountLive(slot){
  const cells = document.querySelectorAll(`.dpCell[data-dispatch-slot="${slot}"]`);
  let cnt = 0;
  cells.forEach(td=>{ const v = td.dataset.dispatchCur; if(dpIsWork(v)) cnt++; }); // 셔틀은 시간대별 인원에서 뺌(당직은 셈)
  const countCell = document.querySelector(`[data-dispatch-count="${slot}"]`);
  if(countCell){
    countCell.textContent = cnt || '';
    countCell.style.color = cnt>0 ? 'var(--accent)' : 'var(--text-muted)';
  }
}
function dispatchPaintValue(){ return dispatchPaint==='수정' ? '' : dispatchPaint; }
// 끌어서 칠하기: 처음 누른 칸 ~ 지금 마우스(손가락)가 있는 칸까지 '사각형'으로 칠함(옆으로·위아래로 모두).
// 끌다가 되돌아오면 벗어난 칸은 원래 색·글자로 돌아감. 휴무(회색) 줄은 건너뜀(처음 누른 줄이 회색이면 포함)
function dispatchStartPaint(td){
  if(!td || !td.classList.contains('dpCell')) return;
  if(!canEdit){ requireEdit(); return; }
  const table = td.closest('table'); if(!table) return;
  const startTr = td.closest('tr');
  const rows = Array.from(table.querySelectorAll('tbody tr')).filter(tr=> tr.querySelector('.dpCell') && (tr===startTr || !tr.classList.contains('dpOff')))
    .map(tr=> Array.from(tr.querySelectorAll('.dpCell')));
  const orig = new Map();
  rows.forEach(cells=> cells.forEach(c=> orig.set(c, {cur: c.dataset.dispatchCur || '', html: c.innerHTML})));
  const r0 = rows.findIndex(cells=> cells.includes(td));
  paintSession = {rows, orig, r0, c0: rows[r0].indexOf(td), last: '', value: dispatchPaintValue(), erase: dispatchPaint==='수정', touched: new Set()};
  dispatchContinuePaint(td);
}
function dispatchContinuePaint(td){
  if(!paintSession || !td || !td.classList.contains('dpCell')) return;
  const ps = paintSession;
  const r = ps.rows.findIndex(cells=> cells.includes(td)); if(r < 0) return;
  const c = ps.rows[r].indexOf(td);
  const key = r+'_'+c; if(key === ps.last) return; ps.last = key;
  const rlo = Math.min(ps.r0, r), rhi = Math.max(ps.r0, r), clo = Math.min(ps.c0, c), chi = Math.max(ps.c0, c);
  const slotsChanged = new Set(), empsChanged = new Set();
  ps.rows.forEach((cells, ri)=> cells.forEach((cell, ci)=>{
    const inRect = ri>=rlo && ri<=rhi && ci>=clo && ci<=chi;
    if(!inRect && !ps.touched.has(cell)) return; // 한 번도 안 건드린 칸은 그대로
    const o = ps.orig.get(cell);
    const want = inRect ? ps.value : o.cur;
    if((cell.dataset.dispatchCur||'') !== want){ applyPaintToCell(cell, want); slotsChanged.add(cell.dataset.dispatchSlot); empsChanged.add(cell.dataset.dispatchEmp); }
    if(ps.erase){ // 수정: 범위 안 칸은 글자도 지워 보이게, 벗어나면 원래 글자 복원
      const html = inRect ? '' : o.html;
      if(cell.innerHTML !== html) cell.innerHTML = html;
    }
    if(inRect) ps.touched.add(cell); else ps.touched.delete(cell);
  }));
  slotsChanged.forEach(updateCountLive);
  empsChanged.forEach(updateSuwuLive);
}
function dispatchFinishPaint(){
  if(!paintSession) return;
  const {rows, orig, erase, touched} = paintSession;
  paintSession = null;
  const byEmp = {}; // 사람마다 바뀐 칸만 모아서 저장
  rows.forEach(cells=> cells.forEach(cell=>{
    const o = orig.get(cell), slot = cell.dataset.dispatchSlot, emp = cell.dataset.dispatchEmp, v = cell.dataset.dispatchCur || '';
    const g = byEmp[emp] = byEmp[emp] || {changes:{}, clear:[]};
    if(v !== o.cur) g.changes[slot] = v;
    if(erase && touched.has(cell)){ const note = (((dispatch[`${dispatchDate}_${dispatchShift}_${emp}`]||{}).notes)||{})[slot]; if(note){ g.clear.push(slot); cell.removeAttribute('title'); } }
  }));
  Object.entries(byEmp).forEach(([emp, g])=>{
    if(Object.keys(g.changes).length || g.clear.length) saveDispatchSlots(dispatchDate, dispatchShift, emp, g.changes, g.clear);
  });
}
// 한 칸만 누르기: 초반·후반 등은 그 칸만 칠하기, 수정은 그 칸의 색·글자 지우기
// 같은 칸을 빨리 두 번 누르면(더블클릭·더블탭) 방금 바꾼 것을 되돌리고 글자 입력칸을 엶
let dpLastTap = null;
function dispatchTapCell(td){
  if(!td || !canEdit) return;
  const slot = td.dataset.dispatchSlot, empId = td.dataset.dispatchEmp, now = Date.now();
  if(dpLastTap && dpLastTap.slot===slot && dpLastTap.emp===empId && now - dpLastTap.t < 400){
    const u = dpLastTap; dpLastTap = null;
    if(u.changed) saveDispatchSlots(dispatchDate, dispatchShift, empId, {[slot]: u.prevCur}, []).then(()=>{});
    if(u.prevNote && u.clearedNote) saveDispatchNote(dispatchDate, dispatchShift, empId, slot, u.prevNote);
    applyPaintToCell(td, u.prevCur);
    startDpInlineEdit(td);
    return;
  }
  const prevCur = td.dataset.dispatchCur || '';
  const prevNote = (((dispatch[`${dispatchDate}_${dispatchShift}_${empId}`]||{}).notes)||{})[slot] || '';
  if(dispatchPaint==='수정'){
    dpLastTap = {slot, emp: empId, t: now, prevCur, prevNote, changed: !!prevCur, clearedNote: !!prevNote};
    if(!prevCur && !prevNote) return;
    applyPaintToCell(td, ''); td.innerHTML = ''; td.removeAttribute('title'); updateCountLive(slot);
    saveDispatchSlots(dispatchDate, dispatchShift, empId, {[slot]: ''}, prevNote ? [slot] : []);
    updateSuwuLive(empId);
    return;
  }
  const val = dispatchPaintValue();
  dpLastTap = {slot, emp: empId, t: now, prevCur, prevNote, changed: prevCur!==val, clearedNote: false};
  if(prevCur === val) return;
  applyPaintToCell(td, val); updateCountLive(slot);
  saveDispatchSlots(dispatchDate, dispatchShift, empId, {[slot]: val});
  updateSuwuLive(empId);
}
function mondayOf(dateStr){
  const [y,m,d]=dateStr.split('-').map(Number);
  const dt=new Date(y,m-1,d);
  const wd=dt.getDay(); // 0=일
  const diff = wd===0 ? -6 : 1-wd;
  dt.setDate(dt.getDate()+diff);
  return dstr(dt.getFullYear(), dt.getMonth()+1, dt.getDate());
}
function addDays(dateStr, n){
  const [y,m,d]=dateStr.split('-').map(Number);
  const dt=new Date(y,m-1,d); dt.setDate(dt.getDate()+n);
  return dstr(dt.getFullYear(), dt.getMonth()+1, dt.getDate());
}
// 날짜를 n개월 이동(일자는 최대한 유지, 말일 초과시 그 달 말일로 보정)
function shiftMonth(dateStr, n){
  const [y,m,d] = dateStr.split('-').map(Number);
  let ny=y, nm=m+n;
  while(nm>12){ nm-=12; ny++; }
  while(nm<1){ nm+=12; ny--; }
  const nd = Math.min(d, daysInMonth(ny,nm));
  return dstr(ny, nm, nd);
}
// 기간을 n개월 이동. "1일~말일" 한 달 전체 기간이면 이동 후에도 그 달의 1일~말일로 맞춤(8/31, 2/29 등 누락 방지)
function shiftRangeMonth(start, end, n){
  const [sy,sm,sd] = start.split('-').map(Number);
  const [ey,em,ed] = end.split('-').map(Number);
  if(sd===1 && sy===ey && sm===em && ed===daysInMonth(ey,em)){
    const ns = shiftMonth(start, n);
    const [ny,nm] = ns.split('-').map(Number);
    return [ns, dstr(ny,nm,daysInMonth(ny,nm))];
  }
  return [shiftMonth(start,n), shiftMonth(end,n)];
}

const WORK_CODES = [
  {code:'D', label:'주간(D)', cls:'bc-D'},
  {code:'N', label:'야간(N)', cls:'bc-N'},
  {code:'DN', label:'주-야(DN)', cls:'bc-DN'},
  {code:'ND', label:'야-주(ND)', cls:'bc-ND'},
  {code:'DS', label:'주간지원(DS)', cls:'bc-DS'},
  {code:'NS', label:'야간지원(NS)', cls:'bc-NS'},
  {code:'IN', label:'인원포함(IN)', cls:'bc-IN'},
  {code:'OFF', label:'휴무', cls:'bc-OFF'}
];
const WORK_CODE_COLOR = {D:'amber', N:'night', OFF:'text-muted', DN:'accent', ND:'accent', DS:'ok', NS:'ok', IN:'text'};
const CODE_LABELS = {
  FC:'고정주휴', MC:'이동주휴', FCH:'고정주휴_공휴', MCH:'이동주휴_공휴', MCS:'이동주휴_일요',
  SC:'지원휴무', SP:'지원패스', VP:'휴무선택', VA:'휴가연차', UJ:'노조업무', E:'교육', EC:'기타',
  // 원본 근태코드표 기준 연가 코드 (TL=휴직)
  RV:'정기휴가', AV:'연차휴가', LS:'장기근속', SL:'병가휴가', TL:'휴직'
};
const STATUS_CODE_LIST = Object.keys(CODE_LABELS);
// 코드 색상 규칙: N,ND,NS,FCH,MCH,MCS,VP,VA는 빨간색, 나머지는 검은색
// 코드 색: FC 진한 파랑, MC 초록, VA·VP 연한 파랑(하늘색), 아래 코드는 빨강, 나머지(D·N·DN·ND 등)는 검정
// 코드 색 (요청 기준)
//  · 빨간 배경 + 흰 글씨: NS·FCH·MCH·MCS·AV·RV·LS·SL·TL
//  · 노란 배경 + 검은 글씨: MC   · 파란 배경 + 흰 글씨: FC
//  · 분홍 배경 + 빨간 글씨: SP   · 흐린 회색 배경 + 진한 회색 글씨: SC
//  · 나머지(D·N·DN·ND·DS·UJ·E·EC·CK 등): 검은 글씨만
const RED_CODES = new Set(['FCH','MCH','MCS','AV','RV','LS','SL','TL']);
// 연장·선지원 코드(ND·DN·DS·NS)는 연한 청록색 배경(근태코드 화면의 색 설정보다 우선)
const SUP_SKY_CODES = new Set(['ND','DN','DS','NS']);
const SKY_CODES = new Set([]);
// 근태코드 배경: 빨강·파랑·노랑·보라는 연한 색 배경 + 진한 글씨(눈이 덜 피로하게)
const CODE_STYLE = {FC:{bg:'#dbeafe',fg:'#1d4ed8',txt:'#1d4ed8'}, MC:{bg:'#fef9c3',fg:'#a16207',txt:'#a16207'},
  SP:{bg:'#ede9fe',fg:'#6d28d9',txt:'#7c3aed'}, VP:{bg:'#fbcfe8',fg:'#be185d',txt:'#db2777'}, SC:{bg:'#e5e7eb',fg:'#4b5563',txt:'#4b5563'}};
const GROUP_STYLE = {red:{bg:'#fee2e2',fg:'#b91c1c',txt:'#dc2626'}, yellow:CODE_STYLE.MC, blue:CODE_STYLE.FC, pink:CODE_STYLE.VP, purple:CODE_STYLE.SP, gray:CODE_STYLE.SC, sky:{bg:'#e0f2fe',fg:'#0369a1',txt:'#0369a1'}, black:{bg:'',fg:'var(--text)',txt:'var(--text)'}};
function codeStyle(code){
  if(SUP_SKY_CODES.has(code)) return {bg:'#ccfbf1', fg:'#0f766e', txt:'#0f766e'}; // 연한 청록(파랑+녹색)
  const cd = (typeof codeDefs!=='undefined') && codeDefs[code];
  if(cd && cd.color && GROUP_STYLE[cd.color]) return GROUP_STYLE[cd.color];
  if(CODE_STYLE[code]) return CODE_STYLE[code];
  if(RED_CODES.has(code)) return GROUP_STYLE.red;
  return {bg:'', fg:'var(--text)', txt:'var(--text)'};
}
// 색깔별 나열 순서: 검정 → 빨강 → 노랑 → 파랑 → 분홍 → 회색 → 하늘 → 그 외
const CODE_GROUPS = [
  {key:'black', name:'검은 글씨'}, {key:'red', name:'빨간 배경'}, {key:'yellow', name:'노란 배경'},
  {key:'blue', name:'파란 배경'}, {key:'pink', name:'분홍 배경'}, {key:'purple', name:'보라 배경'}, {key:'gray', name:'회색 배경'}, {key:'sky', name:'하늘색 배경'}
];
function codeGroup(code){
  if(SUP_SKY_CODES.has(code)) return 'sky'; // ND·DN·DS·NS: 연한 청색
  const cd = (typeof codeDefs!=='undefined') && codeDefs[code];
  if(cd && cd.color) return cd.color;
  if(RED_CODES.has(code)) return 'red';
  return ({MC:'yellow', FC:'blue', VP:'pink', SP:'purple', SC:'gray'})[code] || 'black';
}
const BLACK_ORDER = ['D','N','UJ','E','EC','CK','SV'];
function codeSortKey(code){
  const gi = CODE_GROUPS.findIndex(g=>g.key===codeGroup(code));
  const bi = BLACK_ORDER.indexOf(code), ri = ['FCH','MCH','MCS','AV','RV','LS','SL','TL'].indexOf(code), si = ['DN','ND','DS','NS'].indexOf(code);
  return gi*1000 + (bi>=0 ? bi : ri>=0 ? ri : si>=0 ? si : 500);
}
function codeBadge(code){
  const st = codeStyle(code);
  return st.bg ? `<span class="badge-code" style="background:${st.bg};border-color:${st.bg};color:${st.fg};">${esc(code)}</span>`
               : `<span class="badge-code" style="background:var(--bg);border-color:var(--border);color:var(--text);">${esc(code)}</span>`;
}
// 배경 없이 글씨만 쓰는 곳(배차표·목록 등)의 글씨 색
function codeColor(code){ return codeStyle(code).txt; }
// 칸을 채울 때의 글씨 색
function codeFillText(code){ return codeStyle(code).fg; }
// 근태관리 표 칸 채우기: 색이 있는 코드(FC 파랑·MC 초록·빨강 코드)는 칸 전체를 그 색으로, 글씨는 흰색
function codeFill(code){ return codeStyle(code).bg; }
// 근태코드 화면에 있는(숨기지 않은) 코드만 유효 — 화면 표시와 가져오기에 공통 사용
function refWorkCodes(){ return new Set(WORK_CODES.map(w=>w.code).filter(c=>!hiddenCodes.has(c))); }
function refStatusCodes(){
  const custom = Object.keys(codeDefs).filter(c=>!STATUS_CODE_LIST.includes(c) && !WORK_CODES.some(w=>w.code===c));
  return new Set([...STATUS_CODE_LIST, ...custom].filter(c=>!hiddenCodes.has(c)));
}
// 원본 기준 '지원근무' 일수: 월별표(근태코드 칸)에 SP·D·N·DN·ND로 입력된 날
// 지원근무 1일: 근태코드 칸에 SP·DN·ND·D·N 입력 (원본 공식: COUNTIF SP + DN + ND* + D + N)
