// 사용자가 팝업에서 직접 넣은 보정값(기존 기본 보정과 별도로 더해짐)
function userAdjOf(e, f){ return (e && Number(e['u_'+f])) || 0; }
function adjOf(e, f){
  if(e && e[f]!==undefined && e[f]!==null && e[f]!=='') return Number(e[f])||0;
  const d = DEFAULT_ADJ[e && e.name]; return (d && d[f]) || 0;
}
const IMPORT_LAST_DATE = '2026-10-05'; // 엑셀에서 가져온 출퇴근 기록의 마지막 날짜
function rankExcl(e){ return (e && e.rankExclude!==undefined && e.rankExclude!==null) ? e.rankExclude : (DEFAULT_RANK_EXCLUDE[e && e.name] || ''); }
function empName(id){ const e = employees.find(x=>x.id===id); return e ? e.name : '(알수없음)'; }
function statusLabel(code){
  if(!code) return '';
  const d = codeDefs[code];
  const label = (d && d.label) ? d.label : (CODE_LABELS[code] || '');
  return label ? `${code}(${label})` : code;
}

